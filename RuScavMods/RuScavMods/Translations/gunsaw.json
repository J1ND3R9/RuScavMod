    },

    {
      "key": "dialogue_baron_tradergiveitem1",
      "value": "Спасибо!"
    },
    {
      "key": "dialogue_baron_tradergiveitem2",
      "value": "Добавлю к общему числу."
    },
    {
      "key": "dialogue_baron_tradergiveitem3",
      "value": "Спасибки!"
    },
    {
      "key": "dialogue_baron_tradergiveitem4",
      "value": "Это мне пригодится."
    },
    {
      "key": "dialogue_baron_tradergiveitem5",
      "value": "Ого! Спасибо!"
    },
    {
      "key": "dialogue_baron_tradergiveitem6",
      "value": "Отлично!"
    },

    {
      "key": "dialogue_baron_tradergiveitemrefuse1",
