    {
      "key": "dialogue_milky_fallscream1",
      "value": "БЛЯЯЯЯЯЯЯЯЯЯЯЯЯЯ!!"
    },
    {
      "key": "dialogue_milky_fallscream2",
      "value": "АААААААААААА!"
    },
    {
      "key": "dialogue_milky_fallscream3",
      "value": "ААААААА!"
    },
    {
      "key": "dialogue_milky_fallscream4",
      "value": "ПИИИИИЗДЕЕЕЕЕЦ!"
    },
    {
      "key": "dialogue_milky_fallscream5",
      "value": "УХАХАХА....!"
    },
    {
      "key": "dialogue_milky_fallscream6",
      "value": "ААААААААААААААААААААААААААААААААААААААААААААААААААААААААААААААААААААААААААААААААААА!"
    },

    {
      "key": "dialogue_milky_hitbycreature1",
      "value": "ААААХХХХ!"
    },
    {
      "key": "dialogue_milky_hitbycreature2",
      "value": "БЛЯЯЯЯЯ!!! УЙДИ НАХУЙ!"
    },
    {
      "key": "dialogue_milky_hitbycreature3",
      "value": "УЙДИ ОТ МЕНЯ! ААААА!"
    },
    {
      "key": "dialogue_milky_hitbycreature4",
      "value": "УБИРАЙСЯ!"
    },
    {
      "key": "dialogue_milky_hitbycreature5",
      "value": "ААААААААА!"
    },
    {
      "key": "dialogue_milky_hitbycreature6",
      "value": "СТОЙ!! ААААА!!!"
    },
    {
      "key": "dialogue_milky_hitbycreature7",
      "value": "ПОМОГИТЕ! ПОМОГИИИТЕЕЕ!!!"
    },
    {
      "key": "dialogue_milky_hitbycreature8",
      "value": "ААА БЛЯТЬ! БЛЯТЬ! УЙДИ, УЙДИ, УЙДИ!!!!"
    },
    {
