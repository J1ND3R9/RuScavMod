    {
      "key": "dialogue_leapy_chr2_tradercombat5",
      "value": "НГГХХРРРР..."
    },
    {
      "key": "dialogue_leapy_chr2_tradercombat6",
      "value": "ГРРРР! ДЮНА НЕНАВИДИТ!"
    },
    {
      "key": "dialogue_leapy_chr2_tradercombat7",
      "value": "НГХХРРРР... БОЛЬ-ШЕ НЕ ДР-УГ!"
    },
    {
      "key": "dialogue_leapy_chr2_tradercombat8",
      "value": "ДЮНА НЕ-НАВИДИТ ЗЛОГО О-ВОЩА! GRRRR!"
    },
    {
      "key": "dialogue_leapy_chr2_tradercombat9",
      "value": "ДЮНА РАЗДАВИТ МА-ЛЕНЬКОГО О-ВОЩА! РРРГХХХ!"
