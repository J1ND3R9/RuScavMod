    },

    {
      "key": "catpatch_voyager_hug_decline_1",
      "value": "Do not touch me."
    },
    {
      "key": "catpatch_voyager_hug_decline_2",
      "value": "I don't do that. Least of all with something like you."
    },
    {
      "key": "catpatch_voyager_hug_decline_3",
      "value": "Get away from me."
    },
    {
      "key": "catpatch_voyager_hug_decline_4",
      "value": "Absolutely not."
    },
    {
      "key": "catpatch_voyager_hug_decline_5",
      "value": "Find comfort elsewhere. I'm not it."
    },
    {
      "key": "catpatch_voyager_hug_decline_6",
      "value": "No. And don't ask again."
    },

    {
      "key": "catpatch_voyager_kiss_decline_1",
      "value": "Touch me like that again and you'll lose the hand."
    },
    {
      "key": "catpatch_voyager_kiss_decline_2",
      "value": "Disgusting. Absolutely not."
    },
    {
      "key": "catpatch_voyager_kiss_decline_3",
      "value": "I would rather die."
    },
    {
      "key": "catpatch_voyager_kiss_decline_4",
      "value": "You have three seconds to reconsider that."
    },
    {
      "key": "catpatch_voyager_kiss_decline_5",
      "value": "Do you have a death wish?"
    },
    {
      "key": "catpatch_voyager_kiss_decline_6",
      "value": "Never. Not even in your dreams."
    },

    {
