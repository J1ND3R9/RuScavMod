    {
      "key": "dialogue_velvet_braindamagedresponse3",
      "value": "Твои слова звучат совсем неправильно."
    },
    {
      "key": "dialogue_velvet_braindamagedresponse4",
      "value": "С твоей головой что-то не так."
    },
    {
      "key": "dialogue_velvet_braindamagedresponse5",
      "value": "Я тебя не понимаю."
    },

