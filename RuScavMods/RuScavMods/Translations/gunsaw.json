      "key": "dialogue_leapy_chr2_traderthreatensuccess4",
      "value": "Дюна слабе-е... Дюна сдается... Бе-ри и ухо-ди..."
    },
    {
      "key": "dialogue_leapy_chr2_traderthreatensuccess5",
      "value": "Не навре-ди Дюне... Бе-ри вещь... Ухо-ди..."
    },
    {
      "key": "dialogue_leapy_chr2_traderthreatensuccess6",
      "value": "Дюна разре-шает злому др-угу взя-ть... Но Дюна не-навидит др-уга..."
    },
    {
      "key": "dialogue_leapy_chr2_traderwarning1",
      "value": "Ухо-ди! Или уку-шу! Сейчас!"
    },
    {
      "key": "dialogue_leapy_chr2_traderwarning2",
      "value": "Мнннхх... Добы-ча сама хочет..."
    },
    {
      "key": "dialogue_leapy_chr2_traderwarning3",
      "value": "Ггххрр! УХОДИ... ПРО-ЧЬ..."
    },
    {
      "key": "dialogue_leapy_chr2_traderwarning4",
      "value": "Уходи... Прочь! Дале-ко..."
    },
    {
      "key": "dialogue_leapy_chr2_traderwarning5",
      "value": "Дюна ненавидит др-уга!"
    },
    {
      "key": "dialogue_leapy_chr2_traderwarning6",
      "value": "Дюна не впустит др-уга!... Уходи!..."
    },
    {
      "key": "dialogue_leapy_chr2_traderwarning7",
      "value": "Дюна хочет выгнать др-уга!... Сейча-с!..."
    },
    {
      "key": "dialogue_leapy_chr2_tradercombat1",
      "value": "Нггрррр! Гррррррр! ГААААХХХ!"
    },
    {
      "key": "dialogue_leapy_chr2_tradercombat2",
      "value": "ГГХХРРААХХ!"
    },
    {
      "key": "dialogue_leapy_chr2_tradercombat3",
      "value": "ГННГХРХХРРРРР!"
    },
    {
      "key": "dialogue_leapy_chr2_tradercombat4",
      "value": "О-ВОЩ ПОЖАЛЕЕТ О ВЫБО-РЕ!"
