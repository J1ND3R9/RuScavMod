    },
    {
      "key": "dialogue_orange_lastmoments22",
      "value": "maybe I can... just... take a nap... real quick..."
    },
    {
      "key": "dialogue_orange_lastmoments23",
      "value": "uuuhhhmmm... yeah... I'll be fine, doc..."
    },
    {
      "key": "dialogue_orange_lastmoments24",
      "value": "...don't... worry about... me..."
    },
    {
      "key": "dialogue_orange_lastmoments25",
      "value": "...see...? aren't I so strong...?"
    },
    {
      "key": "dialogue_orange_lastmoments26",
      "value": "am I... gonna see my... friends? am I?"
    },

    {
      "key": "dialogue_orange_magicheal1",
      "value": "...Huh? What...?"
    },
    {
      "key": "dialogue_orange_magicheal2",
      "value": "...What just happened? I feel... Better."
    },
    {
      "key": "dialogue_orange_magicheal3",
      "value": "Wh- Huh? Everything's... Everything's okay!!"
    },

    {
      "key": "dialogue_orange_selfdestruct1",
      "value": "Nooo...! Why? Why ME? What did I do!? What am I gonna do, WHAT AM I GONNA DO!?"
    },
    {
      "key": "dialogue_orange_selfdestruct2",
