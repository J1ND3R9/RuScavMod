    {
      "key": "dialogue_velvet_traderseegun6",
      "value": "Ого, опусти пушку, пожалуйста!"
    },
    {
      "key": "dialogue_velvet_traderseegun7",
      "value": "Я-я не хочу неприятностей."
    },
    {
      "key": "dialogue_velvet_traderseegun8",
      "value": "Пожалуйста, не стреляй!"
