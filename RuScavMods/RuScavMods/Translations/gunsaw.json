    {
      "key": "dialogue_leapy_chr2_traderbuyfail6",
      "value": "О-вощ да-ет пер-вым..."
    },
    {
      "key": "dialogue_leapy_chr2_traderbuyfailmaxvalue1",
      "value": "Дал доста-точно! Ухо-ди сей-час!"
    },
    {
      "key": "dialogue_leapy_chr2_traderbuyfailmaxvalue2",
      "value": "Дюна дает так мно-го... Слишком много... О-вощ, стоп..."
