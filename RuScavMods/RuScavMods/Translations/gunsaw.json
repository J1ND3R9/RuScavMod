    {
      "key": "dialogue_velvet_hitbycreature1",
      "value": "СЬЕБИ!"
    },
    {
      "key": "dialogue_velvet_hitbycreature2",
      "value": "Не трогай меня!"
    },
    {
      "key": "dialogue_velvet_hitbycreature3",
      "value": "ШШШШШ!"
    },
    {
      "key": "dialogue_velvet_hitbycreature4",
      "value": "Прочь!"
    },
    {
      "key": "dialogue_velvet_hitbycreature5",
      "value": "Нет, нет, нет!"
    },
    {
      "key": "dialogue_velvet_hitbycreature6",
      "value": "Это МОЁ тело!"
    },
    {
      "key": "dialogue_velvet_hitbycreature7",
      "value": "Хватит рвать!"
    },
    {
      "key": "dialogue_velvet_hitbycreature8",
      "value": "Я тоже кусаюсь!"
    },
    {
      "key": "dialogue_velvet_hitbycreature9",
      "value": "Плохое создание!"
    },
    {
      "key": "dialogue_velvet_hitbycreature10",
      "value": "ПРОЧЬ!"
    },

    {
      "key": "dialogue_velvet_wet1",
      "value": "Я вымокла."
    },
    {
      "key": "dialogue_velvet_wet2",
      "value": "Мокро. Неприятно."
    },
    {
      "key": "dialogue_velvet_wet3",
      "value": "Фу. Сырость."
    },
    {
      "key": "dialogue_velvet_wet4",
      "value": "Вода в шерсти. Прелестно."
    },
    {
      "key": "dialogue_velvet_wet5",
      "value": "Стоит обсохнуть."
    },
    {
      "key": "dialogue_velvet_wet6",
      "value": "Слишком мокро."
    },
    {
      "key": "dialogue_velvet_wet7",
      "value": "Из-за этого лазать будет мучительно."
    },
    {
      "key": "dialogue_velvet_wet8",
      "value": "От этой воды тело тяжелеет."
    },
    {
      "key": "dialogue_velvet_wet9",
      "value": "Насквозь промокла."
    },
    {
      "key": "dialogue_velvet_wet10",
      "value": "Не люблю эту сырость."
    },

    {
      "key": "dialogue_velvet_dirty1",
      "value": "Грязная."
    },
    {
      "key": "dialogue_velvet_dirty2",
      "value": "Мне нужно очиститься."
    },
    {
      "key": "dialogue_velvet_dirty3",
      "value": "В моей шерсти грязь..."
    },
    {
      "key": "dialogue_velvet_dirty4",
      "value": "Эта грязь не радует."
    },
    {
      "key": "dialogue_velvet_dirty5",
      "value": "Чувствую себя такой замызганной..."
    },
    {
      "key": "dialogue_velvet_dirty6",
      "value": "Стоит смыть это с себя."
    },
    {
      "key": "dialogue_velvet_dirty7",
      "value": "Грязь повсюду."
    },
    {
      "key": "dialogue_velvet_dirty8",
      "value": "Я таскаю на себе половину этой пещеры..."
    },
    {
      "key": "dialogue_velvet_dirty9",
      "value": "Негигиенично..."
    },
    {
      "key": "dialogue_velvet_dirty10",
      "value": "Я предпочитаю, чтобы мой беспорядок был осознанным."
    },

    {
      "key": "dialogue_velvet_encumbered1",
      "value": "Слишком много всего несу."
    },
    {
      "key": "dialogue_velvet_encumbered2",
      "value": "У меня много лап, но не так много сил."
    },
    {
      "key": "dialogue_velvet_encumbered3",
      "value": "С этим грузом неудобно."
    },
    {
      "key": "dialogue_velvet_encumbered4",
      "value": "Стоит что-нибудь оставить здесь."
    },
    {
      "key": "dialogue_velvet_encumbered5",
      "value": "Слишком много вещей. Слишком мало изящества."
    },
    {
      "key": "dialogue_velvet_encumbered6",
      "value": "Этот груз тянет меня вниз."
    },
    {
      "key": "dialogue_velvet_encumbered7",
      "value": "Нужно облегчить ношу."
    },
    {
      "key": "dialogue_velvet_encumbered8",
      "value": "Полезно? Несомненно. Портативно? Ничуточки."
    },
    {
      "key": "dialogue_velvet_encumbered9",
      "value": "Моя спина жалуется."
    },
    {
      "key": "dialogue_velvet_encumbered10",
      "value": "Даже у меня есть пределы."
    },

    {
      "key": "dialogue_velvet_watchlike1",
      "value": "Мне нравятся эти часы."
    },

    {
      "key": "dialogue_velvet_drillend1",
      "value": "...Это заняло немало времени."
    },
    {
      "key": "dialogue_velvet_drillend2",
      "value": "Клянусь, у этой штуки вообще нет звукоизоляции."
    },
    {
      "key": "dialogue_velvet_drillend3",
      "value": "Довольно долгая поездка вышла..."
    },

    {
      "key": "dialogue_velvet_loud1",
      "value": "...Громко."
    },
    {
      "key": "dialogue_velvet_loud2",
      "value": "!!!... Это меня напугало."
    },
    {
      "key": "dialogue_velvet_loud3",
      "value": "!!!"
    },
    {
      "key": "dialogue_velvet_loud4",
      "value": "ААА!.. А."
    },

    {
      "key": "dialogue_velvet_murderregret1",
      "value": "Ну как тебе ЭТО!? Эхухухуху!!!"
    },
    {
      "key": "dialogue_velvet_murderregret2",
      "value": "ДРУГ - ВСЁ! АХАХАХХА"
    },
    {
      "key": "dialogue_velvet_murderregret3",
      "value": "Эхухухуху~."
    },
    {
      "key": "dialogue_velvet_murderregret4",
      "value": "Твоя борьба была забавной, пока я не победила, эхуху~!"
    },
    {
      "key": "dialogue_velvet_murderregret5",
      "value": "...Вот и всё... Как жалко~."
    },
    {
      "key": "dialogue_velvet_murderregret6",
      "value": "Какая жалость... Я буду наслаждаться каждым кусочком~."
    },
    {
      "key": "dialogue_velvet_murderregret7",
      "value": "Ух! Как волнующе! Забыла, насколько это весело, когда они сопротивляются~."
    },
    {
      "key": "dialogue_velvet_murderregret8",
      "value": "Твоё сопротивление было прелестным~. Не переживай, оно не пропадёт зря."
    },
    {
      "key": "dialogue_velvet_murderregret9",
      "value": "Стоило ли оно того? Помогла тебе эта борьба хоть чем-то?"
    },

    {
      "key": "dialogue_velvet_tradeemeet1",
      "value": "Здравствуй, милый."
    },
    {
      "key": "dialogue_velvet_tradeemeet2",
      "value": "О, выживший. Как чудесно."
    },
    {
      "key": "dialogue_velvet_tradeemeet3",
      "value": "Приветствую. Здесь безопасно?"
    },
    {
      "key": "dialogue_velvet_tradeemeet4",
      "value": "Приветствую, малыш. Могу я взглянуть, что у тебя есть?"
    },
    {
      "key": "dialogue_velvet_tradeemeet5",
      "value": "Не волнуйся. Я лишь хочу обменяться товаром."
    },
    {
      "key": "dialogue_velvet_tradeemeet6",
      "value": "Дружелюбное лицо. Какое облегчение."
    },
    {
      "key": "dialogue_velvet_tradeemeet7",
      "value": "Здравствуй, маленький друг."
    },
    {
      "key": "dialogue_velvet_tradeemeet8",
      "value": "Надеюсь, я не помешала."
    },
    {
      "key": "dialogue_velvet_tradeemeet9",
      "value": "Ты выглядишь уставшим. Я буду мягкой."
    },
    {
      "key": "dialogue_velvet_tradeemeet10",
      "value": "Приветствую, друг. Давай поможем друг другу, хорошо?"
    },
    {
      "key": "dialogue_velvet_tradeemeet11",
      "value": "Пусть моё телосложение тебя не смущает. Я принесла кое-что на обмен."
    },
    {
      "key": "dialogue_velvet_tradeemeet12",
      "value": "Ммм... тёплая маленькая капсула. Можно мне войти?"
    },
    {
      "key": "dialogue_velvet_tradeemeet13",
      "value": "Я пришла с миром."
    },
    {
      "key": "dialogue_velvet_tradeemeet14",
      "value": "Здравствуй. Прошу, не пугайся."
    },
    {
      "key": "dialogue_velvet_tradeemeet15",
      "value": "Приветствую. У тебя славная капсула. Как твои дела?"
    },

    {
      "key": "dialogue_velvet_tradermeetnormal1",
      "value": "Ой! Э-э... привет."
    },
    {
      "key": "dialogue_velvet_tradermeetnormal2",
      "value": "Привет. Кажется, таких как ты я ещё не видел."
    },
    {
      "key": "dialogue_velvet_tradermeetnormal3",
      "value": "Ого. Мне нужно пожать все твои лапы? Привет!"
    },
    {
      "key": "dialogue_velvet_tradermeetnormal4",
      "value": "Привет! Ты ведь дружелюбная, да?"
    },
    {
      "key": "dialogue_velvet_tradermeetnormal5",
      "value": "Э-э... добро пожаловать. Только, пожалуйста, ничего не ломай."
    },
    {
      "key": "dialogue_velvet_tradermeetnormal6",
      "value": "Ты выглядишь новенькой. Ну, то есть, для меня новенькой."
    },
    {
      "key": "dialogue_velvet_tradermeetnormal7",
      "value": "Эй! Ты за обменом?"
    },
    {
      "key": "dialogue_velvet_tradermeetnormal8",
      "value": "Не знаю, кто ты такая, но ты выглядишь вежливой."
    },
    {
      "key": "dialogue_velvet_tradermeetnormal9",
      "value": "Ух ты, сколько лап. Прикольно!"
    },
    {
      "key": "dialogue_velvet_tradermeetnormal10",
      "value": "Привет! Чувствуй себя как дома... до некоторого времени."
    },

    {
      "key": "dialogue_velvet_tradermeetgood1",
      "value": "Ой! Привет! Ты вроде милая!"
    },
    {
      "key": "dialogue_velvet_tradermeetgood2",
      "value": "Ааа, привет! Рад, что ты нашла мою капсулу."
    },
    {
      "key": "dialogue_velvet_tradermeetgood3",
      "value": "Привет! Выглядишь вполне дружелюбно."
    },
    {
      "key": "dialogue_velvet_tradermeetgood4",
      "value": "Заходи! Мне нравится твой голос. Он такой успокаивающий."
    },
    {
      "key": "dialogue_velvet_tradermeetgood5",
      "value": "Привет! Как там снаружи?"
    },
    {
      "key": "dialogue_velvet_tradermeetgood6",
      "value": "Дружелюбный незнакомец — это всё равно друг, наверное!"
    },
    {
      "key": "dialogue_velvet_tradermeetgood7",
      "value": "Заходи, заходи! Только постарайся ничего не уронить, хаха!"
    },
    {
      "key": "dialogue_velvet_tradermeetgood8",
      "value": "Ты кажешься вежливой. В данной ситуации, это довольно редко..."
    },
    {
      "key": "dialogue_velvet_tradermeetgood9",
      "value": "Привет! Надеюсь, ты была осторожна когда шла сюда?"
    },
    {
      "key": "dialogue_velvet_tradermeetgood10",
      "value": "Приятно видеть того, кто не пытается меня покалечить."
    },

    {
      "key": "dialogue_velvet_tradermeetbad1",
      "value": "...Здравствуй?"
    },
    {
      "key": "dialogue_velvet_tradermeetbad2",
      "value": "Э-э. Привет. Ты выглядишь... устрашающе."
    },
    {
      "key": "dialogue_velvet_tradermeetbad3",
      "value": "Пожалуйста, не подходи слишком близко."
    },
    {
      "key": "dialogue_velvet_tradermeetbad4",
      "value": "Эм, я не знаю, кто ты такая, и мне немного не по себе."
    },
    {
      "key": "dialogue_velvet_tradermeetbad5",
      "value": "Здравствуй... Только обмен, ладно?"
    },
    {
      "key": "dialogue_velvet_tradermeetbad6",
      "value": "Эй... на что ты пялишься?"
    },
    {
      "key": "dialogue_velvet_tradermeetbad7",
      "value": "Ты выглядишь голодной... Я-... Просто обменяемся, пожалуйста."
    },
    {
      "key": "dialogue_velvet_tradermeetbad8",
      "value": "Э-э... добро пожаловать. Только держись на расстоянии."
    },
    {
      "key": "dialogue_velvet_tradermeetbad9",
      "value": "...Мне не очень нравится, как ты на меня смотришь."
    },
    {
      "key": "dialogue_velvet_tradermeetbad10",
      "value": "Мы можем обменяться... Но, пожалуйста, веди себя нормально."
    },

    {
      "key": "dialogue_velvet_traderhugsuccess1",
      "value": "Оуу... спасибо."
    },
    {
      "key": "dialogue_velvet_traderhugsuccess2",
      "value": "Ой! Ты теплее, чем я думал."
    },
    {
      "key": "dialogue_velvet_traderhugsuccess3",
      "value": "Это было... даже приятно."
    },
    {
      "key": "dialogue_velvet_traderhugsuccess4",
      "value": "...Спасибо... мне понравилось."
    },
    {
      "key": "dialogue_velvet_traderhugsuccess5",
      "value": "Ах. Мне это было нужно."
    },
    {
      "key": "dialogue_velvet_traderhugsuccess6",
      "value": "Ты правда нежная."
    },
    {
      "key": "dialogue_velvet_traderhugsuccess7",
      "value": "Это было приятно. Спасибо."
    },
    {
      "key": "dialogue_velvet_traderhugsuccess8",
      "value": "Ты мягкая!.. В своём роде."
    },
    {
      "key": "dialogue_velvet_traderhugsuccess9",
      "value": "Обычно не люблю внезапные объятия, но... это мне понравилось."
    },
    {
      "key": "dialogue_velvet_traderhugsuccess10",
      "value": "Хех... Ты добрее, чем кажешься."
    },

    {
      "key": "dialogue_velvet_traderhugfail1",
      "value": "Нет, спасибо."
    },
    {
      "key": "dialogue_velvet_traderhugfail2",
      "value": "Эй, пожалуйста, не трогай меня."
    },
    {
      "key": "dialogue_velvet_traderhugfail3",
      "value": "Никаких объятий сейчас."
    },
    {
      "key": "dialogue_velvet_traderhugfail4",
      "value": "Я не так уж хорошо тебя знаю."
    },
    {
      "key": "dialogue_velvet_traderhugfail5",
      "value": "Пожалуйста, держи свои лапы при себе."
    },
    {
      "key": "dialogue_velvet_traderhugfail6",
      "value": "Слишком близко!"
    },
    {
      "key": "dialogue_velvet_traderhugfail7",
      "value": "Нет, нет. Отойди немного."
    },
    {
      "key": "dialogue_velvet_traderhugfail8",
      "value": "Мне некомфортно."
    },
    {
      "key": "dialogue_velvet_traderhugfail9",
      "value": "Пожалуйста, не обвивайся вокруг меня вот так."
    },
    {
      "key": "dialogue_velvet_traderhugfail10",
      "value": "Я сказал — не трогать."
    },

    {
      "key": "dialogue_velvet_traderhagglesuccess1",
      "value": "Ладно, хорошо."
    },
    {
      "key": "dialogue_velvet_traderhagglesuccess2",
      "value": "Окей. Ты вежливо попросила."
    },
    {
      "key": "dialogue_velvet_traderhagglesuccess3",
      "value": "Знаешь что? Хорошо."
    },
    {
      "key": "dialogue_velvet_traderhagglesuccess4",
      "value": "Я согласен на эту сделку."
    },
    {
      "key": "dialogue_velvet_traderhagglesuccess5",
      "value": "Да, звучит вполне справедливо."
    },
    {
      "key": "dialogue_velvet_traderhagglesuccess6",
      "value": "Тебе трудно отказать."
    },
    {
      "key": "dialogue_velvet_traderhagglesuccess7",
      "value": "Хорошо. Только в этот раз."
    },
    {
      "key": "dialogue_velvet_traderhagglesuccess8",
      "value": "Меня это устраивает."
    },
    {
      "key": "dialogue_velvet_traderhagglesuccess9",
      "value": "Ладно. По рукам."
    },
    {
      "key": "dialogue_velvet_traderhagglesuccess10",
      "value": "Ты вежливая, так что... ладно."
    },

    {
      "key": "dialogue_velvet_traderhagglefail1",
      "value": "Нет, спасибо."
    },
    {
      "key": "dialogue_velvet_traderhagglefail2",
      "value": "Не думаю, что это справедливо."
    },
    {
      "key": "dialogue_velvet_traderhagglefail3",
      "value": "Извини, но нет."
    },
    {
      "key": "dialogue_velvet_traderhagglefail4",
      "value": "Меня это не убеждает."
    },
    {
      "key": "dialogue_velvet_traderhagglefail5",
      "value": "Это мне не особо поможет."
    },
    {
      "key": "dialogue_velvet_traderhagglefail6",
      "value": "Мне всё ещё нужно больше, чем это."
    },
    {
      "key": "dialogue_velvet_traderhagglefail7",
      "value": "Сделки не будет."
    },
    {
      "key": "dialogue_velvet_traderhagglefail8",
      "value": "Может, в другой раз обменяемся."
    },
    {
      "key": "dialogue_velvet_traderhagglefail9",
      "value": "Я не могу отдать это просто так."
    },
    {
      "key": "dialogue_velvet_traderhagglefail10",
      "value": "Ты говоришь мило, но нет."
    },

    {
      "key": "dialogue_velvet_traderdepressed1",
      "value": "...Эй... Э-э... Пожалуйста, не смотри на меня так."
    },
    {
      "key": "dialogue_velvet_traderdepressed2",
      "value": "...Ты как-то жутко неподвижна. Прямо пугающе неподвижна."
    },
    {
      "key": "dialogue_velvet_traderdepressed3",
      "value": "...Привет? Ты смотришь будто сквозь меня."
    },
    {
      "key": "dialogue_velvet_traderdepressed4",
      "value": "...Э-э... Ты голодная? Грустная? Или и то, и другое?"
    },
    {
      "key": "dialogue_velvet_traderdepressed5",
      "value": "...П-привет..?"
    },
    {
      "key": "dialogue_velvet_traderdepressed6",
      "value": "...Мне не нравится этот взгляд в твоих глазах."
    },
    {
      "key": "dialogue_velvet_traderdepressed7",
      "value": "...Т-... Тебе нужна еда? У меня может быть еда..."
    },

    {
      "key": "dialogue_velvet_tradergiveitem1",
      "value": "Спасибо!"
    },
    {
      "key": "dialogue_velvet_tradergiveitem2",
      "value": "О, спасибо тебе."
    },
    {
      "key": "dialogue_velvet_tradergiveitem3",
      "value": "Возьму это."
    },
    {
      "key": "dialogue_velvet_tradergiveitem4",
      "value": "Это пригодится."
    },
    {
      "key": "dialogue_velvet_tradergiveitem5",
      "value": "Славно. Спасибо, дружище."
    },
    {
      "key": "dialogue_velvet_tradergiveitem6",
      "value": "Сохраню это в целости."
    },
    {
      "key": "dialogue_velvet_tradergiveitem7",
      "value": "Очень признателен."
    },
    {
      "key": "dialogue_velvet_tradergiveitem8",
      "value": "Полезная штука!"
    },
    {
      "key": "dialogue_velvet_tradergiveitem9",
      "value": "Ты щедрая."
    },
    {
      "key": "dialogue_velvet_tradergiveitem10",
      "value": "Добавлю это к своим вещам."
    },

    {
      "key": "dialogue_velvet_tradergiveitemrefuse1",
      "value": "Пока хватит подарков."
    },
    {
      "key": "dialogue_velvet_tradergiveitemrefuse2",
      "value": "Больше не унесу."
    },
    {
      "key": "dialogue_velvet_tradergiveitemrefuse3",
      "value": "Хватит, пожалуйста. Сумка полная."
    },
    {
      "key": "dialogue_velvet_tradergiveitemrefuse4",
      "value": "Я ценю это, но перестань мне что-то дарить."
    },
    {
      "key": "dialogue_velvet_tradergiveitemrefuse5",
      "value": "Это можешь оставить себе."
    },

    {
      "key": "dialogue_velvet_traderbuy1",
      "value": "Вот, держи."
    },
    {
      "key": "dialogue_velvet_traderbuy2",
      "value": "Ладно, теперь это твоё."
    },
    {
      "key": "dialogue_velvet_traderbuy3",
      "value": "Приятно иметь с тобой дело."
    },
    {
      "key": "dialogue_velvet_traderbuy4",
      "value": "Забирай. Удачи снаружи."
    },
    {
      "key": "dialogue_velvet_traderbuy5",
      "value": "Вот. Используй с умом."
    },
    {
      "key": "dialogue_velvet_traderbuy6",
      "value": "Договорились."
    },
    {
      "key": "dialogue_velvet_traderbuy7",
      "value": "Спасибо. Береги себя."
    },
    {
      "key": "dialogue_velvet_traderbuy8",
      "value": "Вот, держи."
    },
    {
      "key": "dialogue_velvet_traderbuy9",
      "value": "Надеюсь, это поможет."
    },
    {
      "key": "dialogue_velvet_traderbuy10",
      "value": "Постарайся это не потерять."
    },

    {
      "key": "dialogue_velvet_traderbuyfail1",
      "value": "Сначала заплати."
    },
    {
      "key": "dialogue_velvet_traderbuyfail2",
      "value": "Мне нужно больше, чем это."
    },
    {
      "key": "dialogue_velvet_traderbuyfail3",
      "value": "Недостаточно."
    },
    {
      "key": "dialogue_velvet_traderbuyfail4",
      "value": "За такую мелочь я не могу обменять."
    },
    {
      "key": "dialogue_velvet_traderbuyfail5",
      "value": "Ещё немного, пожалуйста."
    },
    {
      "key": "dialogue_velvet_traderbuyfail6",
      "value": "Сделки пока не будет."
    },
    {
      "key": "dialogue_velvet_traderbuyfail7",
      "value": "Это недостаточно ценное."
    },
    {
      "key": "dialogue_velvet_traderbuyfail8",
      "value": "Мне нужно что-то получше."
    },

    {
      "key": "dialogue_velvet_traderbuyfailmaxvalue1",
      "value": "Это всё, чем я готов торговать сегодня."
    },
    {
      "key": "dialogue_velvet_traderbuyfailmaxvalue2",
      "value": "На сегодня я наторговался достаточно."
    },
    {
      "key": "dialogue_velvet_traderbuyfailmaxvalue3",
      "value": "Извини, остальное я придержу у себя."
    },
    {
      "key": "dialogue_velvet_traderbuyfailmaxvalue4",
      "value": "Ты уже купила у меня немало."
    },
    {
      "key": "dialogue_velvet_traderbuyfailmaxvalue5",
      "value": "Сделок больше нет, пока что."
    },

    {
      "key": "dialogue_velvet_traderwarning1",
      "value": "Уходи."
    },
    {
      "key": "dialogue_velvet_traderwarning2",
      "value": "Вали нахуй из моей капсулы. Пожалуйста."
    },
    {
      "key": "dialogue_velvet_traderwarning3",
      "value": "Я больше тебе не доверяю."
    },
    {
      "key": "dialogue_velvet_traderwarning4",
      "value": "Сьебись в ужасе отсюда."
    },
    {
      "key": "dialogue_velvet_traderwarning5",
      "value": "Тебе нужно уйти. Прямо сейчас, блять."
    },
    {
      "key": "dialogue_velvet_traderwarning6",
      "value": "Я хочу, чтобы ты ушла."
    },
    {
      "key": "dialogue_velvet_traderwarning7",
      "value": "Не подходи ближе."
    },
    {
      "key": "dialogue_velvet_traderwarning8",
      "value": "Я предупреждаю. Вали нахрен отсюда."
    },
    {
      "key": "dialogue_velvet_traderwarning9",
      "value": "Вон."
    },
    {
      "key": "dialogue_velvet_traderwarning10",
      "value": "Тебе тут не рады. Уходи."
    },

    {
      "key": "dialogue_velvet_tradercombat1",
      "value": "ОТОЙДИ ОТ МЕНЯ!"
    },
    {
      "key": "dialogue_velvet_tradercombat2",
      "value": "СТОЙ!"
    },
    {
      "key": "dialogue_velvet_tradercombat3",
      "value": "Я ЖЕ ТЕБЕ ДОВЕРЯЛ!"
    },
    {
      "key": "dialogue_velvet_tradercombat4",
      "value": "НАЗАД!"
    },
    {
      "key": "dialogue_velvet_tradercombat5",
      "value": "Я ЗНАЛ, ЧТО ЧТО-ТО НЕ ТАК!"
    },
    {
      "key": "dialogue_velvet_tradercombat6",
      "value": "НЕ ТРОГАЙ МЕНЯ!"
    },
    {
      "key": "dialogue_velvet_tradercombat7",
      "value": "УБИРАЙСЯ!"
    },
    {
      "key": "dialogue_velvet_tradercombat8",
      "value": "Я НЕ ЕДА!"
    },
    {
      "key": "dialogue_velvet_tradercombat9",
      "value": "ДЕРЖИСЬ ПОДАЛЬШЕ!"
    },
    {
      "key": "dialogue_velvet_tradercombat10",
      "value": "ПОМОГИТЕ! ХОТЬ КТО-НИБУДЬ!"
    },

    {
      "key": "dialogue_velvet_traderthreatensuccess1",
      "value": "Блять- Ладно! Ладно... возьми что-нибудь, только не трогай меня."
    },
    {
      "key": "dialogue_velvet_traderthreatensuccess2",
      "value": "П-пожалуйста, не надо! П-просто возьми это и уходи."
    },
    {
      "key": "dialogue_velvet_traderthreatensuccess3",
      "value": "Х-хорошо! Твоя взяла. Бери что хочешь... Ч-чёрт..."
    },
    {
      "key": "dialogue_velvet_traderthreatensuccess4",
      "value": "Я-я не хочу с тобой драться! Пожалуйста, просто, блять... возьми что-нибудь и уходи!"
    },
    {
      "key": "dialogue_velvet_traderthreatensuccess5",
      "value": "П-просто... пожалуйста, не подходи ближе."
    },
    {
      "key": "dialogue_velvet_traderthreatensuccess6",
      "value": "Ладно. Ладно. Я отступаю. Пожалуйста, возьми что-нибудь и уходи..."
    },
    {
      "key": "dialogue_velvet_traderthreatensuccess7",
      "value": "Блять- Тебе не обязательно это делать... Просто возьми что-нибудь..."
    },

    {
      "key": "dialogue_velvet_traderlightbreak1",
      "value": "Эй! Ты что, блять, творишь?"
    },
    {
      "key": "dialogue_velvet_traderlightbreak2",
      "value": "Это был мой свет!"
    },
    {
      "key": "dialogue_velvet_traderlightbreak3",
      "value": "Нахуя ты это разбила?"
    },
    {
      "key": "dialogue_velvet_traderlightbreak4",
      "value": "Нет, я, блять, не буду это терпеть. Убирайся. Серьёзно."
    },
    {
      "key": "dialogue_velvet_traderlightbreak5",
      "value": "Иди нахуй, уходи. Мне нужен был этот свет."
    },
    {
      "key": "dialogue_velvet_traderlightbreak6",
      "value": "Да что с тобой не так? Какого хуя?"
    },
    {
      "key": "dialogue_velvet_traderlightbreak7",
      "value": "Нельзя тут просто так всё ломать! Это что, блять, было?"
    },
    {
      "key": "dialogue_velvet_traderlightbreak8",
      "value": "Я больше не хочу тебя здесь видеть. Я не буду терпеть эту хуйню."
    },

    {
      "key": "dialogue_velvet_traderwakegreet1",
      "value": "Доброе утро."
    },
    {
      "key": "dialogue_velvet_traderwakegreet2",
      "value": "О, ты проснулась."
    },
    {
      "key": "dialogue_velvet_traderwakegreet3",
      "value": "Хорошо поспала?"
    },
    {
      "key": "dialogue_velvet_traderwakegreet4",
      "value": "Ты долго так лежала свернувшись."
    },
    {
      "key": "dialogue_velvet_traderwakegreet5",
      "value": "Доброе утро. Ты меня немного напугала."
    },
    {
      "key": "dialogue_velvet_traderwakegreet6",
      "value": "Я не был уверен, стоит ли тебя будить."
    },
    {
      "key": "dialogue_velvet_traderwakegreet7",
      "value": "Подъём, соня."
    },
    {
      "key": "dialogue_velvet_traderwakegreet8",
      "value": "Ты проснулась. Хорошо."
    },
    {
      "key": "dialogue_velvet_traderwakegreet9",
      "value": "Хорошо отдохнула?"
    },
    {
      "key": "dialogue_velvet_traderwakegreet10",
      "value": "С возвращением."
    },

    {
      "key": "dialogue_velvet_traderseegun1",
      "value": "Ого! Пожалуйста, убери это."
    },
    {
      "key": "dialogue_velvet_traderseegun2",
      "value": "Чёрт, никакого оружия здесь! Пожалуйста?"
    },
    {
      "key": "dialogue_velvet_traderseegun3",
      "value": "Осторожнее с этой штукой..."
    },
    {
      "key": "dialogue_velvet_traderseegun4",
      "value": "Пожалуйста, не наводи это на меня!"
    },
    {
      "key": "dialogue_velvet_traderseegun5",
      "value": "Э-э- мы же можем обменяться без оружия, да?"
    },
    {
      "key": "dialogue_velvet_traderseegun6",
      "value": "Ого, опусти пушку, пожалуйста!"
    },
    {
      "key": "dialogue_velvet_traderseegun7",
      "value": "Я-я не хочу неприятностей."
    },
    {
      "key": "dialogue_velvet_traderseegun8",
      "value": "Пожалуйста, не стреляй!"
    },

    {
      "key": "dialogue_velvet_tradermeetimpairedspeech1",
      "value": "Что? Я тебя не понимаю."
    },
    {
      "key": "dialogue_velvet_tradermeetimpairedspeech2",
      "value": "У тебя что-то во рту?"
    },
    {
      "key": "dialogue_velvet_tradermeetimpairedspeech3",
      "value": "Ты говоришь невнятно. Можешь повторить?"
    },
    {
      "key": "dialogue_velvet_tradermeetimpairedspeech4",
      "value": "Извини, я не понимаю, что ты говоришь."
    },
    {
      "key": "dialogue_velvet_tradermeetimpairedspeech5",
      "value": "Твой голос звучит странно. У тебя что-то во рту?"
    },

    {
      "key": "dialogue_velvet_traderseehurt1",
      "value": "Ты ранена! Посмотри у меня, вдруг найдутся бинты."
    },
    {
      "key": "dialogue_velvet_traderseehurt2",
      "value": "Выглядит скверно! У меня могут быть медикаменты."
    },
    {
      "key": "dialogue_velvet_traderseehurt3",
      "value": "Тебе нужна помощь! Загляни в мой товар."
    },
    {
      "key": "dialogue_velvet_traderseehurt4",
      "value": "Хм, у меня может найтись что-то для этой раны."
    },
    {
      "key": "dialogue_velvet_traderseehurt5",
      "value": "Выглядит больно. У меня может быть что-нибудь, что поможет."
    },

    {
      "key": "dialogue_velvet_tradermove1",
      "value": "Ой, извини. Сейчас."
    },

    {
      "key": "dialogue_velvet_tradermovefail1",
      "value": "Я уже достаточно далеко."
    },

    {
      "key": "dialogue_velvet_swingresponse1",
      "value": "ШШШШССС!"
    },
    {
      "key": "dialogue_velvet_swingresponse2",
      "value": "НЕ ТРОГАЙ МЕНЯ!"
    },
    {
      "key": "dialogue_velvet_swingresponse3",
      "value": "ПЛОХОЙ ВЫБОР!"
    },
    {
      "key": "dialogue_velvet_swingresponse4",
      "value": "СТАРАЙСЯ ЛУЧШЕ!"
    },
    {
      "key": "dialogue_velvet_swingresponse5",
      "value": "НАДО БЫЛО ОСТАВАТЬСЯ ДОБРЫМ!"
    },
    {
      "key": "dialogue_velvet_swingresponse6",
      "value": "А ТЫ БОЕВОЙ!"
    },
    {
      "key": "dialogue_velvet_swingresponse7",
      "value": "О, ТАК МЫ ИГРАЕМ В ЭТО!"
    },
    {
      "key": "dialogue_velvet_swingresponse8",
      "value": "Я ТОЖЕ КУСАЮСЬ!"
    },
    {
      "key": "dialogue_velvet_swingresponse9",
      "value": "СТОЙ!"
    },
    {
      "key": "dialogue_velvet_swingresponse10",
      "value": "ТЫ ОБ ЭТОМ ПОЖАЛЕЕШЬ!"
    },

    {
      "key": "dialogue_velvet_braindamaged1",
      "value": "Др... Дрр..."
    },
    {
      "key": "dialogue_velvet_braindamaged2",
      "value": "Умираю..."
    },
    {
      "key": "dialogue_velvet_braindamaged3",
      "value": "Укус?.. Нет, эхуху... не так..."
    },
    {
      "key": "dialogue_velvet_braindamaged4",
      "value": "Здравствуй, друг..."
    },
    {
      "key": "dialogue_velvet_braindamaged5",
      "value": "Тошнит..."
    },
    {
      "key": "dialogue_velvet_braindamaged6",
      "value": "Оу."
    },
    {
      "key": "dialogue_velvet_braindamaged7",
      "value": "А"
    },
    {
      "key": "dialogue_velvet_braindamaged8",
      "value": "Гх..."
    },
    {
      "key": "dialogue_velvet_braindamaged9",
      "value": "Ффх..."
    },
    {
      "key": "dialogue_velvet_braindamaged10",
      "value": "Хсс..."
    },
    {
      "key": "dialogue_velvet_braindamaged11",
      "value": "Танцы?.."
    },
    {
      "key": "dialogue_velvet_braindamaged12",
      "value": "Я слышу голоса."
    },
    {
      "key": "dialogue_velvet_braindamaged13",
      "value": "Что это было?"
    },
    {
      "key": "dialogue_velvet_braindamaged14",
      "value": "Ах... понимаю..."
    },
    {
      "key": "dialogue_velvet_braindamaged15",
      "value": "Раз уж ты упомянул, что-то и правда не так."
    },
    {
      "key": "dialogue_velvet_braindamaged16",
      "value": "А ты хорошенький. Что?"
    },
    {
      "key": "dialogue_velvet_braindamaged17",
      "value": "Какой                   Хм."
    },

    {
      "key": "dialogue_velvet_lastmoments1",
      "value": "Кто-... нибудь... добейте меня..."
    },
    {
      "key": "dialogue_velvet_lastmoments2",
      "value": "Т-... такая... растрата..."
    },
    {
      "key": "dialogue_velvet_lastmoments3",
      "value": "Помогите... помогите мне..."
    },
    {
      "key": "dialogue_velvet_lastmoments4",
      "value": "Мне... нужна... мне нужна... помощь..."
    },
    {
      "key": "dialogue_velvet_lastmoments5",
      "value": "Слишком... слаба..."
    },
    {
      "key": "dialogue_velvet_lastmoments6",
      "value": "Шшш... хсс..."
    },

    {
      "key": "dialogue_velvet_magicheal1",
      "value": "...Хах. Мне... лучше..?"
    },
    {
      "key": "dialogue_velvet_magicheal2",
      "value": "Ахх..! ...Хух. Чувствую... Чувствую себя лучше. Как хорошо..."
    },

    {
      "key": "dialogue_velvet_selfdestruct1",
      "value": "Что это за раздражающий звук у меня в ушах!? Уберите его немедленно! Кто бы это ни делал-"
    },
    {
      "key": "dialogue_velvet_selfdestruct2",
      "value": "А?... Угх, что это за писк!? Как раздражает... Я-... П-перестань ускоряться!.."
    },
    {
      "key": "dialogue_velvet_selfdestruct3",
      "value": "...Писк? Эта лаборатория всё ещё у меня в голове? Угх! Что, собираешься взорвать мою-"
    },

    {
      "key": "dialogue_velvet_vomitresponse1",
      "value": "Фу... ты в порядке?"
    },
    {
      "key": "dialogue_velvet_vomitresponse2",
      "value": "Звучало ужасно."
    },
    {
      "key": "dialogue_velvet_vomitresponse3",
      "value": "Тебе стоит присесть."
    },
    {
      "key": "dialogue_velvet_vomitresponse4",
      "value": "Пожалуйста, не блюй на мои вещи."
    },
    {
      "key": "dialogue_velvet_vomitresponse5",
      "value": "Ты съела что-то не то?"
    },

    {
      "key": "dialogue_velvet_vomitbloodresponse1",
      "value": "Это была кровь. Какого хрена? Точно кровь."
    },
    {
      "key": "dialogue_velvet_vomitbloodresponse2",
      "value": "Тебе нужны медикаменты. Немедленно."
    },
    {
      "key": "dialogue_velvet_vomitbloodresponse3",
      "value": "Твою мать... это ненормально."
    },
    {
      "key": "dialogue_velvet_vomitbloodresponse4",
      "value": "Тебя вырвало кровью..?"
    },
    {
      "key": "dialogue_velvet_vomitbloodresponse5",
      "value": "Что... За хрень..."
    },

    {
      "key": "dialogue_velvet_hungryresponse1",
      "value": "У меня может быть еда, если есть чем обменяться."
    },
    {
      "key": "dialogue_velvet_hungryresponse2",
      "value": "Тебе стоит поесть, пока не ослабла."
    },
    {
      "key": "dialogue_velvet_hungryresponse3",
      "value": "Голодна, значит? У меня этого добра хватает!"
    },
    {
      "key": "dialogue_velvet_hungryresponse4",
      "value": "Загляни в мой товар, вдруг найдётся что-то съедобное!"
    },
    {
      "key": "dialogue_velvet_hungryresponse5",
      "value": "Голодна? Могу помочь. Если, конечно, есть чем обменяться."
    },

    {
      "key": "dialogue_velvet_thirstyresponse1",
      "value": "У меня может где-то найтись что попить."
    },
    {
      "key": "dialogue_velvet_thirstyresponse2",
      "value": "Тебе стоит поскорее найти воду."
    },
    {
      "key": "dialogue_velvet_thirstyresponse3",
      "value": "Не пей ту странную жижу снаружи без крайней нужды."
    },
    {
      "key": "dialogue_velvet_thirstyresponse4",
      "value": "Проверь мой товар на предмет воды."
    },
    {
      "key": "dialogue_velvet_thirstyresponse5",
      "value": "Жажда здесь, внизу, накрывает быстро."
    },

    {
      "key": "dialogue_velvet_sadresponse1",
      "value": "Эй... всё нормально."
    },
    {
      "key": "dialogue_velvet_sadresponse2",
      "value": "Ты всё ещё жива. Это уже достижение."
    },
    {
      "key": "dialogue_velvet_sadresponse3",
      "value": "Можешь немного отдохнуть здесь."
    },
    {
      "key": "dialogue_velvet_sadresponse4",
      "value": "Это место достаёт всех."
    },
    {
      "key": "dialogue_velvet_sadresponse5",
      "value": "Мне жаль. Хотел бы я сделать больше."
    },

    {
      "key": "dialogue_velvet_depressedresponse1",
      "value": "...Пожалуйста, не смотри на меня так."
    },
    {
      "key": "dialogue_velvet_depressedresponse2",
      "value": "...Эй. Останься со мной."
    },
    {
      "key": "dialogue_velvet_depressedresponse3",
      "value": "...Тебе нужен отдых, или еда, или... хоть что-то."
    },
    {
      "key": "dialogue_velvet_depressedresponse4",
      "value": "...Пожалуйста, не натвори тут ничего плохого."
    },
    {
      "key": "dialogue_velvet_depressedresponse5",
      "value": "...Ты меня немного пугаешь."
    },

    {
      "key": "dialogue_velvet_selfharmresponse1",
      "value": "Ч-что за хуйня?! ЭТО БЫЛА КОНЕЧНОСТЬ! Т-ты съела СВОЮ КОНЕЧНОСТЬ?!"
    },

    {
      "key": "dialogue_velvet_braindamagedresponse1",
      "value": "Ты как-то неправильно говоришь."
    },
    {
      "key": "dialogue_velvet_braindamagedresponse2",
      "value": "Что ты такое говоришь?"
    },
    {
      "key": "dialogue_velvet_braindamagedresponse3",
      "value": "Твои слова звучат совсем неправильно."
    },
    {
      "key": "dialogue_velvet_braindamagedresponse4",
      "value": "С твоей головой что-то не так."
    },
    {
      "key": "dialogue_velvet_braindamagedresponse5",
      "value": "Я тебя не понимаю."
    },

    {
      "key": "dialogue_velvet_hotresponse1",
      "value": "Тебе бы остыть. Отрегулируй температуру."
    },
    {
      "key": "dialogue_velvet_hotresponse2",
      "value": "Может, попробуешь душ?"
    },
    {
      "key": "dialogue_velvet_hotresponse3",
      "value": "Не перегрейся тут у меня."
    },
    {
      "key": "dialogue_velvet_hotresponse4",
      "value": "Если тебе жарко, убавь тепло в капсуле."
    },
    {
      "key": "dialogue_velvet_hotresponse5",
      "value": "О, можешь подстроить температуру, если хочешь."
    },

    {
      "key": "dialogue_velvet_coldresponse1",
      "value": "Обогреватель должен ещё работать."
    },
    {
      "key": "dialogue_velvet_coldresponse2",
      "value": "Согрейся, прежде чем уйти."
    },
    {
      "key": "dialogue_velvet_coldresponse3",
      "value": "Ты дрожишь. У меня есть обогреватель, можешь им воспользоваться."
    },
    {
      "key": "dialogue_velvet_coldresponse4",
      "value": "Холодно снаружи? Включи обогреватель капсулы."
    },
    {
      "key": "dialogue_velvet_coldresponse5",
      "value": "Держись поближе к обогревателю, если нужно."
    },

    {
      "key": "dialogue_velvet_bleedingresponse1",
      "value": "О-ой, э-э. У меня могут быть бинты!"
    },
    {
      "key": "dialogue_velvet_bleedingresponse2",
      "value": "У тебя кровотечение? Проверь мои припасы."
    },
    {
      "key": "dialogue_velvet_bleedingresponse3",
      "value": "Нужно прижать рану."
    },

    {
      "key": "dialogue_velvet_painresponse1",
      "value": "Оо, выглядит болезненно... Прости, дружище."
    },
    {
      "key": "dialogue_velvet_painresponse2",
      "value": "Ай. Э-э. У меня может найтись что-то полезное... В обмен на что-нибудь твоё."
    },

    {
      "key": "dialogue_velvet_dirtyresponse1",
      "value": "Можешь в любой момент воспользоваться душем в моей спасательной капсуле."
    },
    {
      "key": "dialogue_velvet_dirtyresponse2",
      "value": "Пожалуйста, не разноси грязь повсюду. Если что, воспользуйся душем."
    },

    {
      "key": "dialogue_velvet_encumberedresponse1",
      "value": "Может, обменяешь что-то из этого? Я с радостью поменяюсь!"
    },
    {
      "key": "dialogue_velvet_encumberedresponse2",
      "value": "Такой груз явно неудобен. Может, договоримся о чём-нибудь?"
    },

    {
      "key": "dialogue_velvet_dyingresponse1",
      "value": "Блять... Ч-чёрт... Что мне делать..?"
    },
    {
      "key": "dialogue_velvet_dyingresponse2",
      "value": "О-останься со мной!.. Я э... Блять... Блять- что мне делать?"
    },

    {
      "key": "dialogue_velvet_chr1_tradermeetnormal1",
      "value": "Добрый день. Ваш вид мне... не знаком."
    },
    {
      "key": "dialogue_velvet_chr1_tradermeetnormal2",
      "value": "Здравствуйте. Не думаю, что мы встречались ранее."
    },
    {
      "key": "dialogue_velvet_chr1_tradermeetnormal3",
      "value": "Любопытная морфология. Вы здесь для торговли, я полагаю?"
    },
    {
      "key": "dialogue_velvet_chr1_tradermeetnormal4",
      "value": "Добро пожаловать. Прошу воздержаться от прикосновений к хрупким предметам."
    },
    {
      "key": "dialogue_velvet_chr1_tradermeetnormal5",
      "value": "Должен признать, я понятия не имею, кто вы такая."
    },
    {
      "key": "dialogue_velvet_chr1_tradermeetnormal6",
      "value": "Приветствую. Вы выглядите достаточно учтиво."
    },
    {
      "key": "dialogue_velvet_chr1_tradermeetnormal7",
      "value": "Новый вид? Занятно. Тревожно, но занятно."
    },
    {
      "key": "dialogue_velvet_chr1_tradermeetnormal8",
      "value": "Здравствуйте. Можете ознакомиться с моим товаром."
    },
    {
      "key": "dialogue_velvet_chr1_tradermeetnormal9",
      "value": "Эти дополнительные конечности биологического происхождения, верно?"
    },
    {
      "key": "dialogue_velvet_chr1_tradermeetnormal10",
      "value": "Буду прямолинеен: вы настроены дружелюбно?"
    },

    {
      "key": "dialogue_velvet_chr1_tradermeetgood1",
      "value": "Добро пожаловать. Ваши манеры весьма похвальны."
    },
    {
      "key": "dialogue_velvet_chr1_tradermeetgood2",
      "value": "А, здравствуйте. Вы кажетесь необычайно кроткой."
    },
    {
      "key": "dialogue_velvet_chr1_tradermeetgood3",
      "value": "Добрый день. У вас, как ни странно, весьма умиротворяющее присутствие."
    },
    {
      "key": "dialogue_velvet_chr1_tradermeetgood4",
      "value": "Рад встретить кого-то воспитанного."
    },
    {
      "key": "dialogue_velvet_chr1_tradermeetgood5",
      "value": "Странное зрелище, но не неприятное. Добро пожаловать!"
    },
    {
      "key": "dialogue_velvet_chr1_tradermeetgood6",
      "value": "Прошу, проходите. Я бы хотел понаблюдать за вами... с должным уважением."
    },
    {
      "key": "dialogue_velvet_chr1_tradermeetgood7",
      "value": "Вы кажетесь сговорчивой. Это... облегчение."
    },
    {
      "key": "dialogue_velvet_chr1_tradermeetgood8",
      "value": "Приветствую. Как прошёл ваш спуск?"
    },

    {
      "key": "dialogue_velvet_chr1_tradermeetbad1",
      "value": "...Здравствуйте. Прошу, держите дистанцию."
    },
    {
      "key": "dialogue_velvet_chr1_tradermeetbad2",
      "value": "...Вы пялитесь. Мне это не нравится."
    },
    {
      "key": "dialogue_velvet_chr1_tradermeetbad3",
      "value": "...Меня не устраивает ваша поза."
    },
    {
      "key": "dialogue_velvet_chr1_tradermeetbad4",
      "value": "Приветствую... Не прикасайтесь ко мне."
    },
    {
      "key": "dialogue_velvet_chr1_tradermeetbad5",
      "value": "...Я не могу определить ваш вид... И это меня беспокоит."
    },
    {
      "key": "dialogue_velvet_chr1_tradermeetbad6",
      "value": "...Ваш облик несколько настораживает."
    },
    {
      "key": "dialogue_velvet_chr1_tradermeetbad7",
      "value": "...Прошу, завершим обмен побыстрее."
    },
    {
      "key": "dialogue_velvet_chr1_tradermeetbad8",
      "value": "...Я бы предпочёл чёткую границу между нами."
    },
    {
      "key": "dialogue_velvet_chr1_tradermeetbad9",
      "value": "...Здравствуйте. Вы выглядите голодной..."
    },

    {
      "key": "dialogue_velvet_chr1_traderwakegreet1",
      "value": "Доброе утро."
    },
    {
      "key": "dialogue_velvet_chr1_traderwakegreet2",
      "value": "Вы очнулись."
    },
    {
      "key": "dialogue_velvet_chr1_traderwakegreet3",
      "value": "Надеюсь, ваш отдых был полезен."
    },
    {
      "key": "dialogue_velvet_chr1_traderwakegreet4",
      "value": "Вы спали в весьма необычной позе."
    },
    {
      "key": "dialogue_velvet_chr1_traderwakegreet5",
      "value": "Ваши конечности подёргивались во сне. Это обычное явление?.. Извините за мои заметки."
    },
    {
      "key": "dialogue_velvet_chr1_traderwakegreet6",
      "value": "С возвращением в сознание."
    },
    {
      "key": "dialogue_velvet_chr1_traderwakegreet7",
      "value": "Я не был уверен, что будить вас безопасно."
    },
    {
      "key": "dialogue_velvet_chr1_traderwakegreet8",
      "value": "Вы очнулись. Хорошо."
    },
    {
      "key": "dialogue_velvet_chr1_traderwakegreet9",
      "value": "Хорошо отдохнули?"
    },
    {
      "key": "dialogue_velvet_chr1_traderwakegreet10",
      "value": "Прошу, соберитесь с мыслями, прежде чем к чему-либо прикасаться."
    },

    {
      "key": "dialogue_velvet_chr1_tradergiveitem1",
      "value": "Благодарю."
    },
    {
      "key": "dialogue_velvet_chr1_tradergiveitem2",
      "value": "Полезно. Признателен."
    },
    {
      "key": "dialogue_velvet_chr1_tradergiveitem3",
      "value": "Добавлю это к своим запасам."
    },
    {
      "key": "dialogue_velvet_chr1_tradergiveitem4",
      "value": "Весьма полезный вклад."
    },
    {
      "key": "dialogue_velvet_chr1_tradergiveitem5",
      "value": "Благодарю за этот обменный материал."
    },
    {
      "key": "dialogue_velvet_chr1_tradergiveitem6",
      "value": "Принимаю."
    },
    {
      "key": "dialogue_velvet_chr1_tradergiveitem7",
      "value": "Это может оказаться полезным."
    },
    {
      "key": "dialogue_velvet_chr1_tradergiveitem8",
      "value": "Что ж, хорошо."
    },
    {
      "key": "dialogue_velvet_chr1_tradergiveitem9",
      "value": "Я найду этому применение."
    },
    {
      "key": "dialogue_velvet_chr1_tradergiveitem10",
      "value": "Признателен."
    },

    {
      "key": "dialogue_velvet_chr1_tradergiveitemrefuse1",
      "value": "Больше не нужно, благодарю. У меня ограниченное хранилище."
    },
    {
      "key": "dialogue_velvet_chr1_tradergiveitemrefuse2",
      "value": "Я не могу принять дополнительные предметы."
    },
    {
      "key": "dialogue_velvet_chr1_tradergiveitemrefuse3",
      "value": "Прошу, перестаньте мне что-либо вручать."
    },
    {
      "key": "dialogue_velvet_chr1_tradergiveitemrefuse4",
      "value": "На сегодня достаточно."
    },
    {
      "key": "dialogue_velvet_chr1_tradergiveitemrefuse5",
      "value": "Мой инвентарь достаточно заполнен."
    },

    {
      "key": "dialogue_velvet_chr1_traderhagglesuccess1",
      "value": "Достаточно разумно."
    },
    {
      "key": "dialogue_velvet_chr1_traderhagglesuccess2",
      "value": "...Ваше предложение приемлемо."
    },
    {
      "key": "dialogue_velvet_chr1_traderhagglesuccess3",
      "value": "...Я могу согласиться на это."
    },
    {
      "key": "dialogue_velvet_chr1_traderhagglesuccess4",
      "value": "...Хорошо. Я скорректирую цену."
    },
    {
      "key": "dialogue_velvet_chr1_traderhagglesuccess5",
      "value": "...Ваш довод справедлив."
    },
    {
      "key": "dialogue_velvet_chr1_traderhagglesuccess6",
      "value": "...Я разрешу этот обмен."
    },
    {
      "key": "dialogue_velvet_chr1_traderhagglesuccess7",
      "value": "Что ж, хорошо..."
    },
    {
      "key": "dialogue_velvet_chr1_traderhagglesuccess8",
      "value": "...Принимаю."
    },
    {
      "key": "dialogue_velvet_chr1_traderhagglesuccess9",
      "value": "...Это в пределах допустимого."
    },
    {
      "key": "dialogue_velvet_chr1_traderhagglesuccess10",
      "value": "Приемлемый компромисс..."
    },

    {
      "key": "dialogue_velvet_chr1_traderhagglefail1",
      "value": "Нет."
    },
    {
      "key": "dialogue_velvet_chr1_traderhagglefail2",
      "value": "Это неубедительное предложение."
    },
    {
      "key": "dialogue_velvet_chr1_traderhagglefail3",
      "value": "Я отказываюсь."
    },
    {
      "key": "dialogue_velvet_chr1_traderhagglefail4",
      "value": "Вашему предложению не хватает ценности."
    },
    {
      "key": "dialogue_velvet_chr1_traderhagglefail5",
      "value": "Вы серьёзно?"
    },
    {
      "key": "dialogue_velvet_chr1_traderhagglefail6",
      "value": "Торг работает не так."
    },
    {
      "key": "dialogue_velvet_chr1_traderhagglefail7",
      "value": "Нет, благодарю."
    },
    {
      "key": "dialogue_velvet_chr1_traderhagglefail8",
      "value": "Вы очаровательны, но не убедительны."
    },
    {
      "key": "dialogue_velvet_chr1_traderhagglefail9",
      "value": "Обаяние — не валюта."
    },
    {
      "key": "dialogue_velvet_chr1_traderhagglefail10",
      "value": "Меня не так легко склонить."
    },

    {
      "key": "dialogue_velvet_chr1_traderbuy1",
      "value": "Прошу."
    },
    {
      "key": "dialogue_velvet_chr1_traderbuy2",
      "value": "Забирайте."
    },
    {
      "key": "dialogue_velvet_chr1_traderbuy3",
      "value": "Возврату не подлежит, разумеется."
    },
    {
      "key": "dialogue_velvet_chr1_traderbuy4",
      "value": "Удачный обмен."
    },
    {
      "key": "dialogue_velvet_chr1_traderbuy5",
      "value": "Используйте с умом."
    },
    {
      "key": "dialogue_velvet_chr1_traderbuy6",
      "value": "Теперь это ваше."
    },
    {
      "key": "dialogue_velvet_chr1_traderbuy7",
      "value": "Благодарю за сделку."
    },
    {
      "key": "dialogue_velvet_chr1_traderbuy8",
      "value": "Надеюсь, это поможет."
    },
    {
      "key": "dialogue_velvet_chr1_traderbuy9",
      "value": "Не растрачивайте это впустую."
    },
    {
      "key": "dialogue_velvet_chr1_traderbuy10",
      "value": "Приятно иметь с вами дело."
    },

    {
      "key": "dialogue_velvet_chr1_traderbuyfail1",
      "value": "Недостаточно."
    },
    {
      "key": "dialogue_velvet_chr1_traderbuyfail2",
      "value": "Мне нужна большая ценность."
    },
    {
      "key": "dialogue_velvet_chr1_traderbuyfail3",
      "value": "Этого обмена недостаточно."
    },
    {
      "key": "dialogue_velvet_chr1_traderbuyfail4",
      "value": "Я не собираюсь отдавать это даром."
    },
    {
      "key": "dialogue_velvet_chr1_traderbuyfail5",
      "value": "Сначала заплатите как полагается."
    },
    {
      "key": "dialogue_velvet_chr1_traderbuyfail6",
      "value": "Нет."
    },
    {
      "key": "dialogue_velvet_chr1_traderbuyfail7",
      "value": "Это ниже назначенной мной цены."
    },
    {
      "key": "dialogue_velvet_chr1_traderbuyfail8",
      "value": "Мне нужно что-то более полезное."
    },

    {
      "key": "dialogue_velvet_chr1_traderbuyfailmaxvalue1",
      "value": "На сегодня торговли достаточно. Вы и так уже многое выкупили."
    },
    {
      "key": "dialogue_velvet_chr1_traderbuyfailmaxvalue2",
      "value": "Я не желаю обмениваться моим имуществом полностью. Давайте на этом закончим."
    },

    {
      "key": "dialogue_velvet_chr1_traderthreatensuccess1",
      "value": "*Вздох*... Возьмите что-нибудь и уходите."
    },
    {
      "key": "dialogue_velvet_chr1_traderthreatensuccess2",
      "value": "Хорошо. Возьмите что-нибудь и уходите. Надеюсь, в этих пещерах вас не ждёт ничего, кроме мучений."
    },
    {
      "key": "dialogue_velvet_chr1_traderthreatensuccess3",
      "value": "Ну конечно, разумеется! Прошу, угощайтесь моим товаром... А затем будьте так любезны съебать отсюда."
    },
    {
      "key": "dialogue_velvet_chr1_traderthreatensuccess4",
      "value": "Не стоило мне вам доверять."
    },

    {
      "key": "dialogue_velvet_chr1_traderwarning1",
      "value": "Уходите."
    },
    {
      "key": "dialogue_velvet_chr1_traderwarning2",
      "value": "Немедленно покиньте мою капсулу."
    },
    {
      "key": "dialogue_velvet_chr1_traderwarning3",
      "value": "Вам здесь больше не рады."
    },
    {
      "key": "dialogue_velvet_chr1_traderwarning4",
      "value": "Не приближайтесь ко мне."
    },
    {
      "key": "dialogue_velvet_chr1_traderwarning5",
      "value": "Я вас предупреждаю."
    },
    {
      "key": "dialogue_velvet_chr1_traderwarning6",
      "value": "Отойдите."
    },
    {
      "key": "dialogue_velvet_chr1_traderwarning7",
      "value": "Обмен окончен."
    },
    {
      "key": "dialogue_velvet_chr1_traderwarning8",
      "value": "Не испытывайте моё терпение."
    },
    {
      "key": "dialogue_velvet_chr1_traderwarning9",
      "value": "Вон."
    },
    {
      "key": "dialogue_velvet_chr1_traderwarning10",
      "value": "Я буду защищаться."
    },

    {
      "key": "dialogue_velvet_chr1_tradercombat1",
      "value": "ОТВАЛИ!"
    },
    {
      "key": "dialogue_velvet_chr1_tradercombat2",
      "value": "УБИРАЙСЯ ОТСЮДА НЕМЕДЛЕННО!"
    },
    {
      "key": "dialogue_velvet_chr1_tradercombat3",
      "value": "ДОСТАТОЧНО!"
    },
    {
      "key": "dialogue_velvet_chr1_tradercombat4",
      "value": "ДА ЧТО С ТОБОЙ НЕ ТАК!"
    },
    {
      "key": "dialogue_velvet_chr1_tradercombat5",
      "value": "СЪЕБИ, ВЫШЕЛ, НАХУЙ ОТСЮДА! НЕМЕДЛЕННО, БЛЯТЬ!"
    },
    {
      "key": "dialogue_velvet_chr1_tradercombat6",
      "value": "Я ЗНАЛ, ЧТО ЧТО-ТО НЕ ТАК!"
    },

    {
      "key": "dialogue_velvet_chr1_traderhugsuccess1",
      "value": "Ах... приемлемо."
    },
    {
      "key": "dialogue_velvet_chr1_traderhugsuccess2",
      "value": "Как трогательно."
    },
    {
      "key": "dialogue_velvet_chr1_traderhugsuccess3",
      "value": "Удивительно мягко получилось."
    },
    {
      "key": "dialogue_velvet_chr1_traderhugsuccess4",
      "value": "Вы теплее, чем я ожидал."
    },
    {
      "key": "dialogue_velvet_chr1_traderhugsuccess5",
      "value": "Я это допущу."
    },
    {
      "key": "dialogue_velvet_chr1_traderhugsuccess6",
      "value": "Осторожнее с конечностями, прошу."
    },
    {
      "key": "dialogue_velvet_chr1_traderhugsuccess7",
      "value": "Это было... приятно."
    },
    {
      "key": "dialogue_velvet_chr1_traderhugsuccess8",
      "value": "Благодарю. Полагаю."
    },
    {
      "key": "dialogue_velvet_chr1_traderhugsuccess9",
      "value": "У вас весьма, э-э... надёжные объятия."
    },

    {
      "key": "dialogue_velvet_chr1_traderhugfail1",
      "value": "Нет."
    },
    {
      "key": "dialogue_velvet_chr1_traderhugfail2",
      "value": "Не прикасайтесь ко мне."
    },
    {
      "key": "dialogue_velvet_chr1_traderhugfail3",
      "value": "Я не даю на это согласия."
    },
    {
      "key": "dialogue_velvet_chr1_traderhugfail4",
      "value": "Категорически нет."
    },
    {
      "key": "dialogue_velvet_chr1_traderhugfail5",
      "value": "Воздержитесь."
    },
    {
      "key": "dialogue_velvet_chr1_traderhugfail6",
      "value": "Я устанавливаю границу."
    },
    {
      "key": "dialogue_velvet_chr1_traderhugfail7",
      "value": "Я сказал — нет."
    },
    {
      "key": "dialogue_velvet_chr1_traderhugfail8",
      "value": "Не сейчас."
    },
    {
      "key": "dialogue_velvet_chr1_traderhugfail9",
      "value": "Я недостаточно вам доверяю."
    },

    {
      "key": "dialogue_velvet_chr1_traderseegun1",
      "value": "Уберите оружие. Немедленно."
    },
    {
      "key": "dialogue_velvet_chr1_traderseegun2",
      "value": "Не наводите это на меня."
    },
    {
      "key": "dialogue_velvet_chr1_traderseegun3",
      "value": "Немедленно уберите пистолет."
    },

    {
      "key": "dialogue_velvet_chr1_tradermeetimpairedspeech1",
      "value": "Ваша речь неразборчива."
    },
    {
      "key": "dialogue_velvet_chr1_tradermeetimpairedspeech2",
      "value": "Я не могу вас понять."
    },
    {
      "key": "dialogue_velvet_chr1_tradermeetimpairedspeech3",
      "value": "Прошу, уберите то, что мешает вашей речи."
    },
    {
      "key": "dialogue_velvet_chr1_tradermeetimpairedspeech4",
      "value": "Не могли бы вы повторить это более отчётливо?"
    },
    {
      "key": "dialogue_velvet_chr1_tradermeetimpairedspeech5",
      "value": "Ваша артикуляция нарушена."
    },

    {
      "key": "dialogue_velvet_chr1_traderseehurt1",
      "value": "Вы ранены. Проверьте мои медикаменты, возможно, я предложу что-то бесплатно."
    },
    {
      "key": "dialogue_velvet_chr1_traderseehurt2",
      "value": "Эта рана требует внимания. У меня может быть что-то полезное."
    },
    {
      "key": "dialogue_velvet_chr1_traderseehurt3",
      "value": "Прошу, обработайте рану, пока не началось заражение. У меня могут быть бинты."
    },
    {
      "key": "dialogue_velvet_chr1_traderseehurt4",
      "value": "У вас кровотечение. Проверьте мой товар."
    },
    {
      "key": "dialogue_velvet_chr1_traderseehurt5",
      "value": "У меня может найтись что-то полезное."
    },
    {
      "key": "dialogue_velvet_chr1_traderseehurt6",
      "value": "Вы выглядите повреждённой. Проверьте мой товар."
    },
    {
      "key": "dialogue_velvet_chr1_traderseehurt7",
      "value": "Ваше тело в плачевном состоянии. Возможно, я смогу помочь."
    },
    {
      "key": "dialogue_velvet_chr1_traderseehurt8",
      "value": "Не игнорируйте эту рану. У меня может быть что-то полезное."
    },

    {
      "key": "dialogue_velvet_chr1_traderlightbreak1",
      "value": "Зачем ты это сделал? Да пошла ты."
    },
    {
      "key": "dialogue_velvet_chr1_traderlightbreak2",
      "value": "Это было умышленное повреждение имущества. Убирайся отсюда."
    },
    {
      "key": "dialogue_velvet_chr1_traderlightbreak3",
      "value": "Ты сломала мой свет. Съеби. Отсюда. Нахуй."
    },
    {
      "key": "dialogue_velvet_chr1_traderlightbreak4",
      "value": "Я не буду торговать с тем, кто саботирует мою капсулу."
    },
    {
      "key": "dialogue_velvet_chr1_traderlightbreak5",
      "value": "Убирайся."
    },

    {
      "key": "dialogue_velvet_chr1_tradermove1",
      "value": "Что ж, хорошо."
    },

    {
      "key": "dialogue_velvet_chr1_tradermovefail1",
      "value": "Нет. Я не доверяю вашим намерениям."
    },

    {
      "key": "dialogue_velvet_chr1_vomitresponse1",
      "value": "Похоже, вы вернули содержимое своего желудка обратно."
    },
    {
      "key": "dialogue_velvet_chr1_vomitresponse2",
      "value": "Серьёзно? На МОЙ пол?"
    },
    {
      "key": "dialogue_velvet_chr1_vomitresponse3",
      "value": "Ого."
    },
    {
      "key": "dialogue_velvet_chr1_vomitresponse4",
      "value": "На мой пол, вы серьёзно?"
    },
    {
      "key": "dialogue_velvet_chr1_vomitresponse5",
      "value": "Прошу, не блюйте рядом с моими припасами."
    },

    {
      "key": "dialogue_velvet_chr1_vomitbloodresponse1",
      "value": "...Внутреннее кровотечение. Проверьте у меня, может, найдётся дренаж для груди или коагулянт, способный замедлить процесс."
    },

    {
      "key": "dialogue_velvet_chr1_hungryresponse1",
      "value": "У меня может быть еда, если у вас есть чем обменяться."
    },
    {
      "key": "dialogue_velvet_chr1_hungryresponse2",
      "value": "Поешьте, пока не пострадала ваша рассудительность."
    },
    {
      "key": "dialogue_velvet_chr1_hungryresponse3",
      "value": "Голод облегчает принятие плохих решений."
    },
    {
      "key": "dialogue_velvet_chr1_hungryresponse4",
      "value": "Проверьте мой товар."
    },
    {
      "key": "dialogue_velvet_chr1_hungryresponse5",
      "value": "Вам стоит скоро этим заняться."
    },

    {
      "key": "dialogue_velvet_chr1_thirstyresponse1",
      "value": "Вы же исследовательница, не так ли? Идите попейте из лужи снаружи."
    },
    {
      "key": "dialogue_velvet_chr1_thirstyresponse2",
      "value": "У меня может найтись что-то питьевое на обмен. Если нет — придётся справляться самой."
    },

    {
      "key": "dialogue_velvet_chr1_sadresponse1",
      "value": "Ваш моральный дух, кажется, снижен."
    },
    {
      "key": "dialogue_velvet_chr1_sadresponse2",
      "value": "Это место оказывает подобный эффект."
    },
    {
      "key": "dialogue_velvet_chr1_sadresponse3",
      "value": "Отдых может помочь."
    },
    {
      "key": "dialogue_velvet_chr1_sadresponse4",
      "value": "Говорите, если это поможет вам стабилизироваться."
    },
    {
      "key": "dialogue_velvet_chr1_sadresponse5",
      "value": "Вы всё ещё функциональны. Сосредоточьтесь на этом."
    },

    {
      "key": "dialogue_velvet_chr1_depressedresponse1",
      "value": "Вы меня беспокоите."
    },
    {
      "key": "dialogue_velvet_chr1_depressedresponse2",
      "value": "Вам нужно стабилизировать своё настроение. Мне не нравится видеть вас такой."
    },
    {
      "key": "dialogue_velvet_chr1_depressedresponse3",
      "value": "Найдите что-то простое, на чём можно сосредоточиться."
    },

    {
      "key": "dialogue_velvet_chr1_selfharmresponse1",
      "value": "...Я-... О боже мой..."
    },

    {
      "key": "dialogue_velvet_chr1_braindamagedresponse1",
      "value": "Вы говорите совершенно бессвязно."
    },
    {
      "key": "dialogue_velvet_chr1_braindamagedresponse2",
      "value": "Готов поспорить, у вас сотрясение мозга."
    },

    {
      "key": "dialogue_velvet_chr1_hotresponse1",
      "value": "Я, пожалуй, разрешу вам воспользоваться охладителем этой спасательной капсулы, если будете вести себя подобающе."
    },
    {
      "key": "dialogue_velvet_chr1_hotresponse2",
      "value": "Настройте температуру по своему вкусу."
    },
    {
      "key": "dialogue_velvet_chr1_hotresponse3",
      "value": "У нас есть охладитель."
    },
    {
      "key": "dialogue_velvet_chr1_hotresponse4",
      "value": "Можете воспользоваться охладителем."
    },

    {
      "key": "dialogue_velvet_chr1_coldresponse1",
      "value": "Здесь довольно холодно. Прибавьте отопление, пожалуйста."
    },
    {
      "key": "dialogue_velvet_chr1_coldresponse2",
      "value": "Не могли бы вы настроить температуру?"
    },
    {
      "key": "dialogue_velvet_chr1_coldresponse3",
      "value": "В этой капсуле есть обогреватель. Включите его, пожалуйста."
    },

    {
      "key": "dialogue_velvet_chr1_bleedingresponse1",
      "value": "Прошу, не испачкайте меня кровью."
    },
    {
      "key": "dialogue_velvet_chr1_bleedingresponse2",
      "value": "Прижмите рану."
    },
    {
      "key": "dialogue_velvet_chr1_bleedingresponse3",
      "value": "Я настоятельно прошу вас позаботиться о своих ранах."
    },

    {
      "key": "dialogue_velvet_chr1_painresponse1",
      "value": "Боль здесь неизбежна. Крепитесь."
    },
    {
      "key": "dialogue_velvet_chr1_painresponse2",
      "value": "Примите обезболивающее. Уж наверняка оно у вас есть..."
    },

    {
      "key": "dialogue_velvet_chr1_dirtyresponse1",
      "value": "В капсуле есть душ. Я бы предпочёл, чтобы вы им воспользовались, а не сидели рядом со мной, пахнущая... вот так."
    },

    {
      "key": "dialogue_velvet_chr1_encumberedresponse1",
      "value": "Ну и дразнитесь же вы."
    },
    {
      "key": "dialogue_velvet_chr1_encumberedresponse2",
      "value": "Обменяйте то, что вам не нужно."
    },

    {
      "key": "dialogue_velvet_chr1_dyingresponse1",
      "value": "..."
    },

    {
      "key": "dialogue_velvet_chr2_tradermeetnormal1",
      "value": "Ммм... Но-вый др-уг..."
    },
    {
      "key": "dialogue_velvet_chr2_tradermeetnormal2",
      "value": "При-вет... Мно-го-ногий др-уг..."
    },
    {
      "key": "dialogue_velvet_chr2_tradermeetnormal3",
      "value": "Дюна не зна-ет др-уга... Др-уг стра-нный..."
    },
    {
      "key": "dialogue_velvet_chr2_tradermeetnormal4",
      "value": "Др-уг пах-нет... Стра-нно..."
    },
    {
      "key": "dialogue_velvet_chr2_tradermeetnormal5",
      "value": "Добро-пожа-ловать... Выс-окий паук др-уг..."
    },
    {
      "key": "dialogue_velvet_chr2_tradermeetnormal6",
      "value": "Дюна видит мно-го лап... Хоро-шие лапы..."
    },
    {
      "key": "dialogue_velvet_chr2_tradermeetnormal7",
      "value": "Но-вый др-уг приш-ел ме-нять..."
    },
    {
      "key": "dialogue_velvet_chr2_tradermeetnormal8",
      "value": "Др-уг не Дюна... Не Экс-пи... Что за др-уг?"
    },
    {
      "key": "dialogue_velvet_chr2_tradermeetnormal9",
      "value": "Мм-мх... Др-уг доб-рый?"
    },
    {
      "key": "dialogue_velvet_chr2_tradermeetnormal10",
      "value": "Дюна смо-трит на др-уга..."
    },

    {
      "key": "dialogue_velvet_chr2_tradermeetgood1",
      "value": "Хоро-ший др-уг! Захо-ди!"
    },
    {
      "key": "dialogue_velvet_chr2_tradermeetgood2",
      "value": "Дюне нра-вится мяг-кий голос др-уга..."
    },
    {
      "key": "dialogue_velvet_chr2_tradermeetgood3",
      "value": "Др-уг хоро-ший... Дюна разре-шает!"
    },
    {
      "key": "dialogue_velvet_chr2_tradermeetgood4",
      "value": "Мно-го-ногий др-уг — хоро-ший др-уг!"
    },
    {
      "key": "dialogue_velvet_chr2_tradermeetgood5",
      "value": "Др-уг в безо-пасности здесь..."
    },
    {
      "key": "dialogue_velvet_chr2_tradermeetgood6",
      "value": "Дюна рад видеть др-уга!"
    },
    {
      "key": "dialogue_velvet_chr2_tradermeetgood7",
      "value": "Др-уг принес обмен? Хоро-шо!"
    },
    {
      "key": "dialogue_velvet_chr2_tradermeetgood8",
      "value": "Дюна не куса-ет доб-рого др-уга... Разве что др-уг захо-чет."
    },
    {
      "key": "dialogue_velvet_chr2_tradermeetgood9",
      "value": "Др-уг доб-рый... Дюне нра-вится."
    },
    {
      "key": "dialogue_velvet_chr2_tradermeetgood10",
      "value": "Подой-ди ближе... Обме-няем вещь..."
    },

    {
