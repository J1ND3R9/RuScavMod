    {
      "key": "dialogue_velvet_traderthreatensuccess5",
      "value": "J-just... please don't come any closer."
    },
    {
      "key": "dialogue_velvet_traderthreatensuccess6",
      "value": "Okay. Okay. I'm backing down. Please take something and leave..."
