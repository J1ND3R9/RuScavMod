    {
      "key": "dialogue_baron_traderhugfail3",
      "value": "Не трогать."
    },
    {
      "key": "dialogue_baron_traderhugfail4",
      "value": "Я тебя не так хорошо знаю."
    },
    {
      "key": "dialogue_baron_traderhugfail5",
      "value": "Отойди немного!"
    },
    {
      "key": "dialogue_baron_traderhugfail6",
      "value": "Может, в другой раз."
    },
    {
      "key": "dialogue_baron_traderhugfail7",
      "value": "Пожалуйста, держи руки при себе."
