    {
      "key": "dialogue_baron_tradercombat1",
      "value": "С меня достаточно."
    },
    {
      "key": "dialogue_baron_tradercombat2",
      "value": "Иди НАХУЙ!"
    },
    {
      "key": "dialogue_baron_tradercombat3",
      "value": "Я УСТАЛ ОТ ТЕБЯ!"
    },
    {
      "key": "dialogue_baron_tradercombat4",
      "value": "ИДИ НАХУЙ!"
    },
    {
      "key": "dialogue_baron_tradercombat5",
      "value": "ВЫХОД! УХОДИ! СЕЙЧАС! УШЕЛ!"
