    {
      "key": "dialogue_orange_eatBad19",
      "value": "Меня сейчас вырвет..."
    },
    {
      "key": "dialogue_orange_eatBad20",
      "value": "На вкус было ОТВРАТИТЕЛЬНО!"
    },
    {
      "key": "dialogue_orange_eatBad21",
      "value": "Вон из моего рта! Блееех!"
    },
    {
      "key": "dialogue_orange_eatBad22",
      "value": "Воняет!"
    },
    {
      "key": "dialogue_orange_eatBad23",
      "value": "Фуууу!!"
    },
    {
      "key": "dialogue_orange_eatBad24",
      "value": "Гадость!!!"
    },
    {
      "key": "dialogue_orange_eatBad25",
      "value": "На вкус будто протухло!"
    },
    {
      "key": "dialogue_orange_eatBad26",
      "value": "ТЕРПЕТЬ это не могу!"
    },
    {
      "key": "dialogue_orange_eatBad27",
      "value": "Это отвратительно..."
