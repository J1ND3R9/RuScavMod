    {
      "key": "dialogue_velvet_chr2_traderhugfail2",
      "value": "Нгхгрр! Нет! Про-чь!"
    },
    {
      "key": "dialogue_velvet_chr2_traderhugfail3",
      "value": "Нет! Дю-на не да-ст..."
    },
    {
      "key": "dialogue_velvet_chr2_traderhugfail4",
      "value": "Дю-не не нра-вится др-уг бли-зко..."
    },
    {
      "key": "dialogue_velvet_chr2_traderhugfail5",
      "value": "Грр! Нет! Нгхр..."
    },
    {
      "key": "dialogue_velvet_chr2_traderhugfail6",
      "value": "Др-уг не подхо-ди! Грр... Дю-не не нра-вится..."
    },

    {
      "key": "dialogue_velvet_chr2_traderseegun1",
      "value": "Что др-уг де-ржит..? Сто-й!"
    },
    {
      "key": "dialogue_velvet_chr2_traderseegun2",
      "value": "Дю-не не удо-бно с бум-палкой..."
    },
    {
      "key": "dialogue_velvet_chr2_traderseegun3",
      "value": "Н-нет... Дю-на бои-тся... гро-мкий пруток..."
    },
    {
      "key": "dialogue_velvet_chr2_traderseegun4",
      "value": "Др-уг... Дю-на боит-ся тебя... Гро-мкая па-лка..."
    },
    {
      "key": "dialogue_velvet_chr2_traderseegun5",
      "value": "Заче-м др-уг де-ржит... шту-ку бо-ли?..."
    },
    {
      "key": "dialogue_velvet_chr2_traderseegun6",
      "value": "Дю-на... Бои-тся мгно-венно... Бо-льной шту-ки..."
    },
    {
      "key": "dialogue_velvet_chr2_traderseegun7",
      "value": "Заче-м др-уг де-ржит... Клик-бум... Дю-на... Не лю-бит..."
    },
    {
      "key": "dialogue_velvet_chr2_traderseegun8",
      "value": "Дю-на бои-тся... Пиф-паф?... Боль... Не хо-чет..."
    },
    {
      "key": "dialogue_velvet_chr2_traderseegun9",
      "value": "Не-честный бо-ец... Дю-на... Не лю-бит... Ору-жие..."
    },

    {
      "key": "dialogue_velvet_chr2_tradermeetimpairedspeech1",
      "value": "Дю-на не пони-мает... Гово-ри лу-чше! Др-уг говорит пло-хо..."
    },
    {
      "key": "dialogue_velvet_chr2_tradermeetimpairedspeech2",
      "value": "Что др-уг гово-рит..? Голос при-глушен..."
    },
    {
      "key": "dialogue_velvet_chr2_tradermeetimpairedspeech3",
      "value": "Дю-на говор-ит пло-хо... Др-уг говор-ит пло-хо... Пло-хо пло-хо!..."
    },
    {
      "key": "dialogue_velvet_chr2_tradermeetimpairedspeech4",
      "value": "Дю-не сло-жно гово-рить... Др-уг говор-ит... пло-хо..."
    },
    {
      "key": "dialogue_velvet_chr2_tradermeetimpairedspeech5",
      "value": "Дю-на не пони-мает... Тебя..."
    },
    {
      "key": "dialogue_velvet_chr2_tradermeetimpairedspeech6",
      "value": "Дю-не тру-дно слыш-ать др-уга!"
    },

    {
      "key": "dialogue_velvet_chr2_traderseehurt1",
      "value": "Др-угу боль-но... Нггххгрр... Бе-ри шту-ку-лека-рство... Беспла-тно..."
    },
    {
      "key": "dialogue_velvet_chr2_traderseehurt2",
      "value": "Поче-му боль-но?.. Дю-на мо-жет... да-ть жи-знь-шту-ку... Беспла-тно..."
    },
    {
      "key": "dialogue_velvet_chr2_traderseehurt3",
      "value": "Др-уг постр-ада-л... Дю-на да-ет шту-ку-помо-щь... Беспла-тно..."
    },
    {
      "key": "dialogue_velvet_chr2_traderseehurt4",
      "value": "Те-ло др-уга пло-хо... Дю-на мо-жет пода-рить по-мощь..."
    },
    {
      "key": "dialogue_velvet_chr2_traderseehurt5",
      "value": "Др-уг чувс-твует боль... Дю-на да-рит по-мощь..."
    },

    {
      "key": "dialogue_velvet_chr2_traderlightbreak1",
      "value": "ННГГРРХХ! Поче-му др-уг кра-дет! Ухо-ди! Ггррхххххх... ПЛО-ХОЙ..!"
    },
    {
      "key": "dialogue_velvet_chr2_traderlightbreak2",
      "value": "ГРРР! ЗЛО! ВОН ОТСЮ-ДА!"
    },
    {
      "key": "dialogue_velvet_chr2_traderlightbreak3",
      "value": "ПЛО-ХОЙ! Гррр... Др-уг пло-хой... Пло-хой! Ухо-ди!"
    },
    {
      "key": "dialogue_velvet_chr2_traderlightbreak4",
      "value": "Дю-на НЕ ВИ-ДИТ! ПЛО-ХОЙ ДР-УГ! ПРО-ЧЬ ОТСЮ-ДА... ПР-ОЧЬ!"
