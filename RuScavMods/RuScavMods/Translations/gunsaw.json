    {
      "key": "dialogue_voyager_item_titaniummachete_3",
      "value": "Top of the line. Nice..."
    },
    {
      "key": "dialogue_voyager_item_titaniummachete_4",
      "value": "This is EXACTLY what I needed!"
    },

    {
      "key": "dialogue_voyager_item_boots_1",
      "value": "Nice. I like these."
