    {
      "key": "dialogue_velvet_traderwarning3",
      "value": "I don't trust you anymore."
    },
    {
      "key": "dialogue_velvet_traderwarning4",
      "value": "Back the fuck away."
    },
    {
      "key": "dialogue_velvet_traderwarning5",
      "value": "You need to go. Right fucking now."
