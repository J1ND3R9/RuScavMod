    {
      "key": "dialogue_velvet_traderbuyfail5",
      "value": "A few more things, please."
    },
    {
      "key": "dialogue_velvet_traderbuyfail6",
      "value": "No deal yet."
    },
    {
      "key": "dialogue_velvet_traderbuyfail7",
      "value": "That's not enough value."
    },
    {
      "key": "dialogue_velvet_traderbuyfail8",
      "value": "I need something better."
