      "key": "dialogue_voyager_item_rippeddressing_refuse_2",
      "value": "Absolutely not. Find something else."
    },
    {
      "key": "dialogue_voyager_item_rippeddressing_refuse_3",
      "value": "That's not touching my skin."
    },
    {
      "key": "dialogue_voyager_item_rippeddressing_refuse_4",
      "value": "I have SOME dignity left."
