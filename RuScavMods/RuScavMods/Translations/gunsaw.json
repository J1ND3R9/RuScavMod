    {
      "key": "dialogue_velvet_traderhugfail7",
      "value": "No, no. Back up a little."
    },
    {
      "key": "dialogue_velvet_traderhugfail8",
      "value": "I'm not comfortable with that."
    },
    {
      "key": "dialogue_velvet_traderhugfail9",
      "value": "Please don't wrap around me like that."
    },
    {
      "key": "dialogue_velvet_traderhugfail10",
      "value": "I said no touching."
    },

    {
      "key": "dialogue_velvet_traderhagglesuccess1",
      "value": "Alright, sure."
    },
    {
      "key": "dialogue_velvet_traderhagglesuccess2",
      "value": "Okay. You asked nicely."
    },
    {
      "key": "dialogue_velvet_traderhagglesuccess3",
      "value": "You know what? Fine."
    },
    {
      "key": "dialogue_velvet_traderhagglesuccess4",
      "value": "I'll make that trade."
    },
    {
      "key": "dialogue_velvet_traderhagglesuccess5",
      "value": "Yeah, that sounds fair enough."
    },
    {
      "key": "dialogue_velvet_traderhagglesuccess6",
      "value": "You make it hard to say no."
    },
    {
      "key": "dialogue_velvet_traderhagglesuccess7",
      "value": "Fine. Just this once."
    },
    {
      "key": "dialogue_velvet_traderhagglesuccess8",
      "value": "I can work with that."
    },
    {
      "key": "dialogue_velvet_traderhagglesuccess9",
      "value": "Alright. Deal."
    },
    {
      "key": "dialogue_velvet_traderhagglesuccess10",
      "value": "You're polite, so... sure."
    },

    {
      "key": "dialogue_velvet_traderhagglefail1",
      "value": "No thanks."
    },
    {
      "key": "dialogue_velvet_traderhagglefail2",
      "value": "I don't think that's fair."
    },
    {
      "key": "dialogue_velvet_traderhagglefail3",
      "value": "Sorry, but no."
    },
    {
      "key": "dialogue_velvet_traderhagglefail4",
      "value": "I'm not convinced."
    },
    {
      "key": "dialogue_velvet_traderhagglefail5",
      "value": "That doesn't really help me."
    },
    {
      "key": "dialogue_velvet_traderhagglefail6",
      "value": "I still need more than that."
    },
    {
      "key": "dialogue_velvet_traderhagglefail7",
      "value": "No deal."
    },
    {
      "key": "dialogue_velvet_traderhagglefail8",
      "value": "Maybe another trade."
    },
    {
      "key": "dialogue_velvet_traderhagglefail9",
      "value": "I can't give it away that easily."
    },
    {
      "key": "dialogue_velvet_traderhagglefail10",
      "value": "You sound sweet, but no."
    },

    {
      "key": "dialogue_velvet_traderdepressed1",
      "value": "...Hey... Uhm... Please don't look at me like that."
    },
    {
      "key": "dialogue_velvet_traderdepressed2",
      "value": "...You look really still. Like, scary still."
    },
    {
      "key": "dialogue_velvet_traderdepressed3",
      "value": "...Hello? You're staring through me."
    },
    {
      "key": "dialogue_velvet_traderdepressed4",
      "value": "...Uhm... Are you hungry? Sad? Both?"
    },
    {
      "key": "dialogue_velvet_traderdepressed5",
      "value": "...H-hello..?"
    },
    {
      "key": "dialogue_velvet_traderdepressed6",
      "value": "...I don't like that look in your eyes."
    },
    {
      "key": "dialogue_velvet_traderdepressed7",
      "value": "...D-... Do you need food? I might have food..."
