    {
      "key": "dialogue_velvet_traderlightbreak2",
      "value": "That was my light!"
    },
    {
      "key": "dialogue_velvet_traderlightbreak3",
      "value": "Why the fuck would you break that?"
    },
    {
      "key": "dialogue_velvet_traderlightbreak4",
      "value": "No, I'm not fucking doing this. Get out. Seriously."
    },
    {
      "key": "dialogue_velvet_traderlightbreak5",
      "value": "Fuck you, leave. I needed that light."
