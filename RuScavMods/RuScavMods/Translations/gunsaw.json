    },
    {
      "key": "dialogue_milky_hitbycreature2",
      "value": "БЛЯЯЯЯЯ!!! УЙДИ НАХУЙ!"
    },
    {
      "key": "dialogue_milky_hitbycreature3",
      "value": "УЙДИ ОТ МЕНЯ! ААААА!"
