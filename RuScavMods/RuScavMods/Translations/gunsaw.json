    {
      "key": "dialogue_voyager_cloak_radblocked_3",
      "value": "Только не сейчас! Не СЕЙЧАС!"
    },
    {
      "key": "dialogue_voyager_cloak_radblocked_4",
      "value": "...Ничего. Ничего не работает. Тогда бежать. Просто бежать."
