    {
      "key": "dialogue_voyager_wet1",
      "value": "Filthy water. Get it off."
    },
    {
      "key": "dialogue_voyager_wet2",
      "value": "I hate this. I hate all of this."
    },
    {
      "key": "dialogue_voyager_wet3",
      "value": "Soaked. Disgusting."
    },
    {
      "key": "dialogue_voyager_wet4",
      "value": "Ugh. I can feel it in my fur."
    },
    {
      "key": "dialogue_voyager_wet5",
      "value": "This is beneath me. All of it."
    },
    {
      "key": "dialogue_voyager_wet6",
      "value": "Wet. Cold. Miserable."
    },
    {
      "key": "dialogue_voyager_wet7",
      "value": "I loathe getting wet."
    },
    {
      "key": "dialogue_voyager_wet8",
      "value": "Absolutely soaked. Wonderful."
    },
    {
      "key": "dialogue_voyager_wet9",
      "value": "I need to get dry. Now."
    },

    {
      "key": "dialogue_voyager_cloak_wetblocked_1",
      "value": "It won't hold. Not like this."
    },
    {
      "key": "dialogue_voyager_cloak_wetblocked_2",
      "value": "Soaked. Of course it won't work."
    },
    {
      "key": "dialogue_voyager_cloak_wetblocked_3",
      "value": "Fucking water. Ruins everything."
    },

    {
      "key": "dialogue_voyager_wetcloak_1",
      "value": "I hate this. I hate water."
    },
    {
      "key": "dialogue_voyager_wetcloak_2",
      "value": "Get it off me. Get it OFF."
    },
    {
      "key": "dialogue_voyager_wetcloak_3",
      "value": "Every part of me hates this."
    },

    {
      "key": "dialogue_voyager_cloak_fail_1",
      "value": "Fuck-! Piece of..."
    },
    {
      "key": "dialogue_voyager_cloak_fail_2",
      "value": "Damnit. Right now?"
    },
    {
      "key": "dialogue_voyager_cloak_fail_3",
      "value": "Shit. Cloak is out."
    },
    {
      "key": "dialogue_voyager_cloak_fail_4",
      "value": "Cloak's out. Gotta move."
    },
    {
      "key": "dialogue_voyager_cloak_fail_5",
      "value": "No more hiding now..."
    },

    {
      "key": "dialogue_voyager_rad_low_1",
      "value": "Radiation. Can't stay here for long."
    },
    {
      "key": "dialogue_voyager_rad_low_2",
      "value": "What..? Ah. Radiation. Gotta move."
    },
    {
      "key": "dialogue_voyager_rad_low_3",
      "value": "Cloak won't hold if this gets worse."
    },
    {
      "key": "dialogue_voyager_rad_low_4",
      "value": "Radiation. Not good for the cloak."
    },
    {
      "key": "dialogue_voyager_rad_low_5",
      "value": "Cloak is flickering. Radiation. I have to move."
    },

    {
      "key": "dialogue_voyager_rad_mid_1",
      "value": "Shit-! I have to get out of here now!"
    },
    {
      "key": "dialogue_voyager_rad_mid_2",
      "value": "This is getting worse. I need to fucking move!"
    },
    {
      "key": "dialogue_voyager_rad_mid_3",
      "value": "Cloak isn't going to hold much longer-!"
    },
    {
      "key": "dialogue_voyager_rad_mid_4",
      "value": "Fuck! This radiation is getting worse!"
    },
    {
      "key": "dialogue_voyager_rad_mid_5",
      "value": "I can't fucking stay here! Cloak is going to collapse at any moment!"
    },

    {
      "key": "dialogue_voyager_rad_high_1",
      "value": "Fuck! I need to get out, now!"
    },
    {
      "key": "dialogue_voyager_rad_high_2",
      "value": "This is bad! This is really fucking bad!"
    },
    {
      "key": "dialogue_voyager_rad_high_3",
      "value": "Move! MOVE, damn it!!"
    },
    {
      "key": "dialogue_voyager_rad_high_4",
      "value": "Cloak's cooking itself alive! I need to go!"
    },
    {
      "key": "dialogue_voyager_rad_high_5",
      "value": "This is NOT fucking happening to me!!"
    },

    {
      "key": "dialogue_voyager_rad_highoff_1",
      "value": "FUUUUCCKKK!!!"
    },
    {
      "key": "dialogue_voyager_rad_highoff_2",
      "value": "IT'S GONE! IT'S ACTUALLY GONE!"
    },
    {
      "key": "dialogue_voyager_rad_highoff_3",
      "value": "NOT NOW! NOT NOW OF ALL TIMES!"
    },
    {
      "key": "dialogue_voyager_rad_highoff_4",
      "value": "...Okay. Okay okay okay. Just run! Just fucking run!!!"
    },
    {
      "key": "dialogue_voyager_rad_highoff_5",
      "value": "FUCK! FUCKING-! THE CLOAK!"
    },

    {
      "key": "dialogue_voyager_cloak_missing_1",
      "value": "Where the hell is my-?"
    },
    {
      "key": "dialogue_voyager_cloak_missing_2",
      "value": "No. No, I had it. I ALWAYS have it."
    },
    {
      "key": "dialogue_voyager_cloak_missing_3",
      "value": "Someone's going to pay for this."
    },
    {
      "key": "dialogue_voyager_cloak_missing_4",
      "value": "Unbelievable. Un-fucking-believable."
    },
    {
      "key": "dialogue_voyager_cloak_missing_5",
      "value": "...Fine. I'll manage. I always manage."
    },

    {
      "key": "dialogue_voyager_cloak_dead_1",
      "value": "Damnit. Out of charge."
    },
    {
      "key": "dialogue_voyager_cloak_dead_2",
      "value": "Of course. Of fucking course."
    },
    {
      "key": "dialogue_voyager_cloak_dead_3",
      "value": "Cheap garbage. Figures."
    },
    {
      "key": "dialogue_voyager_cloak_dead_4",
      "value": "Great. Perfect timing. Perfect."
    },
    {
      "key": "dialogue_voyager_cloak_dead_5",
      "value": "...Recharge already."
    },

    {
      "key": "dialogue_voyager_cloak_radblocked_1",
      "value": "Fuck Fuck Fuck! Turn on, fucker!!"
    },
    {
      "key": "dialogue_voyager_cloak_radblocked_2",
      "value": "Come ON! Work, you piece of shit!"
    },
    {
      "key": "dialogue_voyager_cloak_radblocked_3",
      "value": "Not now! Not NOW!"
    },
    {
      "key": "dialogue_voyager_cloak_radblocked_4",
      "value": "...Nothing. Nothing's working. Move, then. Just move."
    },
    {
      "key": "dialogue_voyager_cloak_radblocked_5",
      "value": "Fucking- Just- TURN ON!!!"
    },

    {
      "key": "dialogue_voyager_item_pistol_1",
      "value": "This is what I'm talking about."
    },
    {
      "key": "dialogue_voyager_item_pistol_2",
      "value": "Now THIS has some class to it."
    },
    {
      "key": "dialogue_voyager_item_pistol_3",
      "value": "See? This is how it's done."
    },
    {
      "key": "dialogue_voyager_item_pistol_4",
      "value": "Finally. Something worth carrying."
    },

    {
      "key": "dialogue_voyager_item_machete_1",
      "value": "Hah! Nice and sharp."
    },
    {
      "key": "dialogue_voyager_item_machete_2",
      "value": "Fuck yeah."
    },
    {
      "key": "dialogue_voyager_item_machete_3",
      "value": "Oh... This will be useful."
    },
    {
      "key": "dialogue_voyager_item_machete_4",
      "value": "Actual metal! Unlike those crude things the others make..."
