    {
      "key": "dialogue_orange_chr2_selfharmresponse1",
      "value": "Почему др-уг обижен? Др-уг злой?"
    },

    {
      "key": "dialogue_orange_chr2_braindamagedresponse1",
      "value": "Дю-на согласна."
    },
    {
      "key": "dialogue_orange_chr2_braindamagedresponse2",
      "value": ".........?"
    },

    {
      "key": "dialogue_orange_chr2_hotresponse1",
      "value": "Дю-ны никогда не бывают жаркими! Дю-ны любят жару..."
    },

    {
      "key": "dialogue_orange_chr2_coldresponse1",
      "value": "Дю-на боится хол-ода... В комнате тепло! Др-уг останется с Дюном..."
    },

    {
      "key": "dialogue_orange_chr2_bleedingresponse1",
      "value": "Др-уг ранен. Дру-гу нужна помощь!"
    },
    {
      "key": "dialogue_orange_chr2_bleedingresponse2",
      "value": "От дру-га пахнет кровью. Дю-не нравится."
    },

    {
      "key": "dialogue_orange_chr2_painresponse1",
      "value": "Др-угу больно..?"
    },
    {
      "key": "dialogue_orange_chr2_painresponse2",
      "value": "Дю-на пон-нимает... Дю-не тоже больно! Др-уг в порядке?"
    },

    {
      "key": "dialogue_orange_chr2_dirtyresponse1",
      "value": "Что такое гр-язно?"
    },

    {
      "key": "dialogue_orange_chr2_encumberedresponse1",
      "value": "Можно взять вещи др-уг?"
    },
    {
      "key": "dialogue_orange_chr2_encumberedresponse2",
      "value": "Дю-на поможет с нагруз-кой!"
    },

    {
      "key": "dialogue_orange_chr2_dyingresponse1",
      "value": "Что не так с др-угом..?"
    },
    {
      "key": "dialogue_orange_chr2_dyingresponse2",
      "value": "Дю-на не знает как помочь..."
    },

    {
      "key": "dialogue_voyager_seeGravel1",
      "value": "...Пещера. Ну конечно, пещера."
    },
    {
      "key": "dialogue_voyager_seeGravel2",
      "value": "И вот ради этого сюда отправляют Вояджера?"
    },
    {
      "key": "dialogue_voyager_seeGravel3",
      "value": "Ладно. Извлеку максимум из этого оскорбления."
    },
    {
      "key": "dialogue_voyager_seeGravel4",
      "value": "Кто-то ответит за такое распределение."
    },
    {
      "key": "dialogue_voyager_seeGravel5",
      "value": "Уж я-то приспособлен к этому лучше, чем любой из остальных."
    },
    {
      "key": "dialogue_voyager_seeGravel6",
      "value": "Сначала найти укрытие. Думать потом."
    },
    {
      "key": "dialogue_voyager_seeGravel7",
      "value": "...Никто не видел, как я приземлился. Хорошо."
    },
    {
      "key": "dialogue_voyager_seeGravel8",
      "value": "Я не собираюсь выживать кое-как, как какой-то Экспи."
    },
    {
      "key": "dialogue_voyager_seeGravel9",
      "value": "Это место построили не они. И так очевидно."
    },
    {
      "key": "dialogue_voyager_seeGravel10",
      "value": "Ладно. Я это переживу. Я всегда переживаю."
    },
    {
      "key": "dialogue_voyager_seeGravel11",
      "value": "...Камень и пыль. Очаровательно."
    },
    {
      "key": "dialogue_voyager_seeGravel12",
      "value": "Я отказываюсь умирать в таком уродливом месте."
    },
    {
      "key": "dialogue_voyager_seeGravel13",
      "value": "Оставаться незамеченным. Оставаться живым. Больше от меня ничего не требуется."
    },

    {
      "key": "dialogue_voyager_eatGood1",
      "value": "Вот это уже приемлемо."
    },
    {
      "key": "dialogue_voyager_eatGood2",
      "value": "Наконец-то, нормальная, блять, еда."
    },
    {
      "key": "dialogue_voyager_eatGood3",
      "value": "К этому я мог бы привыкнуть."
    },
    {
      "key": "dialogue_voyager_eatGood4",
      "value": "Это почти по-цивилизованному."
    },
    {
      "key": "dialogue_voyager_eatGood5",
      "value": "...Неплохо. Совсем неплохо."
    },
    {
      "key": "dialogue_voyager_eatGood6",
      "value": "Вот как это должно быть."
    },
    {
      "key": "dialogue_voyager_eatGood7",
      "value": "Видишь? У некоторых вещей здесь есть стандарты."
    },
    {
      "key": "dialogue_voyager_eatGood8",
      "value": "Запомню, где я это нашёл."
    },
    {
      "key": "dialogue_voyager_eatGood9",
      "value": "Хоть что-то на этой планете сделали правильно."
    },

    {
      "key": "dialogue_voyager_eatMediocre1",
      "value": "Сойдёт. Едва."
    },
    {
      "key": "dialogue_voyager_eatMediocre2",
      "value": "Ел и получше. Ел и похуже."
    },
    {
      "key": "dialogue_voyager_eatMediocre3",
      "value": "Пока сгодится."
    },
    {
      "key": "dialogue_voyager_eatMediocre4",
      "value": "Пресно. Типично."
    },
    {
      "key": "dialogue_voyager_eatMediocre5",
      "value": "Не стоит и похвалы."
    },
    {
      "key": "dialogue_voyager_eatMediocre6",
      "value": "Честно говоря, ожидал худшего."
    },
    {
      "key": "dialogue_voyager_eatMediocre7",
      "value": "Забываемое. Уже забыл."
    },
    {
      "key": "dialogue_voyager_eatMediocre8",
      "value": "Приемлемо. Большего не заслуживает."
    },
    {
      "key": "dialogue_voyager_eatMediocre9",
      "value": "Ладно. Нормально."
    },

    {
      "key": "dialogue_voyager_eatBad1",
      "value": "Отвратительно. Совершенно отвратительно."
    },
    {
      "key": "dialogue_voyager_eatBad2",
      "value": "И что это, по идее, должно было быть?"
    },
    {
      "key": "dialogue_voyager_eatBad3",
      "value": "Стоило догадаться заранее."
    },
    {
      "key": "dialogue_voyager_eatBad4",
      "value": "Эта планета пытается убить меня одним лишь вкусом."
    },
    {
      "key": "dialogue_voyager_eatBad5",
      "value": "Мерзость. Абсолютная мерзость."
    },
    {
      "key": "dialogue_voyager_eatBad6",
      "value": "Меня сейчас стошнит. Прекрасно."
    },
    {
      "key": "dialogue_voyager_eatBad7",
      "value": "Больше никогда. НИКОГДА больше."
    },
    {
      "key": "dialogue_voyager_eatBad8",
      "value": "Это оскорбление самого понятия еды."
    },
    {
      "key": "dialogue_voyager_eatBad9",
      "value": "Лучше я останусь голодным, чем повторю это."
    },

    {
      "key": "dialogue_voyager_refuseEat1",
      "value": "Нет. У меня есть стандарты."
    },
    {
      "key": "dialogue_voyager_refuseEat2",
      "value": "Я ещё не настолько отчаялся."
    },
    {
      "key": "dialogue_voyager_refuseEat3",
      "value": "Это не еда. Это оскорбление."
    },
    {
      "key": "dialogue_voyager_refuseEat4",
      "value": "Я лучше умру с голоду, но с достоинством."
    },
    {
      "key": "dialogue_voyager_refuseEat5",
      "value": "Абсолютно точно не подойду к этому близко."
    },
    {
      "key": "dialogue_voyager_refuseEat6",
      "value": "Есть черты, которые я не пересекаю. Это одна из них."
    },
    {
      "key": "dialogue_voyager_refuseEat7",
      "value": "У меня есть пределы. Это за ними."
    },

    {
      "key": "dialogue_voyager_tired1",
      "value": "...Мне нужен отдых. Ладно."
    },
    {
      "key": "dialogue_voyager_tired2",
      "value": "В таком состоянии я не буду достаточно собран. Значит, сон."
    },
    {
      "key": "dialogue_voyager_tired3",
      "value": "Нужно скрыться. На открытом месте я спать не буду."
    },
    {
      "key": "dialogue_voyager_tired4",
      "value": "На сегодня хватит."
    },
    {
      "key": "dialogue_voyager_tired5",
      "value": "Мне нужно быть начеку. Сначала отдых."
    },
    {
      "key": "dialogue_voyager_tired6",
      "value": "Усталость — это слабость, которую я сейчас не могу себе позволить."
    },
    {
      "key": "dialogue_voyager_tired7",
      "value": "Где-нибудь безопасно. Где-нибудь незаметно."
    },
    {
      "key": "dialogue_voyager_tired8",
      "value": "Я замедляюсь. Недопустимо."
    },

    {
      "key": "dialogue_voyager_verytired1",
      "value": "Едва могу держать глаза открытыми..."
    },
    {
      "key": "dialogue_voyager_verytired2",
      "value": "Это унизительно. Мне нужно спать. Сейчас же."
    },
    {
      "key": "dialogue_voyager_verytired3",
      "value": "Концентрация ускользает... ненавижу это."
    },
    {
      "key": "dialogue_voyager_verytired4",
      "value": "Я не могу так продолжать..."
    },
    {
      "key": "dialogue_voyager_verytired5",
      "value": "Где угодно. На этом этапе сойдёт где угодно."
    },
    {
      "key": "dialogue_voyager_verytired6",
      "value": "Я не создан, чтобы это выдерживать. Никто не создан."
    },
    {
      "key": "dialogue_voyager_verytired7",
      "value": "Мне нужно лечь, пока я не рухнул сам."
    },

    {
      "key": "dialogue_voyager_confused1",
      "value": "...Что. Что случилось."
    },
    {
      "key": "dialogue_voyager_confused2",
      "value": "Соберись. Немедленно."
    },
    {
      "key": "dialogue_voyager_confused3",
      "value": "Сосредоточься. СОСРЕДОТОЧЬСЯ."
    },
    {
      "key": "dialogue_voyager_confused4",
      "value": "...Где. Где я."
    },
    {
      "key": "dialogue_voyager_confused5",
      "value": "Оставайся собранным. Не показывай этого."
    },
    {
      "key": "dialogue_voyager_confused6",
      "value": "...Так. Я в порядке. Я в порядке."
    },
    {
      "key": "dialogue_voyager_confused7",
      "value": "Моя голова... дайте секунду."
    },

    {
      "key": "dialogue_voyager_wakeup1",
      "value": "...Проснулся. Хорошо."
    },
    {
      "key": "dialogue_voyager_wakeup2",
      "value": "Ещё один такой день."
    },
    {
      "key": "dialogue_voyager_wakeup3",
      "value": "Собранность. Каждый день начинается с собранности."
    },
    {
      "key": "dialogue_voyager_wakeup4",
      "value": "Всё ещё жив. Всё ещё впереди остальных."
    },
    {
      "key": "dialogue_voyager_wakeup5",
      "value": "Так. Снова за дело."
    },
    {
      "key": "dialogue_voyager_wakeup6",
      "value": "Никто не видел, как я спал. Хорошо."
    },
    {
      "key": "dialogue_voyager_wakeup7",
      "value": "Собран. Сосредоточен. Как и подобает."
    },
    {
      "key": "dialogue_voyager_wakeup8",
      "value": "Ммн... *потягивается* -! То есть. Так. Встаю. Двигаюсь."
    },
    {
      "key": "dialogue_voyager_wakeup9",
      "value": "*зевок*... Никто этого не видел. Никто этого не видел."
    },

    {
      "key": "dialogue_voyager_sick1",
      "value": "...Что-то не так. Мой желудок."
    },
    {
      "key": "dialogue_voyager_sick2",
      "value": "Угх... только не сейчас. Не здесь."
    },
    {
      "key": "dialogue_voyager_sick3",
      "value": "Меня не тошнит. Меня не тошнит."
    },
    {
      "key": "dialogue_voyager_sick4",
      "value": "Что бы я там ни съел... не стоило оно того."
    },
    {
      "key": "dialogue_voyager_sick5",
      "value": "Живот скручивает. Прекрасно."
    },
    {
      "key": "dialogue_voyager_sick6",
      "value": "...Никто не смотрит. Хорошо."
    },
    {
      "key": "dialogue_voyager_sick7",
      "value": "Это унизительно."
    },
    {
      "key": "dialogue_voyager_sick8",
      "value": "Чувствую себя отвратительно."
    },

    {
      "key": "dialogue_voyager_verysick1",
      "value": "Я- я, кажется, сейчас правда сблюю..."
    },
    {
      "key": "dialogue_voyager_verysick2",
      "value": "Угх... чёрт... держи себя в руках..."
    },
    {
      "key": "dialogue_voyager_verysick3",
      "value": "Это настолько ниже моего достоинства..."
    },
    {
      "key": "dialogue_voyager_verysick4",
      "value": "Желудок никак не успокоится..."
    },
    {
      "key": "dialogue_voyager_verysick5",
      "value": "...Пожалуйста, пусть никто не пойдёт сюда."
    },
    {
      "key": "dialogue_voyager_verysick6",
      "value": "Не могу... не могу это удержать в себе..."
    },
    {
      "key": "dialogue_voyager_verysick7",
      "value": "Блять. Сука, ладно. Просто пусть будет что будет."
    },

    {
      "key": "dialogue_voyager_vomit1",
      "value": "...Ну вот."
    },
    {
      "key": "dialogue_voyager_vomit2",
      "value": "Отвратительно. Всё это."
    },
    {
      "key": "dialogue_voyager_vomit3",
      "value": "*кашляет*... никто этого не видел. Никто."
    },
    {
      "key": "dialogue_voyager_vomit4",
      "value": "Больше никогда это не съем."
    },
    {
      "key": "dialogue_voyager_vomit5",
      "value": "...Ладно. Лучше. Немного лучше."
    },
    {
      "key": "dialogue_voyager_vomit6",
      "value": "Угх. Соберись."
    },

    {
      "key": "dialogue_voyager_vomitblood1",
      "value": "...Это не- это кровь."
    },
    {
      "key": "dialogue_voyager_vomitblood2",
      "value": "Сука. Это и правда кровь."
    },
    {
      "key": "dialogue_voyager_vomitblood3",
      "value": "Этого... не должно происходить."
    },
    {
      "key": "dialogue_voyager_vomitblood4",
      "value": "Со мной действительно что-то не так."
    },
    {
      "key": "dialogue_voyager_vomitblood5",
      "value": "...Ладно. Ладно, это плохо. Мне нужно это исправить."
    },

    {
      "key": "dialogue_voyager_full1",
      "value": "Хватит. Я наелся."
    },
    {
      "key": "dialogue_voyager_full2",
      "value": "Я съел достаточно."
    },
    {
      "key": "dialogue_voyager_full3",
      "value": "Больше не нужно."
    },
    {
      "key": "dialogue_voyager_full4",
      "value": "Я удовлетворён."
    },
    {
      "key": "dialogue_voyager_full5",
      "value": "Этого мне хватит на какое-то время."
    },

    {
      "key": "dialogue_voyager_hungry1",
      "value": "Мне нужно что-нибудь съесть."
    },
    {
      "key": "dialogue_voyager_hungry2",
      "value": "Испытываю голод."
    },
    {
      "key": "dialogue_voyager_hungry3",
      "value": "Еда. Нужно её найти."
    },
    {
      "key": "dialogue_voyager_hungry4",
      "value": "Я бы поел."
    },
    {
      "key": "dialogue_voyager_hungry5",
      "value": "Пора найти что-нибудь съедобное."
    },

    {
      "key": "dialogue_voyager_starving1",
      "value": "Мне нужна еда. Сейчас же."
    },
    {
      "key": "dialogue_voyager_starving2",
      "value": "Я реально умираю с голоду."
    },
    {
      "key": "dialogue_voyager_starving3",
      "value": "Этот голод уже нельзя игнорировать."
    },
    {
      "key": "dialogue_voyager_starving4",
      "value": "Мне нужно поесть, иначе от меня не будет толку."
    },
    {
      "key": "dialogue_voyager_starving5",
      "value": "Найти еду — теперь приоритет."
    },

    {
      "key": "dialogue_voyager_thirsty1",
      "value": "Мне нужно что-нибудь выпить."
    },
    {
      "key": "dialogue_voyager_thirsty2",
      "value": "Хочу пить."
    },
    {
      "key": "dialogue_voyager_thirsty3",
      "value": "Во рту пересохло."
    },
    {
      "key": "dialogue_voyager_thirsty4",
      "value": "Не помешала бы вода."
    },
    {
      "key": "dialogue_voyager_thirsty5",
      "value": "Вода. Нужно её найти."
    },

    {
      "key": "dialogue_voyager_dehydrated1",
      "value": "Мне действительно нужна вода. Сейчас же."
    },
    {
      "key": "dialogue_voyager_dehydrated2",
      "value": "У меня серьёзное обезвоживание."
    },
    {
      "key": "dialogue_voyager_dehydrated3",
      "value": "Мне нужна вода немедленно."
    },
    {
      "key": "dialogue_voyager_dehydrated4",
      "value": "Эта жажда становится опасной."
    },
    {
      "key": "dialogue_voyager_dehydrated5",
      "value": "Мне нужно найти воду. Сейчас же."
    },

    {
      "key": "dialogue_voyager_limbmuscle1",
      "value": "Моя <limb> работает неправильно."
    },
    {
      "key": "dialogue_voyager_limbmuscle2",
      "value": "Что-то не так с моей <limb:tvr>."
    },
    {
      "key": "dialogue_voyager_limbmuscle3",
      "value": "Моя <limb> перенапряжена."
    },
    {
      "key": "dialogue_voyager_limbmuscle4",
      "value": "Мне нужно проверить свою <limb:vin>."
    },
    {
      "key": "dialogue_voyager_limbmuscle5",
      "value": "Моей <limb:dat> больно при движении."
    },

    {
      "key": "dialogue_voyager_limbinfected1",
      "value": "С моей <limb:tvr> что-то не так. Она горячая."
    },
    {
      "key": "dialogue_voyager_limbinfected2",
      "value": "Моя <limb> заражена."
    },
    {
      "key": "dialogue_voyager_limbinfected3",
      "value": "Мне нужно продезинфицировать свою <limb:vin>."
    },
    {
      "key": "dialogue_voyager_limbinfected4",
      "value": "Моей <limb:dat> становится хуже. Нужно лечение."
    },
    {
      "key": "dialogue_voyager_limbinfected5",
      "value": "Это заражение в моей <limb:dat> само не пройдёт."
    },

    {
      "key": "dialogue_voyager_limbskin1",
      "value": "Моя <limb> ранена."
    },
    {
      "key": "dialogue_voyager_limbskin2",
      "value": "Мне нужно перевязать свою <limb:vin>."
    },
    {
      "key": "dialogue_voyager_limbskin3",
      "value": "Моя <limb> изранена."
    },
    {
      "key": "dialogue_voyager_limbskin4",
      "value": "Моей <limb:dat> требуется внимание."
    },
    {
      "key": "dialogue_voyager_limbskin5",
      "value": "Я не могу оставить свою <limb:vin> в таком состоянии."
    },

    {
      "key": "dialogue_voyager_bleeding1",
      "value": "У меня кровотечение."
    },
    {
      "key": "dialogue_voyager_bleeding2",
      "value": "Мне нужен бинт."
    },
    {
      "key": "dialogue_voyager_bleeding3",
      "value": "Я теряю кровь."
    },
    {
      "key": "dialogue_voyager_bleeding4",
      "value": "Это нужно обработать."
    },
    {
      "key": "dialogue_voyager_bleeding5",
      "value": "Я ранен. Нужно это исправить."
    },

    {
      "key": "dialogue_voyager_bleedingheavy1",
      "value": "Это... многовато крови."
    },
    {
      "key": "dialogue_voyager_bleedingheavy2",
      "value": "Это плохо. Мне нужно это остановить. Сейчас же."
    },
    {
      "key": "dialogue_voyager_bleedingheavy3",
      "value": "Блять- ладно, соберись. Бинт. Хоть что-нибудь."
    },
    {
      "key": "dialogue_voyager_bleedingheavy4",
      "value": "Я истекаю кровью. Мне нужно немедленно это исправить."
    },
    {
      "key": "dialogue_voyager_bleedingheavy5",
      "value": "Не паниковать. Не паниковать. Просто останови кровотечение."
    },

    {
      "key": "dialogue_voyager_pain1",
      "value": "Ай."
    },
    {
      "key": "dialogue_voyager_pain2",
      "value": "Моя <limb>..."
    },
    {
      "key": "dialogue_voyager_pain3",
      "value": "Больно."
    },
    {
      "key": "dialogue_voyager_pain4",
      "value": "Моя <limb> болит."
    },
    {
      "key": "dialogue_voyager_pain5",
      "value": "Мне больно."
    },
    {
      "key": "dialogue_voyager_pain6",
      "value": "Моя <limb> ноет."
    },
    {
      "key": "dialogue_voyager_pain7",
      "value": "Это не пустяк. Моя <limb> реально болит."
    },

    {
      "key": "dialogue_voyager_bigpain1",
      "value": "АГХ!"
    },
    {
      "key": "dialogue_voyager_bigpain2",
      "value": "БЛЯТЬ!"
    },
    {
      "key": "dialogue_voyager_bigpain3",
      "value": "МОЯ <limb>!"
    },
    {
      "key": "dialogue_voyager_bigpain4",
      "value": "Я в порядке! Я В ПОРЯДКЕ!"
    },
    {
      "key": "dialogue_voyager_bigpain5",
      "value": "Это пустяк. Это ПУСТЯК."
    },
    {
      "key": "dialogue_voyager_bigpain6",
      "value": "Это не- это не так уж плохо. Это не так уж плохо!"
    },
    {
      "key": "dialogue_voyager_bigpain7",
      "value": "ГАХ! Мне не нужна- мне не нужна помощь!"
    },
    {
      "key": "dialogue_voyager_bigpain8",
      "value": "Это тело никогда не было создано для такого!"
    },

    {
      "key": "dialogue_voyager_sad1",
      "value": "...Хм."
    },
    {
      "key": "dialogue_voyager_sad2",
      "value": "Это раздражает. Не более того."
    },
    {
      "key": "dialogue_voyager_sad3",
      "value": "У меня нет времени на этом зацикливаться."
    },
    {
      "key": "dialogue_voyager_sad4",
      "value": "Отбросить это. Продолжать движение."
    },
    {
      "key": "dialogue_voyager_sad5",
      "value": "Это ничего не значит. Я не вкладываю в это смысла."
    },
    {
      "key": "dialogue_voyager_sad6",
      "value": "Я переживал и похуже."
    },
    {
      "key": "dialogue_voyager_sad7",
      "value": "Соберись. Это на тебя не похоже."
    },
    {
      "key": "dialogue_voyager_sad8",
      "value": "...Тихо здесь. Слишком тихо."
    },
    {
      "key": "dialogue_voyager_sad9",
      "value": "Мне не нужна компания. Не нужна."
    },
    {
      "key": "dialogue_voyager_sad10",
      "value": "Сосредоточься. Это чувство бесполезно."
    },
    {
      "key": "dialogue_voyager_sad11",
      "value": "Я выше того, чтобы позволять этому влиять на себя."
    },
    {
      "key": "dialogue_voyager_sad12",
      "value": "...Ладно. Значит, одиноко. И что с того."
    },

    {
      "key": "dialogue_voyager_gloomy1",
      "value": "Это уже начинает надоедать."
    },
    {
      "key": "dialogue_voyager_gloomy2",
      "value": "Меня уже тошнит от этого."
    },
    {
      "key": "dialogue_voyager_gloomy3",
      "value": "Во всём этом нет ничего справедливого."
    },
    {
      "key": "dialogue_voyager_gloomy4",
      "value": "...Хватит. Этого должно быть достаточно."
    },
    {
      "key": "dialogue_voyager_gloomy5",
      "value": "Ненавижу это место. Ненавижу всё это."
    },
    {
      "key": "dialogue_voyager_gloomy6",
      "value": "Держи себя в руках. Просто держи себя в руках."
    },
    {
      "key": "dialogue_voyager_gloomy7",
      "value": "Мне не следует чувствовать себя так."
    },
    {
      "key": "dialogue_voyager_gloomy8",
      "value": "...Тут и правда только я, да."
    },
    {
      "key": "dialogue_voyager_gloomy9",
      "value": "Мне никто не нужен. Не нужен."
    },
    {
      "key": "dialogue_voyager_gloomy10",
      "value": "Неужели кому-то бы повредило просто... находиться рядом со мной хоть раз."
    },
    {
      "key": "dialogue_voyager_gloomy11",
      "value": "Эта собранность обходится мне дороже, чем того стоит."
    },
    {
      "key": "dialogue_voyager_gloomy12",
      "value": "Я устал. Не только физически."
    },
    {
      "key": "dialogue_voyager_gloomy13",
      "value": "Сколько ещё это должно продолжаться."
    },
    {
      "key": "dialogue_voyager_gloomy14",
      "value": "...Мне чего-то не хватает. Даже не знаю чего."
    },
    {
      "key": "dialogue_voyager_gloomy15",
      "value": "Всё это выматывает."
    },
    {
      "key": "dialogue_voyager_gloomy16",
      "value": "Я не дам позволить этому сломать меня. Просто не дам."
    },

    {
      "key": "dialogue_voyager_depressed1",
      "value": "...В чём вообще смысл всего этого."
    },
    {
      "key": "dialogue_voyager_depressed2",
      "value": "Я не могу больше так продолжать."
    },
    {
      "key": "dialogue_voyager_depressed3",
      "value": "Не знаю, сколько ещё сил во мне осталось."
    },
    {
      "key": "dialogue_voyager_depressed4",
      "value": "...Я не так силён, каким притворяюсь. Никогда не был."
    },
    {
      "key": "dialogue_voyager_depressed5",
      "value": "Никто не придёт. Никто никогда не придёт."
    },
    {
      "key": "dialogue_voyager_depressed6",
      "value": "Ненавижу это чувство. Ненавижу его."
    },
    {
      "key": "dialogue_voyager_depressed7",
      "value": "Продолжай. Ты должен продолжать."
    },
    {
      "key": "dialogue_voyager_depressed8",
      "value": "...Я не хочу быть один прямо сейчас."
    },
    {
      "key": "dialogue_voyager_depressed9",
      "value": "Всё, что я тут делаю, не имеет никакого смысла."
    },
    {
      "key": "dialogue_voyager_depressed10",
      "value": "Я боюсь себя."
    },
    {
      "key": "dialogue_voyager_depressed11",
      "value": "Нет. Не давай этому зайти так далеко. Не снова."
    },
    {
      "key": "dialogue_voyager_depressed12",
      "value": "Чувствую, как я срываюсь..."
    },
    {
      "key": "dialogue_voyager_depressed13",
      "value": "Я просто хочу, чтобы это прекратилось. Всё это."
    },
    {
      "key": "dialogue_voyager_depressed14",
      "value": "...Я больше не чувствую себя собой."
    },
    {
      "key": "dialogue_voyager_depressed15",
      "value": "Пожалуйста. Просто- просто дайте мне выдохнуть хоть секунду."
    },
    {
      "key": "dialogue_voyager_depressed16",
      "value": "Я не в порядке. Я давно не в порядке."
    },
    {
      "key": "dialogue_voyager_depressed17",
      "value": "Превосходство. Ну да. Вот это теперь звучит как шутка."
    },
    {
      "key": "dialogue_voyager_depressed18",
      "value": "Мне нужно продержаться. Ещё немного."
    },

    {
      "key": "dialogue_voyager_miserable1",
      "value": "Не могу. Я больше не могу этого выносить."
    },
    {
      "key": "dialogue_voyager_miserable2",
      "value": "Пусть это прекратится. Пожалуйста, просто пусть прекратится."
    },
    {
      "key": "dialogue_voyager_miserable3",
      "value": "Я схожу с ума. Я правда схожу с ума."
    },
    {
      "key": "dialogue_voyager_miserable4",
      "value": "Я их ненавижу. Ненавижу их всех."
    },
    {
      "key": "dialogue_voyager_miserable5",
      "value": "Себя я ненавижу ещё больше."
    },
    {
      "key": "dialogue_voyager_miserable6",
      "value": "...Кажется, я не могу это остановить."
    },
    {
      "key": "dialogue_voyager_miserable7",
      "value": "Только не снова. Не снова, пожалуйста, не снова."
    },
    {
      "key": "dialogue_voyager_miserable8",
      "value": "Я никто. Я всегда был никем."
    },
    {
      "key": "dialogue_voyager_miserable9",
      "value": "Держись. Просто держись ещё немного."
    },
    {
      "key": "dialogue_voyager_miserable10",
      "value": "Я не хочу проходить через это снова. Не хочу."
    },
    {
      "key": "dialogue_voyager_miserable11",
      "value": "Сука- я это чувствую. Оно приближается."
    },
    {
      "key": "dialogue_voyager_miserable12",
      "value": "Я не могу сдерживать это вечно."
    },
    {
      "key": "dialogue_voyager_miserable13",
      "value": "Кто-нибудь. Хоть кто-нибудь. Пожалуйста."
    },
    {
      "key": "dialogue_voyager_miserable14",
      "value": "Я так устал выживать вот так."
    },
    {
      "key": "dialogue_voyager_miserable15",
      "value": "...Я не понимаю, кем становлюсь, когда доходит до такого."
    },
    {
      "key": "dialogue_voyager_miserable16",
      "value": "Всё болит. Всё."
    },
    {
      "key": "dialogue_voyager_miserable17",
      "value": "Я не хочу снова причинять себе вред..."
    },
    {
      "key": "dialogue_voyager_miserable18",
      "value": "Вот и всё. Вот и правда всё, да."
    },
    {
      "key": "dialogue_voyager_miserable19",
      "value": "Почему это не прекращается. ПОЧЕМУ ЭТО НЕ ПРЕКРАЩАЕТСЯ."
    },
    {
      "key": "dialogue_voyager_miserable20",
      "value": "Я больше не могу это сдерживать. Не могу- Я НЕ МОГУ."
    },
    {
      "key": "dialogue_voyager_miserable21",
      "value": "Всё, чем я являюсь, — это ложь. Каждая частичка."
    },
    {
      "key": "dialogue_voyager_miserable22",
      "value": "Ненавижу тебя. Ненавижу тебя. Ненавижу СЕБЯ."
    },
    {
      "key": "dialogue_voyager_miserable23",
      "value": "Это больше нельзя контролировать."
    },
    {
      "key": "dialogue_voyager_miserable24",
      "value": "Я никогда не был выше остальных. Я НИКОГДА не был выше остальных."
    },
    {
      "key": "dialogue_voyager_miserable25",
      "value": "Теперь быстрее. Всё быстрее. Я это чувствую."
    },
    {
      "key": "dialogue_voyager_miserable26",
      "value": "Пожалуйста. Пожалуйста, умоляю. Прекратись. Просто прекратись."
    },
    {
      "key": "dialogue_voyager_miserable27",
      "value": "Я не знаю, как справиться с этим на этот раз."
    },
    {
      "key": "dialogue_voyager_miserable28",
      "value": "Сейчас всё иначе. Сейчас намного хуже, чем раньше."
    },
    {
      "key": "dialogue_voyager_miserable29",
      "value": "От себя не убежать."
    },
    {
      "key": "dialogue_voyager_miserable30",
      "value": "Каждой своей частью я хочу, чтобы это закончилось."
    },
    {
      "key": "dialogue_voyager_miserable31",
      "value": "Я себе сейчас не доверяю. Не доверяю..."
    },
    {
      "key": "dialogue_voyager_miserable32",
      "value": "Вот и всё. Вот как это происходит, да."
    },

    {
      "key": "dialogue_voyager_hitgroundhard1",
      "value": "Агх!"
    },
    {
      "key": "dialogue_voyager_hitgroundhard2",
      "value": "Нгх!"
    },
    {
      "key": "dialogue_voyager_hitgroundhard3",
      "value": "Чёрт!"
    },
    {
      "key": "dialogue_voyager_hitgroundhard4",
      "value": "Ай-! Чёрт побери."
    },
    {
      "key": "dialogue_voyager_hitgroundhard5",
      "value": "Неосторожно. Это было неосторожно."
    },

    {
      "key": "dialogue_voyager_fallscream1",
      "value": "БЛЯТЬ!"
    },
    {
      "key": "dialogue_voyager_fallscream2",
      "value": "ААА!"
    },
    {
      "key": "dialogue_voyager_fallscream3",
      "value": "СУКА-!"
    },
    {
      "key": "dialogue_voyager_fallscream4",
      "value": "ААААААА!"
    },

    {
      "key": "dialogue_voyager_hitbycreature1",
      "value": "СЛЕЗЬ С МЕНЯ! СЛЕЗЬ, БЛЯТЬ!"
    },
    {
      "key": "dialogue_voyager_hitbycreature2",
      "value": "СУКА! СЪЕБИСЬ!"
    },
    {
      "key": "dialogue_voyager_hitbycreature3",
      "value": "ААААА! НЕТ! НЕТ!"
    },
    {
      "key": "dialogue_voyager_hitbycreature4",
      "value": "СТОЙ! ОТОЙДИ!"
    },
    {
      "key": "dialogue_voyager_hitbycreature5",
      "value": "ТОЛЬКО НЕ ТАК! УБИРАЙСЯ!"
    },

    {
      "key": "dialogue_voyager_wet1",
      "value": "Грязная вода. Нужно высохнуть."
    },
    {
      "key": "dialogue_voyager_wet2",
      "value": "Ненавижу это. Ненавижу всё это."
    },
    {
      "key": "dialogue_voyager_wet3",
      "value": "Промок. Отвратительно."
    },
    {
      "key": "dialogue_voyager_wet4",
      "value": "Угх. Чувствую это в своей шерсти."
    },
    {
      "key": "dialogue_voyager_wet5",
      "value": "Это ниже моего достоинства. Всё это."
    },
    {
      "key": "dialogue_voyager_wet6",
      "value": "Мокро. Холодно. Убого."
    },
    {
      "key": "dialogue_voyager_wet7",
      "value": "Ненавижу мокнуть."
    },
    {
      "key": "dialogue_voyager_wet8",
      "value": "Совершенно промок. Прекрасно."
    },
    {
      "key": "dialogue_voyager_wet9",
      "value": "Мне нужно обсохнуть. Сейчас же."
    },

    {
      "key": "dialogue_voyager_dirty1",
      "value": "Я грязный. Недопустимо."
    },
    {
      "key": "dialogue_voyager_dirty2",
      "value": "Мне нужно это отмыть. Сейчас же."
    },
    {
      "key": "dialogue_voyager_dirty3",
      "value": "Это не я. Я не должен так выглядеть."
    },
    {
      "key": "dialogue_voyager_dirty4",
      "value": "Отвратительно. Мне нужно помыться."
    },
    {
      "key": "dialogue_voyager_dirty5",
      "value": "Я отказываюсь оставаться таким."
    },

    {
      "key": "dialogue_voyager_cold1",
      "value": "Холодно."
    },
    {
      "key": "dialogue_voyager_cold2",
      "value": "Мне нужно место потеплее."
    },
    {
      "key": "dialogue_voyager_cold3",
      "value": "Этот холод неприятен."
    },
    {
      "key": "dialogue_voyager_cold4",
      "value": "Стоит найти укрытие от этого холода."
    },

    {
      "key": "dialogue_voyager_warm1",
      "value": "Здесь немного тепло."
    },
    {
      "key": "dialogue_voyager_warm2",
      "value": "Не помешало бы немного холодного воздуха."
    },
    {
      "key": "dialogue_voyager_warm3",
      "value": "Это тепло терпимо. Пока что."
    },

    {
      "key": "dialogue_voyager_hot1",
      "value": "Слишком жарко."
    },
    {
      "key": "dialogue_voyager_hot2",
      "value": "Мне нужно остыть."
    },
    {
      "key": "dialogue_voyager_hot3",
      "value": "Эта жара невыносима."
    },
    {
      "key": "dialogue_voyager_hot4",
      "value": "Не могу ясно мыслить в такую жару."
    },
    {
      "key": "dialogue_voyager_hot5",
      "value": "Мне нужна тень. Сейчас же."
    },

    {
      "key": "dialogue_voyager_freezing1",
      "value": "Я замерзаю."
    },
    {
      "key": "dialogue_voyager_freezing2",
      "value": "Мне нужно тепло. Сейчас же."
    },
    {
      "key": "dialogue_voyager_freezing3",
      "value": "Не могу перестать дрожать."
    },
    {
      "key": "dialogue_voyager_freezing4",
      "value": "Этот холод по-настоящему опасен."
    },
    {
      "key": "dialogue_voyager_freezing5",
      "value": "Мне нужно немедленно найти тепло."
    },

    {
      "key": "dialogue_voyager_exerted1",
      "value": "Мне нужна минута."
    },
    {
      "key": "dialogue_voyager_exerted2",
      "value": "Дайте мне секунду отдышаться."
    },
    {
      "key": "dialogue_voyager_exerted3",
      "value": "Я немного вымотан."
    },
    {
      "key": "dialogue_voyager_exerted4",
      "value": "На сегодня нагрузок достаточно."
    },

    {
      "key": "dialogue_voyager_exhausted1",
      "value": "Я вымотан."
    },
    {
      "key": "dialogue_voyager_exhausted2",
      "value": "Мне нужно остановиться. Сейчас же."
    },
    {
      "key": "dialogue_voyager_exhausted3",
      "value": "Едва могу двигаться дальше."
    },
    {
      "key": "dialogue_voyager_exhausted4",
      "value": "Это тело не создано для таких нагрузок."
    },
    {
      "key": "dialogue_voyager_exhausted5",
      "value": "Мне нужен отдых. Немедленно."
    },

    {
      "key": "dialogue_voyager_emaciated1",
      "value": "Я слишком сильно потерял в весе. Это плохо."
    },
    {
      "key": "dialogue_voyager_emaciated2",
      "value": "Сейчас я слишком худой."
    },
    {
      "key": "dialogue_voyager_emaciated3",
      "value": "Мне действительно нужно есть больше. Это не тщеславие, это выживание."
    },

    {
      "key": "dialogue_voyager_obese1",
      "value": "...Абсолютно нет. Мне нужно это исправить."
    },
    {
      "key": "dialogue_voyager_obese2",
      "value": "Это недопустимо. Я не должен так выглядеть."
    },
    {
      "key": "dialogue_voyager_obese3",
      "value": "Мне нужно сократить рацион. Немедленно."
    },
    {
      "key": "dialogue_voyager_obese4",
      "value": "Это позор. Мне нужно сбросить этот вес."
    },
    {
      "key": "dialogue_voyager_obese5",
      "value": "I refuse to let myself look like this."
    },

    {
      "key": "dialogue_voyager_encumbered1",
      "value": "I'm carrying too much."
    },
    {
      "key": "dialogue_voyager_encumbered2",
      "value": "This weight is slowing me down."
    },
    {
      "key": "dialogue_voyager_encumbered3",
      "value": "I shouldn't have to carry all of this myself."
    },
    {
      "key": "dialogue_voyager_encumbered4",
      "value": "This is an Orange's job, not mine."
    },
    {
      "key": "dialogue_voyager_encumbered5",
      "value": "I need to drop some of this. Now."
    },

    {
      "key": "dialogue_voyager_cantBreathe1",
      "value": "I can't breathe!"
    },
    {
      "key": "dialogue_voyager_cantBreathe2",
      "value": "Something's- I can't get air!"
    },
    {
      "key": "dialogue_voyager_cantBreathe3",
      "value": "Help- I can't breathe!"
    },
    {
      "key": "dialogue_voyager_cantBreathe4",
      "value": "I'm suffocating!"
    },
    {
      "key": "dialogue_voyager_cantBreathe5",
      "value": "I need air! NOW!"
    },

    {
      "key": "dialogue_voyager_opiated1",
      "value": "...Oh."
    },
    {
      "key": "dialogue_voyager_opiated2",
      "value": "That's... better. Quieter."
    },
    {
      "key": "dialogue_voyager_opiated3",
      "value": "Everything's slower now. I don't mind it."
    },
    {
      "key": "dialogue_voyager_opiated4",
      "value": "...I don't have to think right now. Good."
    },
    {
      "key": "dialogue_voyager_opiated5",
      "value": "Mmh... this is fine. This is manageable."
    },
    {
      "key": "dialogue_voyager_opiated6",
      "value": "I feel... still. For once."
    },
    {
      "key": "dialogue_voyager_opiated7",
      "value": "No one needs to see me like this."
    },
    {
      "key": "dialogue_voyager_opiated8",
      "value": "...I could stay like this a while."
    },
    {
      "key": "dialogue_voyager_opiated9",
      "value": "Nothing feels urgent right now. Strange."
    },
    {
      "key": "dialogue_voyager_opiated10",
      "value": "This is just maintenance. Nothing more."
    },

    {
      "key": "dialogue_voyager_opiatedsad1",
      "value": "...Finally. Finally it's quiet."
    },
    {
      "key": "dialogue_voyager_opiatedsad2",
      "value": "I needed this. I actually needed this."
    },
    {
      "key": "dialogue_voyager_opiatedsad3",
      "value": "...I don't have to hold it together right now."
    },
    {
      "key": "dialogue_voyager_opiatedsad4",
      "value": "This is the only peace I get."
    },
    {
      "key": "dialogue_voyager_opiatedsad5",
      "value": "...Don't tell anyone I said that."
    },
    {
      "key": "dialogue_voyager_opiatedsad6",
      "value": "It stopped. Everything just... stopped."
    },
    {
      "key": "dialogue_voyager_opiatedsad7",
      "value": "I'll deal with the rest of it later."
    },

    {
      "key": "dialogue_voyager_opiatewithdrawal1",
      "value": "...I need that again."
    },
    {
      "key": "dialogue_voyager_opiatewithdrawal2",
      "value": "This isn't a dependency. It's a tool."
    },
    {
      "key": "dialogue_voyager_opiatewithdrawal3",
      "value": "I shouldn't need this as often as I do."
    },
    {
      "key": "dialogue_voyager_opiatewithdrawal4",
      "value": "...I hate that I'm thinking about it."
    },
    {
      "key": "dialogue_voyager_opiatewithdrawal5",
      "value": "It's not weakness. It's not."
    },
    {
      "key": "dialogue_voyager_opiatewithdrawal6",
      "value": "I could use that quiet again right about now."
    },

    {
      "key": "dialogue_voyager_steponglass1",
      "value": "...Careless."
    },
    {
      "key": "dialogue_voyager_steponglass2",
      "value": "I should watch where I step."
    },
    {
      "key": "dialogue_voyager_steponglass3",
      "value": "Glass. Wonderful."
    },
    {
      "key": "dialogue_voyager_steponglass4",
      "value": "That was avoidable."
    },

    {
      "key": "dialogue_voyager_seecorpse1",
      "value": "Figures."
    },
    {
      "key": "dialogue_voyager_seecorpse2",
      "value": "...Another one."
    },
    {
      "key": "dialogue_voyager_seecorpse3",
      "value": "Not my problem."
    },
    {
      "key": "dialogue_voyager_seecorpse4",
      "value": "Weak. Just like the rest."
    },
    {
      "key": "dialogue_voyager_seecorpse5",
      "value": "Shouldn't have been down here."
    },
    {
      "key": "dialogue_voyager_seecorpse6",
      "value": "...Not surprising."
    },
    {
      "key": "dialogue_voyager_seecorpse7",
      "value": "Better them than me."
    },

    {
      "key": "dialogue_voyager_breakcorpse1",
      "value": "...Hm."
    },
    {
      "key": "dialogue_voyager_breakcorpse2",
      "value": "Doesn't matter now, does it."
    },
    {
      "key": "dialogue_voyager_breakcorpse3",
      "value": "They won't notice."
    },

    {
      "key": "dialogue_voyager_murderregret1",
      "value": "...It had to be done."
    },
    {
      "key": "dialogue_voyager_murderregret2",
      "value": "They shouldn't have tried me."
    },
    {
      "key": "dialogue_voyager_murderregret3",
      "value": "No regrets. None."
    },
    {
      "key": "dialogue_voyager_murderregret4",
      "value": "...That's one less thing to worry about."
    },
    {
      "key": "dialogue_voyager_murderregret5",
      "value": "Self defense. Simple as that."
    },

    {
      "key": "dialogue_voyager_drillend1",
      "value": "...That took longer than expected."
    },
    {
      "key": "dialogue_voyager_drillend2",
      "value": "Finally. My ears are ringing."
    },
    {
      "key": "dialogue_voyager_drillend3",
      "value": "That was a long ride."
    },

    {
      "key": "dialogue_voyager_loud1",
      "value": "...That was loud."
    },
    {
      "key": "dialogue_voyager_loud2",
      "value": "My ears are ringing."
    },
    {
      "key": "dialogue_voyager_loud3",
      "value": "Fuck, that was too loud."
    },
    {
      "key": "dialogue_voyager_loud4",
      "value": "Whatever that was, I'd rather not repeat it."
    },

    {
      "key": "dialogue_voyager_braindamaged1",
      "value": "Wha... what was that thing I was..."
    },
    {
      "key": "dialogue_voyager_braindamaged2",
      "value": "I'm the... the best. The best what?"
    },
    {
      "key": "dialogue_voyager_braindamaged3",
      "value": "Everyone's beneath... beneath the... floor is beneath..."
    },
    {
      "key": "dialogue_voyager_braindamaged4",
      "value": "I am. I am the. I am."
    },
    {
      "key": "dialogue_voyager_braindamaged5",
      "value": "Cloak. Cloak. Where's my... where's the floor going."
    },
    {
      "key": "dialogue_voyager_braindamaged6",
      "value": "Rat? Is that- no. No that's not... hi."
    },
    {
      "key": "dialogue_voyager_braindamaged7",
      "value": "Superior. Superior. Very good word. Superior."
    },

    {
      "key": "dialogue_voyager_lastmoments1",
      "value": "...No. Not like this."
    },
    {
      "key": "dialogue_voyager_lastmoments2",
      "value": "I refuse to end here."
    },
    {
      "key": "dialogue_voyager_lastmoments3",
      "value": "Someone- anyone... please..."
    },
    {
      "key": "dialogue_voyager_lastmoments4",
      "value": "This isn't how this was supposed to go..."
    },
    {
      "key": "dialogue_voyager_lastmoments5",
      "value": "I'm not ready. I'm not ready for this."
    },
    {
      "key": "dialogue_voyager_lastmoments6",
      "value": "...Please. I don't want to die here."
    },
    {
      "key": "dialogue_voyager_lastmoments7",
      "value": "Not here. Not like this. Please..."
    },

    {
      "key": "dialogue_voyager_magicheal1",
      "value": "...Huh. That's... unexpected."
    },
    {
      "key": "dialogue_voyager_magicheal2",
      "value": "I feel... better. I'll take it."
    },

    {
      "key": "dialogue_voyager_selfdestruct1",
      "value": "Wait- WAIT. You can't be serious! GET IT OUT! GET IT OUT OF ME!"
    },
    {
      "key": "dialogue_voyager_selfdestruct2",
      "value": "No- no no no, I did everything right! I PROVED myself! Wait-!"
    },
    {
      "key": "dialogue_voyager_selfdestruct3",
      "value": "I'm better than this! I'm BETTER THAN THIS! Please, make it stop!"
    },

    {
      "key": "dialogue_voyager_swingresponse1",
      "value": "FUCK!"
    },
    {
      "key": "dialogue_voyager_swingresponse2",
      "value": "You'll regret that."
    },
    {
      "key": "dialogue_voyager_swingresponse3",
      "value": "THAT'S IT. THAT'S FUCKING IT."
    },
    {
      "key": "dialogue_voyager_swingresponse4",
      "value": "Big mistake."
    },
    {
      "key": "dialogue_voyager_swingresponse5",
      "value": "You have NO idea what you just started."
    },

    {
      "key": "dialogue_voyager_tradeemeet1",
      "value": "..."
    },
    {
      "key": "dialogue_voyager_tradeemeet2",
      "value": "You. What do you have."
    },
    {
      "key": "dialogue_voyager_tradeemeet3",
      "value": "I'm not here to socialize."
    },
    {
      "key": "dialogue_voyager_tradeemeet4",
      "value": "Let's make this quick."
    },
    {
      "key": "dialogue_voyager_tradeemeet5",
      "value": "Show me what's worth my time."
    },
    {
      "key": "dialogue_voyager_tradeemeet6",
      "value": "...Another survivor. Fine."
    },
    {
      "key": "dialogue_voyager_tradeemeet7",
      "value": "I don't need pleasantries. Just business."
    },
    {
      "key": "dialogue_voyager_tradeemeet8",
      "value": "Keep your distance and we'll get along fine."
    },
    {
      "key": "dialogue_voyager_tradeemeet9",
      "value": "Make this brief."
    },
    {
      "key": "dialogue_voyager_tradeemeet10",
      "value": "I have no interest in conversation."
    },
    {
      "key": "dialogue_voyager_tradeemeet11",
      "value": "Let's see if you're worth stopping for."
    },
    {
      "key": "dialogue_voyager_tradeemeet12",
      "value": "Don't waste my time."
    },

    {
      "key": "dialogue_voyager_tradermeetnormal1",
      "value": "A- a Voyager? Oh boy..."
    },
    {
      "key": "dialogue_voyager_tradermeetnormal2",
      "value": "P-please, take whatever you need..."
    },
    {
      "key": "dialogue_voyager_tradermeetnormal3",
      "value": "I don't want any trouble, I swear!"
    },
    {
      "key": "dialogue_voyager_tradermeetnormal4",
      "value": "Oh gosh, okay, um... hi."
    },
    {
      "key": "dialogue_voyager_tradermeetnormal5",
      "value": "You're not gonna hurt me, right? Right?"
    },
    {
      "key": "dialogue_voyager_tradermeetnormal6",
      "value": "H-hello! Everything's fine here! Totally fine!"
    },

    {
      "key": "dialogue_voyager_tradermeetgood1",
      "value": "Oh! A Voyager! I've heard you guys are actually kind of amazing?"
    },
    {
      "key": "dialogue_voyager_tradermeetgood2",
      "value": "Wow, hi! I promise I'm not gonna waste your time!"
    },
    {
      "key": "dialogue_voyager_tradermeetgood3",
      "value": "Hey, hello! You look like you've got this whole thing figured out!"
    },
    {
      "key": "dialogue_voyager_tradermeetgood4",
      "value": "Oh man, an actual Voyager stopping by! Cool!"
    },
    {
      "key": "dialogue_voyager_tradermeetgood5",
      "value": "Welcome! I'll try to have something worth your time, promise!"
    },

    {
      "key": "dialogue_voyager_tradermeetbad1",
      "value": "Oh no. Oh no no no."
    },
    {
      "key": "dialogue_voyager_tradermeetbad2",
      "value": "Please don't hurt me, please don't hurt me..."
    },
    {
      "key": "dialogue_voyager_tradermeetbad3",
      "value": "I- I'll give you anything, just don't-"
    },
    {
      "key": "dialogue_voyager_tradermeetbad4",
      "value": "You're one of the scary ones, aren't you..."
    },
    {
      "key": "dialogue_voyager_tradermeetbad5",
      "value": "I heard about what Voyagers do to people who annoy them..."
    },

    {
      "key": "dialogue_voyager_traderdepressed1",
      "value": "A- a Voyager? Are you... okay?"
    },
    {
      "key": "dialogue_voyager_traderdepressed2",
      "value": "You don't look so good. Are you... alright?"
    },
    {
      "key": "dialogue_voyager_traderdepressed3",
      "value": "I've never seen a Voyager look like that before..."
    },
    {
      "key": "dialogue_voyager_traderdepressed4",
      "value": "Hey... you okay? You seem really off."
    },

    {
      "key": "dialogue_voyager_traderhugsuccess1",
      "value": "...Oh. Okay. Come here."
    },
    {
      "key": "dialogue_voyager_traderhugsuccess2",
      "value": "Hey... it's alright. I've got you."
    },
    {
      "key": "dialogue_voyager_traderhugsuccess3",
      "value": "...Didn't expect that from a Voyager, but okay."
    },
    {
      "key": "dialogue_voyager_traderhugsuccess4",
      "value": "You're allowed to not be okay, you know."
    },
    {
      "key": "dialogue_voyager_traderhugsuccess5",
      "value": "...Shh. It's fine. Just breathe."
    },

    {
      "key": "dialogue_voyager_traderhugfail1",
      "value": "Uh- I don't- sorry, I don't do that."
    },
    {
      "key": "dialogue_voyager_traderhugfail2",
      "value": "N-no offense, but I'd rather not."
    },
    {
      "key": "dialogue_voyager_traderhugfail3",
      "value": "Sorry. That's... not really my thing."
    },
    {
      "key": "dialogue_voyager_traderhugfail4",
      "value": "I don't know you well enough for that, sorry."
    },

    {
      "key": "dialogue_voyager_traderhagglesuccess1",
      "value": "O-okay! Okay, that's fair! Here!"
    },
    {
      "key": "dialogue_voyager_traderhagglesuccess2",
      "value": "You're right, you're right! I'll adjust it!"
    },
    {
      "key": "dialogue_voyager_traderhagglesuccess3",
      "value": "Please don't be mad, here's a discount!"
    },
    {
      "key": "dialogue_voyager_traderhagglesuccess4",
      "value": "Yeah! Yeah, that works! Take it!"
    },
    {
      "key": "dialogue_voyager_traderhagglesuccess5",
      "value": "I mean, I guess that's reasonable... here."
    },

    {
      "key": "dialogue_voyager_traderhagglefail1",
      "value": "I- I'm sorry, I really can't!"
    },
    {
      "key": "dialogue_voyager_traderhagglefail2",
      "value": "Please don't be upset, but no..."
    },
    {
      "key": "dialogue_voyager_traderhagglefail3",
      "value": "I wish I could, I really do, but no."
    },
    {
      "key": "dialogue_voyager_traderhagglefail4",
      "value": "Sorry! Sorry, that's just not possible..."
    },
    {
      "key": "dialogue_voyager_traderhagglefail5",
      "value": "N-no, sorry. I can't go lower than that."
    },

    {
      "key": "dialogue_voyager_tradergiveitem1",
      "value": "Oh! Thank you, thank you!"
    },
    {
      "key": "dialogue_voyager_tradergiveitem2",
      "value": "You didn't have to do that, but- thank you!"
    },
    {
      "key": "dialogue_voyager_tradergiveitem3",
      "value": "Wow, okay! Appreciated!"
    },
    {
      "key": "dialogue_voyager_tradergiveitem4",
      "value": "That's really generous of you, thanks!"
    },
    {
      "key": "dialogue_voyager_tradergiveitem5",
      "value": "Thank you! Please, take a look at what I've got."
    },

    {
      "key": "dialogue_voyager_tradergiveitemrefuse1",
      "value": "That's plenty! I don't need any more, promise!"
    },
    {
      "key": "dialogue_voyager_tradergiveitemrefuse2",
      "value": "You've given enough already, really!"
    },

    {
      "key": "dialogue_voyager_traderbuy1",
      "value": "Here! It's yours!"
    },
    {
      "key": "dialogue_voyager_traderbuy2",
      "value": "Please, take it! No trouble at all!"
    },
    {
      "key": "dialogue_voyager_traderbuy3",
      "value": "Yours now! Enjoy!"
    },
    {
      "key": "dialogue_voyager_traderbuy4",
      "value": "Here you go! Use it well!"
    },
    {
      "key": "dialogue_voyager_traderbuy5",
      "value": "All yours!"
    },

    {
      "key": "dialogue_voyager_traderbuyfail1",
      "value": "W-wait, that's not how this works..."
    },
    {
      "key": "dialogue_voyager_traderbuyfail2",
      "value": "You have to pay first, please..."
    },
    {
      "key": "dialogue_voyager_traderbuyfail3",
      "value": "I- I can't just give it away, sorry..."
    },
    {
      "key": "dialogue_voyager_traderbuyfail4",
      "value": "Please, I need something in return..."
    },

    {
      "key": "dialogue_voyager_traderbuyfailmaxvalue1",
      "value": "I- I can't trade away everything, sorry!"
    },
    {
      "key": "dialogue_voyager_traderbuyfailmaxvalue2",
      "value": "That's enough trading for now, please!"
    },

    {
      "key": "dialogue_voyager_traderwarning1",
      "value": "Just because you're a Voyager doesn't mean you can do whatever you want!"
    },
    {
      "key": "dialogue_voyager_traderwarning2",
      "value": "I don't care what you are, get out!"
    },
    {
      "key": "dialogue_voyager_traderwarning3",
      "value": "Being a Voyager doesn't scare me THAT much. Leave!"
    },
    {
      "key": "dialogue_voyager_traderwarning4",
      "value": "This is MY pod! Get out, now!"
    },
    {
      "key": "dialogue_voyager_traderwarning5",
      "value": "I'm serious! Leave, before I make you!"
    },
    {
      "key": "dialogue_voyager_traderwarning6",
      "value": "You don't get special treatment here! Out!"
    },

    {
      "key": "dialogue_voyager_tradercombat1",
      "value": "I'M NOT SCARED OF YOU!"
    },
    {
      "key": "dialogue_voyager_tradercombat2",
      "value": "YOU DON'T OWN THIS PLACE!"
    },
    {
      "key": "dialogue_voyager_tradercombat3",
      "value": "SO WHAT IF YOU'RE A VOYAGER!?"
    },
    {
      "key": "dialogue_voyager_tradercombat4",
      "value": "I WARNED YOU! I WARNED YOU!"
    },
    {
      "key": "dialogue_voyager_tradercombat5",
      "value": "GET OUT OF MY POD!"
    },
    {
      "key": "dialogue_voyager_tradercombat6",
      "value": "YOU'RE NOT AS SCARY AS YOU THINK!"
    },

    {
      "key": "dialogue_voyager_traderthreatensuccess1",
      "value": "O-okay! Okay! Take it and go!"
    },
    {
      "key": "dialogue_voyager_traderthreatensuccess2",
      "value": "Please don't hurt me, just take it!"
    },
    {
      "key": "dialogue_voyager_traderthreatensuccess3",
      "value": "F-fine! Fine, whatever you want!"
    },
    {
      "key": "dialogue_voyager_traderthreatensuccess4",
      "value": "I knew Voyagers were dangerous... take it, please..."
    },
    {
      "key": "dialogue_voyager_traderthreatensuccess5",
      "value": "Just- just go easy on me... take whatever..."
    },

    {
      "key": "dialogue_voyager_traderlightbreak1",
      "value": "H-hey! That was mine!"
    },
    {
      "key": "dialogue_voyager_traderlightbreak2",
      "value": "Please don't break anything else, please leave..."
    },
    {
      "key": "dialogue_voyager_traderlightbreak3",
      "value": "That's not okay! Get out!"
    },
    {
      "key": "dialogue_voyager_traderlightbreak4",
      "value": "Why would you do that... just leave, please."
    },

    {
      "key": "dialogue_voyager_tradermove1",
      "value": "S-sure! Whatever you need!"
    },

    {
      "key": "dialogue_voyager_tradermovefail1",
      "value": "I- I'd rather stay here, sorry..."
    },

    {
      "key": "dialogue_voyager_traderwakegreet1",
      "value": "Hey... how are you feeling? Better, I hope."
    },
    {
      "key": "dialogue_voyager_traderwakegreet2",
      "value": "Morning. Did you actually get some rest?"
    },
    {
      "key": "dialogue_voyager_traderwakegreet3",
      "value": "Hey. You slept a while. That's probably good."
    },
    {
      "key": "dialogue_voyager_traderwakegreet4",
      "value": "Oh- you're up. How are you doing?"
    },
    {
      "key": "dialogue_voyager_traderwakegreet5",
      "value": "Take your time waking up. No rush."
    },

    {
      "key": "dialogue_voyager_traderseegun1",
      "value": "W-woah! Please, put that away!"
    },
    {
      "key": "dialogue_voyager_traderseegun2",
      "value": "Okay, okay! No sudden moves, please!"
    },
    {
      "key": "dialogue_voyager_traderseegun3",
      "value": "Please don't shoot me, please!"
    },

    {
      "key": "dialogue_voyager_tradermeetimpairedspeech1",
      "value": "Uh... you've got something in your mouth?"
    },
    {
      "key": "dialogue_voyager_tradermeetimpairedspeech2",
      "value": "I can't understand a word of that, sorry..."
    },

    {
      "key": "dialogue_voyager_traderseehurt1",
      "value": "You're bleeding! Here, take a dressing, please."
    },
    {
      "key": "dialogue_voyager_traderseehurt2",
      "value": "That looks bad. I've got a bandage if you need one."
    },
    {
      "key": "dialogue_voyager_traderseehurt3",
      "value": "Please patch that up. I can spare something for it."
    },

    {
      "key": "dialogue_voyager_vomitresponse1",
      "value": "Oh gosh- are you okay?"
    },
    {
      "key": "dialogue_voyager_vomitresponse2",
      "value": "That's... a lot. Are you alright?"
    },

    {
      "key": "dialogue_voyager_vomitbloodresponse1",
      "value": "W-wait, that's blood! Are you okay?!"
    },

    {
      "key": "dialogue_voyager_hungryresponse1",
      "value": "I might have some food, if you're willing to trade."
    },
    {
      "key": "dialogue_voyager_hungryresponse2",
      "value": "There's probably food out there... or I could spare some, maybe?"
    },

    {
      "key": "dialogue_voyager_thirstyresponse1",
      "value": "I could give you something to drink, if you want to trade."
    },
    {
      "key": "dialogue_voyager_thirstyresponse2",
      "value": "I think I've got something you could drink..."
    },

    {
      "key": "dialogue_voyager_sadresponse1",
      "value": "Hey... are you doing okay?"
    },
    {
      "key": "dialogue_voyager_sadresponse2",
      "value": "You can stay a while, if you need to."
    },

    {
      "key": "dialogue_voyager_depressedresponse1",
      "value": "H-hey... it's okay. You don't have to push through this alone."
    },
    {
      "key": "dialogue_voyager_depressedresponse2",
      "value": "I don't know what to say, but... I'm here, I guess."
    },

    {
      "key": "dialogue_voyager_selfharmresponse1",
      "value": "Oh no... please, stop that..."
    },

    {
      "key": "dialogue_voyager_braindamagedresponse1",
      "value": "Uh... are you okay? You're not making much sense."
    },
    {
      "key": "dialogue_voyager_braindamagedresponse2",
      "value": "...What?"
    },

    {
      "key": "dialogue_voyager_hotresponse1",
      "value": "Feel free to adjust the temperature."
    },
    {
      "key": "dialogue_voyager_coldresponse1",
      "value": "You can turn up the heat, if you want."
    },

    {
      "key": "dialogue_voyager_bleedingresponse1",
      "value": "You're bleeding! Here, take a bandage, please!"
    },
    {
      "key": "dialogue_voyager_painresponse1",
      "value": "Are you okay? That looked like it hurt..."
    },

    {
      "key": "dialogue_voyager_dirtyresponse1",
      "value": "You can use my shower, if you need to..."
    },

    {
      "key": "dialogue_voyager_encumberedresponse1",
      "value": "I could take some of that off your hands, if you want to trade."
    },

    {
      "key": "dialogue_voyager_dyingresponse1",
      "value": "Oh no- oh no, please stay with me, please!"
    },
    {
      "key": "dialogue_voyager_dyingresponse2",
      "value": "I- I don't know what to do! Please, hang on!"
    },

    {
      "key": "dialogue_voyager_chr1_tradermeetnormal1",
      "value": "A Voyager. How predictable."
    },
    {
      "key": "dialogue_voyager_chr1_tradermeetnormal2",
      "value": "Here to prove something, or just passing through?"
    },
    {
      "key": "dialogue_voyager_chr1_tradermeetnormal3",
      "value": "I've survived worse than you. Come in, if you must."
    },
    {
      "key": "dialogue_voyager_chr1_tradermeetnormal4",
      "value": "Oh good. Someone to talk down to me. How refreshing."
    },
    {
      "key": "dialogue_voyager_chr1_tradermeetnormal5",
      "value": "You're not the first Voyager to walk in here with that look."
    },

    {
      "key": "dialogue_voyager_chr1_tradermeetgood1",
      "value": "A Voyager who isn't posturing yet. Rare."
    },
    {
      "key": "dialogue_voyager_chr1_tradermeetgood2",
      "value": "Let's see if you're as sharp as you think you are."
    },
    {
      "key": "dialogue_voyager_chr1_tradermeetgood3",
      "value": "Fine. Come in. Try not to disappoint me."
    },
    {
      "key": "dialogue_voyager_chr1_tradermeetgood4",
      "value": "You're welcome here. Don't make me regret that."
    },

    {
      "key": "dialogue_voyager_chr1_tradermeetbad1",
      "value": "...You look worse than I expected. Good."
    },
    {
      "key": "dialogue_voyager_chr1_tradermeetbad2",
      "value": "Not so superior now, are you."
    },
    {
      "key": "dialogue_voyager_chr1_tradermeetbad3",
      "value": "Even you fall apart eventually. Interesting."
    },
    {
      "key": "dialogue_voyager_chr1_tradermeetbad4",
      "value": "Come in. I'll enjoy this."
    },

    {
      "key": "dialogue_voyager_chr1_traderdepressed1",
      "value": "...You're not performing right now. That's new."
    },
    {
      "key": "dialogue_voyager_chr1_traderdepressed2",
      "value": "Huh. So there's actually something under all that pride."
    },
    {
      "key": "dialogue_voyager_chr1_traderdepressed3",
      "value": "You look almost human right now. I mean that as an insult."
    },

    {
      "key": "dialogue_voyager_chr1_traderhugsuccess1",
      "value": "...Fine. Come here. Don't make this weird."
    },
    {
      "key": "dialogue_voyager_chr1_traderhugsuccess2",
      "value": "This doesn't change anything between us."
    },
    {
      "key": "dialogue_voyager_chr1_traderhugsuccess3",
      "value": "...Don't get used to this."
    },
    {
      "key": "dialogue_voyager_chr1_traderhugsuccess4",
      "value": "Even you need this sometimes, I suppose."
    },

    {
      "key": "dialogue_voyager_chr1_traderhugfail1",
      "value": "No. Save it."
    },
    {
      "key": "dialogue_voyager_chr1_traderhugfail2",
      "value": "I don't do that. Especially not with you."
    },
    {
      "key": "dialogue_voyager_chr1_traderhugfail3",
      "value": "Absolutely not."
    },

    {
      "key": "dialogue_voyager_chr1_traderwakegreet1",
      "value": "...You actually slept. Good."
    },
    {
      "key": "dialogue_voyager_chr1_traderwakegreet2",
      "value": "Rest well? You needed it."
    },
    {
      "key": "dialogue_voyager_chr1_traderwakegreet3",
      "value": "Morning. I mean that kindly, for once."
    },

    {
      "key": "dialogue_voyager_chr1_tradergiveitem1",
      "value": "I'll take it. Doesn't mean I owe you anything."
    },
    {
      "key": "dialogue_voyager_chr1_tradergiveitem2",
      "value": "Useful. I'm still not impressed."
    },
    {
      "key": "dialogue_voyager_chr1_tradergiveitem3",
      "value": "Fine. Thank you. There. Happy?"
    },

    {
      "key": "dialogue_voyager_chr1_tradergiveitemrefuse1",
      "value": "Enough. I don't need your charity."
    },
    {
      "key": "dialogue_voyager_chr1_tradergiveitemrefuse2",
      "value": "Stop. You're not buying my approval."
    },

    {
      "key": "dialogue_voyager_chr1_traderhagglesuccess1",
      "value": "...Fine. You're not entirely useless at this."
    },
    {
      "key": "dialogue_voyager_chr1_traderhagglesuccess2",
      "value": "I'll allow it. Don't get used to it."
    },
    {
      "key": "dialogue_voyager_chr1_traderhagglesuccess3",
      "value": "Acceptable logic. Rare, coming from you."
    },

    {
      "key": "dialogue_voyager_chr1_traderhagglefail1",
      "value": "No. And that argument was embarrassing."
    },
    {
      "key": "dialogue_voyager_chr1_traderhagglefail2",
      "value": "Try again. That was pathetic."
    },
    {
      "key": "dialogue_voyager_chr1_traderhagglefail3",
      "value": "Absolutely not."
    },

    {
      "key": "dialogue_voyager_chr1_traderbuy1",
      "value": "Here. Don't mistake this for kindness."
    },
    {
      "key": "dialogue_voyager_chr1_traderbuy2",
      "value": "Take it. Use it well, for once."
    },
    {
      "key": "dialogue_voyager_chr1_traderbuy3",
      "value": "Yours. Try to be worth it."
    },

    {
      "key": "dialogue_voyager_chr1_traderbuyfail1",
      "value": "Pay first. Even you don't get exceptions."
    },
    {
      "key": "dialogue_voyager_chr1_traderbuyfail2",
      "value": "No. I'm not a charity for the self-important."
    },

    {
      "key": "dialogue_voyager_chr1_traderbuyfailmaxvalue1",
      "value": "Enough. I'm not emptying my stock for you."
    },
    {
      "key": "dialogue_voyager_chr1_traderbuyfailmaxvalue2",
      "value": "That's all you're getting from me today."
    },

    {
      "key": "dialogue_voyager_chr1_traderwarning1",
      "value": "Being a Voyager doesn't make you untouchable here."
    },
    {
      "key": "dialogue_voyager_chr1_traderwarning2",
      "value": "Leave. I've dealt with worse than you."
    },
    {
      "key": "dialogue_voyager_chr1_traderwarning3",
      "value": "I'm not afraid of you. Get out."
    },

    {
      "key": "dialogue_voyager_chr1_tradercombat1",
      "value": "You're not as untouchable as you think."
    },
    {
      "key": "dialogue_voyager_chr1_tradercombat2",
      "value": "I've outsmarted better than you."
    },
    {
      "key": "dialogue_voyager_chr1_tradercombat3",
      "value": "Let's see that pride hold up now."
    },

    {
      "key": "dialogue_voyager_chr1_traderthreatensuccess1",
      "value": "Fine. Take it. Doesn't mean you've won anything."
    },
    {
      "key": "dialogue_voyager_chr1_traderthreatensuccess2",
      "value": "You'd really resort to threats? How predictable of you."
    },

    {
      "key": "dialogue_voyager_chr1_traderlightbreak1",
      "value": "Of course. Typical Voyager arrogance."
    },
    {
      "key": "dialogue_voyager_chr1_traderlightbreak2",
      "value": "That was needless. Leave."
    },

    {
      "key": "dialogue_voyager_chr1_tradermove1",
      "value": "Fine."
    },
    {
      "key": "dialogue_voyager_chr1_tradermovefail1",
      "value": "No. I like it here."
    },

    {
      "key": "dialogue_voyager_chr1_traderseegun1",
      "value": "Put that away. I'm not impressed."
    },
    {
      "key": "dialogue_voyager_chr1_traderseegun2",
      "value": "A gun? How original of you."
    },

    {
      "key": "dialogue_voyager_chr1_tradermeetimpairedspeech1",
      "value": "Something in your mouth? Even less coherent than usual."
    },
    {
      "key": "dialogue_voyager_chr1_tradermeetimpairedspeech2",
      "value": "I can't understand a word. Not that I'm missing much."
    },

    {
      "key": "dialogue_voyager_chr1_traderseehurt1",
      "value": "You're bleeding. Take a bandage. Don't make it a habit."
    },
    {
      "key": "dialogue_voyager_chr1_traderseehurt2",
      "value": "Even you bleed, then. Take a dressing if you need one."
    },

    {
      "key": "dialogue_voyager_chr1_vomitresponse1",
      "value": "Charming. Try not to do that on my floor again."
    },
    {
      "key": "dialogue_voyager_chr1_vomitresponse2",
      "value": "Disgusting. Are you at least okay?"
    },

    {
      "key": "dialogue_voyager_chr1_vomitbloodresponse1",
      "value": "...That's blood. Even I know that's not normal."
    },

    {
      "key": "dialogue_voyager_chr1_hungryresponse1",
      "value": "I'm not a charity. Trade for it, like everyone else."
    },
    {
      "key": "dialogue_voyager_chr1_hungryresponse2",
      "value": "Find your own food. Or offer something worth my time."
    },

    {
      "key": "dialogue_voyager_chr1_thirstyresponse1",
      "value": "There's water out there. Go find it."
    },
    {
      "key": "dialogue_voyager_chr1_thirstyresponse2",
      "value": "I might have something drinkable. For a price."
    },

    {
      "key": "dialogue_voyager_chr1_sadresponse1",
      "value": "...Pull yourself together. This isn't like you."
    },
    {
      "key": "dialogue_voyager_chr1_sadresponse2",
      "value": "Even you have off days, I suppose."
    },

    {
      "key": "dialogue_voyager_chr1_depressedresponse1",
      "value": "...This is unsettling to watch. Even from you."
    },
    {
      "key": "dialogue_voyager_chr1_depressedresponse2",
      "value": "Say something. Anything. This silence is worse."
    },

    {
      "key": "dialogue_voyager_chr1_selfharmresponse1",
      "value": "...Stop that. Now."
    },

    {
      "key": "dialogue_voyager_chr1_braindamagedresponse1",
      "value": "You're even less coherent than usual."
    },
    {
      "key": "dialogue_voyager_chr1_braindamagedresponse2",
      "value": "I'd wager you have a concussion."
    },

    {
      "key": "dialogue_voyager_chr1_hotresponse1",
      "value": "Adjust the temperature. I don't need to hear about it."
    },
    {
      "key": "dialogue_voyager_chr1_coldresponse1",
      "value": "There's a heater. Use it."
    },

    {
      "key": "dialogue_voyager_chr1_bleedingresponse1",
      "value": "Don't bleed on my floor. Bandage exists for a reason."
    },
    {
      "key": "dialogue_voyager_chr1_painresponse1",
      "value": "Pain is a fact of life down here. Deal with it."
    },

    {
      "key": "dialogue_voyager_chr1_dirtyresponse1",
      "value": "Use the shower. You're embarrassing yourself."
    },

    {
      "key": "dialogue_voyager_chr1_encumberedresponse1",
      "value": "Trade some of it off, if it's really that heavy."
    },

    {
      "key": "dialogue_voyager_chr1_dyingresponse1",
      "value": "...No. Not like this. Stay with me."
    },
    {
      "key": "dialogue_voyager_chr1_dyingresponse2",
      "value": "Don't you dare die in my pod."
    },

    {
      "key": "dialogue_voyager_chr2_tradermeetnormal1",
      "value": "Hmm... Fri-end..? Sneak-y..."
    },
    {
      "key": "dialogue_voyager_chr2_tradermeetnormal2",
      "value": "Qui-et fri-end... Hel-lo..."
    },
    {
      "key": "dialogue_voyager_chr2_tradermeetnormal3",
      "value": "Fri-end hi-de good... Hel-lo..."
    },
    {
      "key": "dialogue_voyager_chr2_tradermeetnormal4",
      "value": "Sneak-y fri-end... Come..."
    },
    {
      "key": "dialogue_voyager_chr2_tradermeetnormal5",
      "value": "Fri-end... Qui-et... Like Du-ne..."
    },

    {
      "key": "dialogue_voyager_chr2_tradermeetgood1",
      "value": "Sneak-y fri-end! Hel-lo!"
    },
    {
      "key": "dialogue_voyager_chr2_tradermeetgood2",
      "value": "Fri-end come vi-sit! Du-ne ha-ppy!"
    },
    {
      "key": "dialogue_voyager_chr2_tradermeetgood3",
      "value": "Good fri-end! Qui-et and smart!"
    },
    {
      "key": "dialogue_voyager_chr2_tradermeetgood4",
      "value": "Sneak-y fri-end back! Dune miss!"
    },

    {
      "key": "dialogue_voyager_chr2_tradermeetbad1",
      "value": "Grrr... Sneak-y fri-end... Sca-ry..."
    },
    {
      "key": "dialogue_voyager_chr2_tradermeetbad2",
      "value": "Fri-end look mean... Grrr..."
    },
    {
      "key": "dialogue_voyager_chr2_tradermeetbad3",
      "value": "Dune not like... Fri-end mo-od..."
    },
    {
      "key": "dialogue_voyager_chr2_tradermeetbad4",
      "value": "Grrrpmh... Sneak-y fri-end bad to-day..."
    },

    {
      "key": "dialogue_voyager_chr2_traderwakegreet1",
      "value": "Sneak-y fri-end... Wake..."
    },
    {
      "key": "dialogue_voyager_chr2_traderwakegreet2",
      "value": "Fri-end slee-p good? Dune ho-pe..."
    },
    {
      "key": "dialogue_voyager_chr2_traderwakegreet3",
      "value": "Wa-ke up... Qui-et fri-end..."
    },

    {
      "key": "dialogue_voyager_chr2_tradergiveitem1",
      "value": "Du-ne take! Sneak-y fri-end nice..."
    },
    {
      "key": "dialogue_voyager_chr2_tradergiveitem2",
      "value": "Goo-d! Than-k sneak-y fri-end..."
    },
    {
      "key": "dialogue_voyager_chr2_tradergiveitem3",
      "value": "Dune ke-ep... Sneak-y gi-ve good..."
    },

    {
      "key": "dialogue_voyager_chr2_tradergiveitemrefuse1",
      "value": "No more! Dune have en-ough, sneak-y..."
    },
    {
      "key": "dialogue_voyager_chr2_tradergiveitemrefuse2",
      "value": "Is eno-ugh, fri-end... No mo-re..."
    },

    {
      "key": "dialogue_voyager_chr2_traderbite1",
      "value": "Sneak-y fri-end... Tas-te good..."
    },
    {
      "key": "dialogue_voyager_chr2_traderbite2",
      "value": "Than-k for... Sneak-y din-ner..."
    },
    {
      "key": "dialogue_voyager_chr2_traderbite3",
      "value": "Fri-end taste... Qui-et... Like sneak-y..."
    },

    {
      "key": "dialogue_voyager_chr2_traderbuy1",
      "value": "Ta-ke thi-ng, sneak-y fri-end!"
    },
    {
      "key": "dialogue_voyager_chr2_traderbuy2",
      "value": "Dune give ba-ck! Fri-end have..."
    },
    {
      "key": "dialogue_voyager_chr2_traderbuy3",
      "value": "You... Ta-ke! Sneak-y good..."
    },

    {
      "key": "dialogue_voyager_chr2_traderbuyfail1",
      "value": "No! Fri-end gi-ve fir-st..."
    },
    {
      "key": "dialogue_voyager_chr2_traderbuyfail2",
      "value": "Grrrr! Dune need thi-ng too!"
    },

    {
      "key": "dialogue_voyager_chr2_traderbuyfailmaxvalue1",
      "value": "Gave eno-ugh! Sneak-y fri-end stop..."
    },
    {
      "key": "dialogue_voyager_chr2_traderbuyfailmaxvalue2",
      "value": "Dune ke-ep... Dune nee-d... Mo-re..."
    },

    {
      "key": "dialogue_voyager_chr2_traderwarning1",
      "value": "Sneak-y fri-end go aw-ay! Or bit-e!"
    },
    {
      "key": "dialogue_voyager_chr2_traderwarning2",
      "value": "Dune not like... Sneak-y mo-od... Le-ave!"
    },
    {
      "key": "dialogue_voyager_chr2_traderwarning3",
      "value": "Go aw-ay, sneak-y! Now!"
    },

    {
      "key": "dialogue_voyager_chr2_tradercombat1",
      "value": "GGHHRRAHHH! Sneak-y bad!"
    },
    {
      "key": "dialogue_voyager_chr2_tradercombat2",
      "value": "NGGHHRRR... No mo-re sneak-y!"
    },
    {
      "key": "dialogue_voyager_chr2_tradercombat3",
      "value": "DUNE HA-TE SNEAK-Y! GRRRR!"
    },

    {
      "key": "dialogue_voyager_chr2_traderthreatensuccess1",
      "value": "Dune weak-er... Ta-ke and lea-ve, sneak-y..."
    },
    {
      "key": "dialogue_voyager_chr2_traderthreatensuccess2",
      "value": "Don't hu-rt Dune... Sneak-y ta-ke thi-ng..."
    },

    {
      "key": "dialogue_voyager_chr2_traderlightbreak1",
      "value": "NNGGHHRR! Sneak-y bad! Go away!"
    },
    {
      "key": "dialogue_voyager_chr2_traderlightbreak2",
      "value": "BAD sneak-y! Grrrr... Lea-ve!"
    },

    {
      "key": "dialogue_voyager_chr2_tradermove1",
      "value": "Du-ne... Mo-ve..."
    },
    {
      "key": "dialogue_voyager_chr2_tradermovefail1",
      "value": "Du-ne like cur-rent spot..."
    },

    {
      "key": "dialogue_voyager_chr2_traderseegun1",
      "value": "Sneak-y ho-ld... thing of pain?..."
    },
    {
      "key": "dialogue_voyager_chr2_traderseegun2",
      "value": "Dune fear... loud rod... Sneak-y..."
