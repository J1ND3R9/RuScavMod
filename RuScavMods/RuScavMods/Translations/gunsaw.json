    {
      "key": "dialogue_velvet_tradercombat4",
      "value": "STAY BACK!"
    },
    {
      "key": "dialogue_velvet_tradercombat5",
      "value": "I KNEW SOMETHING WAS WRONG!"
    },
    {
      "key": "dialogue_velvet_tradercombat6",
      "value": "DON'T TOUCH ME!"
    },
    {
      "key": "dialogue_velvet_tradercombat7",
      "value": "GET OUT!"
    },
    {
      "key": "dialogue_velvet_tradercombat8",
      "value": "I'M NOT FOOD!"
    },
    {
      "key": "dialogue_velvet_tradercombat9",
      "value": "STAY AWAY!"
    },
