    {
      "key": "dialogue_voyager_item_rippeddressing_desperate_1",
      "value": "I- Fine. Just this time."
    },
    {
      "key": "dialogue_voyager_item_rippeddressing_desperate_2",
      "value": "...Don't look at me right now."
    },
    {
      "key": "dialogue_voyager_item_rippeddressing_desperate_3",
      "value": "Shut up. Shut up, just- just do it."
    },
    {
      "key": "dialogue_voyager_item_rippeddressing_desperate_4",
      "value": "This never happened. Understand?"
    },

    {
      "key": "dialogue_voyager_item_crudecleaver_1",
      "value": "Hardly even has an edge..."
    },
    {
      "key": "dialogue_voyager_item_crudecleaver_2",
      "value": "This wouldn't even cut through paper."
    },
    {
      "key": "dialogue_voyager_item_crudecleaver_3",
      "value": "Somebody's proud of this. Pathetic."
    },
    {
      "key": "dialogue_voyager_item_crudecleaver_4",
      "value": "I've seen sharper rocks."
    },

    {
      "key": "dialogue_voyager_item_makeshiftwrench_1",
      "value": "And this is supposed to be... what?"
    },
    {
      "key": "dialogue_voyager_item_makeshiftwrench_2",
      "value": "...It works. Barely counts, but it works."
    },
    {
      "key": "dialogue_voyager_item_makeshiftwrench_3",
      "value": "Ugly. Functional, but ugly."
    },
    {
      "key": "dialogue_voyager_item_makeshiftwrench_4",
      "value": "I've used worse. Unfortunately."
    },

    {
      "key": "dialogue_voyager_item_makeshiftheadlamp_1",
      "value": "*Grrr* Get this fucking thing off of me. Now."
    },
    {
      "key": "dialogue_voyager_item_makeshiftheadlamp_2",
      "value": "I look like a fucking dumbass."
    },
    {
      "key": "dialogue_voyager_item_makeshiftheadlamp_3",
      "value": "Might as well paint a target on myself."
    },
    {
      "key": "dialogue_voyager_item_makeshiftheadlamp_4",
      "value": "Everyone can see me coming. Wonderful."
    },

    {
      "key": "dialogue_voyager_item_makeshifthelmet_1",
      "value": "Just for now. That's all."
    },
    {
      "key": "dialogue_voyager_item_makeshifthelmet_2",
      "value": "It's not the worst thing I've worn."
    },
    {
      "key": "dialogue_voyager_item_makeshifthelmet_3",
      "value": "...It'll do. Don't get used to it."
    },
    {
      "key": "dialogue_voyager_item_makeshifthelmet_4",
      "value": "Ugly, but it stays on. Good enough."
