    {
      "key": "dialogue_leapy_chr2_traderwakegreet3",
      "value": "Больше не спит... При-вет..! Просыпайся..."
    },
    {
      "key": "dialogue_leapy_chr2_traderwakegreet4",
      "value": "Проснулся... Быстрый о-вощ сно-ва..."
    },
    {
      "key": "dialogue_leapy_chr2_traderwakegreet5",
      "value": "Просыпайся... О-вощ..."
    },
    {
      "key": "dialogue_leapy_chr2_traderwakegreet6",
      "value": "Просы-пайся.. Друг..."
    },
    {
      "key": "dialogue_leapy_chr2_traderwakegreet7",
      "value": "О-вощ с-пал... Просыпается... Дюна приветс-твует!"
