    {
      "key": "dialogue_leapy_chr2_traderbuy4",
      "value": "Дю-на дает..."
    },
    {
      "key": "dialogue_leapy_chr2_traderbuy5",
      "value": "Дюна... От-пла-чи-вает..."
    },
    {
      "key": "dialogue_leapy_chr2_traderbuy6",
      "value": "Др-уг дал... Раз... Дюна дает тоже..."
    },
    {
      "key": "dialogue_leapy_chr2_traderbuy7",
      "value": "Ты... Бе-ри вещь! О-вощ хороший..."
    },
    {
      "key": "dialogue_leapy_chr2_traderbuyfail1",
      "value": "Грррр!"
    },
    {
      "key": "dialogue_leapy_chr2_traderbuyfail2",
      "value": "Нет! Ггрххр..."
    },
    {
      "key": "dialogue_leapy_chr2_traderbuyfail3",
      "value": "Нет! Да-вай свое!"
