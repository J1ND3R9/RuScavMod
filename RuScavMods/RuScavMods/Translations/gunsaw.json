    {
      "key": "dialogue_voyager_item_slingbag_1",
      "value": "It'll do for now."
    },
    {
      "key": "dialogue_voyager_item_slingbag_2",
      "value": "It carries things. That's it."
    },
    {
      "key": "dialogue_voyager_item_slingbag_3",
      "value": "Nothing special. Works, though."
    },
    {
      "key": "dialogue_voyager_item_slingbag_4",
      "value": "...Fine. Whatever."
    },

    {
      "key": "dialogue_voyager_item_rifle_1",
      "value": "Not the pistol, but I'll take it."
    },
    {
      "key": "dialogue_voyager_item_rifle_2",
      "value": "Solid. Reliable. Good enough."
    },
    {
      "key": "dialogue_voyager_item_rifle_3",
      "value": "Now this has some weight to it."
    },

    {
      "key": "dialogue_voyager_item_shotgun_1",
      "value": "...It's real, at least."
    },
    {
      "key": "dialogue_voyager_item_shotgun_2",
      "value": "Not my style. But it works."
    },
    {
      "key": "dialogue_voyager_item_shotgun_3",
      "value": "Fine. Not what I'd pick."
    },

    {
      "key": "dialogue_voyager_item_traumarig_1",
      "value": "Now THIS is craftsmanship."
    },
    {
      "key": "dialogue_voyager_item_traumarig_2",
      "value": "Finally, something worth wearing."
    },
    {
      "key": "dialogue_voyager_item_traumarig_3",
      "value": "This is what real protection looks like."
    },

    {
      "key": "dialogue_voyager_item_riothelmet_1",
      "value": "Good. Real armor, for once."
    },
    {
      "key": "dialogue_voyager_item_riothelmet_2",
      "value": "This actually stops something."
    },
    {
      "key": "dialogue_voyager_item_riothelmet_3",
      "value": "Better than nothing. Much better."
    },

    {
      "key": "dialogue_voyager_item_woodsandals_1",
      "value": "You expect me to wear THIS?"
    },
    {
      "key": "dialogue_voyager_item_woodsandals_2",
      "value": "Absolutely not. Get these off me."
    },
    {
      "key": "dialogue_voyager_item_woodsandals_3",
      "value": "Wood. On my feet. Unbelievable."
    },

    {
      "key": "dialogue_voyager_item_refuse_universal_1",
      "value": "No. Not happening."
    },
    {
      "key": "dialogue_voyager_item_refuse_universal_2",
      "value": "Like I'd ever..."
    },
    {
      "key": "dialogue_voyager_item_refuse_universal_3",
      "value": "Fuck off."
    },
    {
      "key": "dialogue_voyager_item_refuse_universal_4",
      "value": "Useless thing."
    },

    {
      "key": "dialogue_voyager_steal_success_1",
      "value": "Heh. Idiot."
    },
    {
      "key": "dialogue_voyager_steal_success_2",
      "value": "Too easy..."
    },
    {
      "key": "dialogue_voyager_steal_success_3",
      "value": "Moron..."
    },

    {
      "key": "dialogue_voyager_steal_fail_1",
      "value": "Shit-!"
    },

    {
      "key": "dialogue_voyager_stealthkill_1",
      "value": "Haa... Haa... Fucking idiot. Didn't even see me..."
    },

    {
      "key": "dialogue_trader_stealthkill_survive_1",
      "value": "THE FUCK-!?!"
    },

    {
      "key": "dialogue_voyager_selfharm_buildup_1",
      "value": "No. No, don't- don't do this."
    },
    {
      "key": "dialogue_voyager_selfharm_buildup_2",
      "value": "Not again. Not fucking again."
    },
    {
      "key": "dialogue_voyager_selfharm_buildup_3",
      "value": "I can't- I can't keep doing this..."
    },
    {
      "key": "dialogue_voyager_selfharm_buildup_4",
      "value": "Stop. Just- just stop thinking."
    },
    {
      "key": "dialogue_voyager_selfharm_buildup_5",
      "value": "You don't have to do this... Again. You don't need this again... after this..."
    },
    {
      "key": "dialogue_voyager_selfharm_buildup_6",
      "value": "I can fix this. I can fix myself. Just... I need this first."
    },
    {
      "key": "dialogue_voyager_selfharm_buildup_7",
      "value": "Not the hands. Please, not the hands."
    },
    {
      "key": "dialogue_voyager_selfharm_buildup_8",
      "value": "...Okay. Okay. Just get it over with."
    },

    {
      "key": "dialogue_voyager_selfharm_cut_hate_1",
      "value": "You did this to me."
    },
    {
      "key": "dialogue_voyager_selfharm_cut_hate_2",
      "value": "This is your fault."
    },
    {
      "key": "dialogue_voyager_selfharm_cut_worthless_1",
      "value": "...I deserve worse."
    },
    {
      "key": "dialogue_voyager_selfharm_cut_worthless_2",
      "value": "Pathetic. Pathetic..."
    },

    {
      "key": "dialogue_voyager_selfharm_aftermath_1",
      "value": "...There. Happy now?"
    },
    {
      "key": "dialogue_voyager_selfharm_aftermath_2",
      "value": "Fine. FINE. That's enough."
    },
    {
      "key": "dialogue_voyager_selfharm_aftermath_3",
      "value": "...Look what you all made me do."
    },
    {
      "key": "dialogue_voyager_selfharm_aftermath_4",
      "value": "Maybe now... I'll be better..."
    },
    {
      "key": "dialogue_voyager_selfharm_aftermath_5",
      "value": "FUCK! ... Last time... Last time..."
    },
    {
      "key": "dialogue_voyager_selfharm_aftermath_6",
      "value": "...I'm fine. I'm fine."
    },
    {
      "key": "dialogue_voyager_selfharm_aftermath_7",
      "value": "Don't. Don't say anything."
    },
    {
      "key": "dialogue_voyager_selfharm_aftermath_8",
      "value": "...Still here. Still standing."
    },

    {
      "key": "dialogue_voyager_meltdown_hate_1",
      "value": "I HATE YOU ALL!!"
    },
    {
      "key": "dialogue_voyager_meltdown_hate_2",
      "value": "FUCK ALL OF YOU!!!"
    },
    {
      "key": "dialogue_voyager_meltdown_hate_3",
      "value": "I'LL NEVER LIVE AMONGST YOU FILTH!!"
    },
    {
      "key": "dialogue_voyager_meltdown_hate_4",
      "value": "NONE OF YOU DESERVE ME!"
    },
    {
      "key": "dialogue_voyager_meltdown_hate_5",
      "value": "GET AWAY FROM ME! ALL OF YOU!"
    },
    {
      "key": "dialogue_voyager_meltdown_hate_6",
      "value": "YOU'RE ALL BENEATH ME!!"
