    },
    {
      "key": "dialogue_voyager_meltdown_worthless_3",
      "value": "I'M THE WORTHLESS ONE!"
    },
    {
      "key": "dialogue_voyager_meltdown_worthless_4",
      "value": "I'M NOTHING! NOTHING!!!"
    },
    {
      "key": "dialogue_voyager_meltdown_worthless_5",
      "value": "I CAN'T DO THIS ANYMORE!!"
    },
    {
      "key": "dialogue_voyager_meltdown_worthless_6",
