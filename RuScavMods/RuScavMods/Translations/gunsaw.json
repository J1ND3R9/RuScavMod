    },
    {
      "key": "dialogue_baron_bigpain11",
      "value": "ДОСТАТОЧНО!"
    },

    {
      "key": "dialogue_baron_fallscream1",
      "value": "ААААХ!"
    },
    {
      "key": "dialogue_baron_fallscream2",
      "value": "ОХ, А-ААХ!"
    },
    {
      "key": "dialogue_baron_fallscream3",
      "value": "ДЕРЖИСЬ!"
    },
    {
      "key": "dialogue_baron_fallscream4",
      "value": "ПЛОХО!"
    },
    {
      "key": "dialogue_baron_fallscream5",
      "value": "ААААУГХ!"
    },
    {
      "key": "dialogue_baron_fallscream6",
      "value": "ПРОКЛЯТЬЕ!-"
    },
    {
      "key": "dialogue_baron_fallscream7",
      "value": "ОГОООО!"
    },
    {
      "key": "dialogue_baron_fallscream8",
      "value": "АААХ!"
    },

    {
      "key": "dialogue_baron_hitbycreature1",
      "value": "РРГХХ! НЕПЛОХО!"
    },
    {
      "key": "dialogue_baron_hitbycreature2",
      "value": "ХАХА! ИДИ СЮДА!"
    },
    {
      "key": "dialogue_baron_hitbycreature3",
      "value": "ГРААХ!"
    },
    {
      "key": "dialogue_baron_hitbycreature4",
      "value": "ТЫ ВЫБРАЛ НЕ ТУ ЦЕЛЬ!"
    },
    {
      "key": "dialogue_baron_hitbycreature5",
      "value": "ПРОЧЬ!"
    },
    {
      "key": "dialogue_baron_hitbycreature6",
      "value": "Я НЕ ПАДУ ОТ ТЕБЯ!"
    },
    {
      "key": "dialogue_baron_hitbycreature7",
      "value": "НАЗАД!"
    },
    {
      "key": "dialogue_baron_hitbycreature8",
      "value": "Достаточно!"
    },
    {
      "key": "dialogue_baron_hitbycreature9",
      "value": "ТЫ МЕНЯ НЕ ВОЗЬМЕШЬ ТАК ПРОСТО!"
    },
    {
      "key": "dialogue_baron_hitbycreature10",
      "value": "ГХХ! НУ ДАВАЙ!"
    },
    {
      "key": "dialogue_baron_hitbycreature11",
      "value": "Я ВИДЕЛ И ХУЖЕ ТЕБЯ!"
    },
    {
      "key": "dialogue_baron_hitbycreature12",
      "value": "НАПАДАЙ!"
    },

    {
      "key": "dialogue_baron_wet1",
      "value": "Я промок."
    },
    {
      "key": "dialogue_baron_wet2",
      "value": "Промок насквозь."
    },
    {
      "key": "dialogue_baron_wet3",
      "value": "Это станет проблемой, если температура упадёт."
    },
    {
      "key": "dialogue_baron_wet4",
      "value": "Моя шерсть удерживает абсурдное количество воды."
    },
    {
      "key": "dialogue_baron_wet5",
      "value": "Великолепно. Мокрый."
    },
    {
      "key": "dialogue_baron_wet6",
      "value": "Мне следует высохнуть."
    },
    {
      "key": "dialogue_baron_wet7",
      "value": "Я чувствую себя вдвое тяжелее."
    },
    {
      "key": "dialogue_baron_wet8",
      "value": "Это глубоко некомфортно."
    },
    {
      "key": "dialogue_baron_wet9",
      "value": "Полотенце, достаточно большое для меня, было бы чудом."
    },
    {
      "key": "dialogue_baron_wet10",
      "value": "Мне следует избегать холода, пока не высохну."
    },

    {
      "key": "dialogue_baron_dirty1",
      "value": "Я грязный."
    },
    {
      "key": "dialogue_baron_dirty2",
      "value": "Мне бы не помешало тщательно помыться."
    },
    {
      "key": "dialogue_baron_dirty3",
      "value": "Грязь повсюду."
    },
    {
      "key": "dialogue_baron_dirty4",
      "value": "Моя шерсть знавала и лучшие дни."
    },
    {
      "key": "dialogue_baron_dirty5",
      "value": "Мне следует найти душ."
    },
    {
      "key": "dialogue_baron_dirty6",
      "value": "Это вряд ли достойно."
    },
    {
      "key": "dialogue_baron_dirty7",
      "value": "Кажется, я принёс с собой половину пещеры."
    },
    {
      "key": "dialogue_baron_dirty8",
      "value": "Ванна была бы превосходна."
    },
    {
      "key": "dialogue_baron_dirty9",
      "value": "Я начинаю пахнуть как пещера."
    },
    {
      "key": "dialogue_baron_dirty10",
      "value": "Чистота стала своего рода роскошью."
    },

    {
      "key": "dialogue_baron_encumbered1",
      "value": "...Это довольно тяжело. Я не против."
    },
    {
      "key": "dialogue_baron_encumbered2",
      "value": "Боже правый. Сколько же я несу?"
    },
    {
      "key": "dialogue_baron_encumbered3",
      "value": "Я несу вполне достаточно. Неплохая тренировка!"
    },
    {
      "key": "dialogue_baron_encumbered4",
      "value": "Всегда знал, что из меня выйдет неплохой вьючный мул."
    },
    {
      "key": "dialogue_baron_encumbered5",
      "value": "Тащить всё это трудно, но если я справлюсь..."
    },
    {
      "key": "dialogue_baron_encumbered6",
      "value": "Хах... Плечи немного болят... Но я чувствую себя довольно уверенно с таким грузом!"
    },
    {
      "key": "dialogue_baron_encumbered7",
      "value": "Я чувствую себя грузовым транспортом! Неудивительно, что они хотят, чтобы я достал ту батарею!"
    },
    {
      "key": "dialogue_baron_encumbered8",
      "value": "Что ж... Спина немного болит... Возможно, я несу многовато..."
    },

    {
      "key": "dialogue_baron_watchlike1",
      "value": "Спасибо, что составляешь мне компанию в отсутствие других, маленькая часовая штучка."
    },

    {
      "key": "dialogue_baron_drillend1",
      "value": "Кажется, мои кости всё ещё вибрируют."
    },
    {
      "key": "dialogue_baron_drillend2",
      "value": "Замечательно неприятная машина."
    },
    {
      "key": "dialogue_baron_drillend3",
      "value": "Что ж. Дальше."
    },

    {
      "key": "dialogue_baron_loud1",
      "value": "ГХ!- Мои уши!"
    },
    {
      "key": "dialogue_baron_loud2",
      "value": "Проклятье- это было громко!"
    },
    {
      "key": "dialogue_baron_loud3",
      "value": "Агх- У меня звенит в ушах..."
    },
    {
      "key": "dialogue_baron_loud4",
      "value": "Нгх- Боже правый!"
    },
    {
      "key": "dialogue_baron_loud5",
      "value": "Гх-... Я едва слышу собственные мысли."
    },
    {
      "key": "dialogue_baron_loud6",
      "value": "Агх!.. Этот шум прошёл прямо сквозь мой череп."
    },

    {
      "key": "dialogue_baron_murderregret1",
      "value": "...Нет. Нет, это было неправильно... Что... Что я наделал?.. Это был один из нас... Я... Я не Барон."
    },
    {
      "key": "dialogue_baron_murderregret2",
      "value": "...Сила без сдержанности бесполезна. Сила без сдержанности... Я... Прости меня- Я..."
    },
    {
      "key": "dialogue_baron_murderregret3",
      "value": "...Я мог остановиться... Я-я должен был остановиться..! Должен был быть другой путь... Мне следовало уйти... Я не могу себя простить..."
    },
    {
      "key": "dialogue_baron_murderregret4",
      "value": "...Хах... Хах... Ч-что... Зачем я это сделал..? Я-я не хотел-... ...Никакое оправдание не заставит это тело снова встать. Ничто не заставит их снова встать."
    },

    {
      "key": "dialogue_baron_tradeemeet1",
      "value": "Добрый день."
    },
    {
      "key": "dialogue_baron_tradeemeet2",
      "value": "Приветствую. Надеюсь, у тебя всё хорошо."
    },
    {
      "key": "dialogue_baron_tradeemeet3",
      "value": "Ах, ещё один выживший. Рад тебя видеть."
    },
    {
      "key": "dialogue_baron_tradeemeet4",
      "value": "Не тревожься. Я лишь хочу торговать."
    },
    {
      "key": "dialogue_baron_tradeemeet5",
      "value": "Приветствую, друг. Могу я взглянуть, что у тебя есть?"
    },
    {
      "key": "dialogue_baron_tradeemeet6",
      "value": "Надеюсь, пещеры обошлись с тобой милосердно."
    },
    {
      "key": "dialogue_baron_tradeemeet7",
      "value": "Похоже, ты неплохо здесь устроился."
    },
    {
      "key": "dialogue_baron_tradeemeet8",
      "value": "Дружелюбное лицо. Какая удача."
    },
    {
      "key": "dialogue_baron_tradeemeet9",
      "value": "Добрый день. Я пришёл с миром."
    },
    {
      "key": "dialogue_baron_tradeemeet10",
      "value": "Я не буду тебя долго задерживать. Мне лишь нужны припасы."
    },
    {
      "key": "dialogue_baron_tradeemeet11",
      "value": "Пожалуйста, будь спокоен. Я не причиню тебе вреда."
    },
    {
      "key": "dialogue_baron_tradeemeet12",
      "value": "Не бойся. Со мной ты в безопасности. Поторгуемся?"
    },

    {
      "key": "dialogue_baron_tradeemeetprideful1",
      "value": "Добрый день! Надеюсь, у тебя всё хорошо!"
    },
    {
      "key": "dialogue_baron_tradeemeetprideful2",
      "value": "Приветствую! Какое прекрасное зрелище — ещё один выживший!"
    },
    {
      "key": "dialogue_baron_tradeemeetprideful3",
      "value": "Ах! Друг! У меня было весьма насыщенное путешествие."
    },
    {
      "key": "dialogue_baron_tradeemeetprideful4",
      "value": "Добрый день! Путь позади меня теперь значительно безопаснее! Как ты?"
    },
    {
      "key": "dialogue_baron_tradeemeetprideful5",
      "value": "Приветствую! Прости за энтузиазм. Я в превосходном расположении духа!"
    },
    {
      "key": "dialogue_baron_tradeemeetprideful6",
      "value": "Привет! Прекрасный день, чтобы быть живым, не так ли?"
    },
    {
      "key": "dialogue_baron_tradeemeetprideful7",
      "value": "Ах, ещё один выживший! Великолепно!"
    },
    {
      "key": "dialogue_baron_tradeemeetprideful8",
      "value": "Приветствую, друг! Я заслужил себе довольно хорошее настроение."
    },
    {
      "key": "dialogue_baron_tradeemeetprideful9",
      "value": "Добрый день! Надеюсь, мой вид тебя не пугает. Большая часть этого — не моя кровь!"
    },
    {
      "key": "dialogue_baron_tradeemeetprideful10",
      "value": "Какое облегчение найти дружескую компанию после достойной драки!"
    },
    {
      "key": "dialogue_baron_tradeemeetprideful11",
      "value": "Приветствую! У меня был продуктивный день."
    },
    {
      "key": "dialogue_baron_tradeemeetprideful12",
      "value": "Ещё один выживший! Превосходно. Идём, давай торговать!"
    },

    {
      "key": "dialogue_baron_tradeereturn1",
      "value": "Ах, друг! Я вернулся."
    },
    {
      "key": "dialogue_baron_tradeereturn2",
      "value": "Приветствую снова! Много всего случилось с нашей последней беседы."
    },
    {
      "key": "dialogue_baron_tradeereturn3",
      "value": "Всё ещё здесь? Превосходно! У меня хорошие новости."
    },
    {
      "key": "dialogue_baron_tradeereturn4",
      "value": "Друг! Ты бы видел, что бросило мне вызов там."
    },
    {
      "key": "dialogue_baron_tradeereturn5",
      "value": "Я возвращаюсь в значительно лучшем расположении духа!"
    },
    {
      "key": "dialogue_baron_tradeereturn6",
      "value": "Рад снова тебя видеть. Путь снаружи теперь немного безопаснее."
    },
    {
      "key": "dialogue_baron_tradeereturn7",
      "value": "Я вернулся! Немного потрёпанный, но с победой."
    },
    {
      "key": "dialogue_baron_tradeereturn8",
      "value": "Приветствую! Я обещал, что выдержу."
    },
    {
      "key": "dialogue_baron_tradeereturn9",
      "value": "Я вернулся с победой!"
    },
    {
      "key": "dialogue_baron_tradeereturn10",
      "value": "Друг! Вот это испытание. Я чувствую себя великолепно."
    },
    {
      "key": "dialogue_baron_tradeereturn11",
      "value": "Снова добрый день! Похоже, пещеры недооценили меня."
    },
    {
      "key": "dialogue_baron_tradeereturn12",
      "value": "Я возвращаюсь с меньшим числом врагов за спиной, чем когда уходил."
    },

    {
      "key": "dialogue_baron_tradermeetregular1",
      "value": "ОГО! Эм... привет!"
    },
    {
      "key": "dialogue_baron_tradermeetregular2",
      "value": "Ох! Ты... действительно большой."
    },
    {
      "key": "dialogue_baron_tradermeetregular3",
      "value": "П-привет! Ты ведь дружелюбный, да?"
    },
    {
      "key": "dialogue_baron_tradermeetregular4",
      "value": "Ух ты. Не думаю, что когда-либо видел кого-то вроде тебя."
    },
    {
      "key": "dialogue_baron_tradermeetregular5",
      "value": "Привет!.. Пожалуйста, не бейся головой ни обо что."
    },
    {
      "key": "dialogue_baron_tradermeetregular6",
      "value": "Эм... добро пожаловать! Ты кажешься.. вежливым."
    },
    {
      "key": "dialogue_baron_tradermeetregular7",
      "value": "Ты ОГРОМНЫЙ!.. П-прости. Это прозвучало грубо."
    },
    {
      "key": "dialogue_baron_tradermeetregular8",
      "value": "Ого. Ты ведь пришёл торговать, да?"
    },
    {
      "key": "dialogue_baron_tradermeetregular9",
      "value": "...Кажется, ты мог бы поднять меня одной рукой..."
    },
    {
      "key": "dialogue_baron_tradermeetregular10",
      "value": "...Ты выглядишь устрашающе. Но... говоришь мило!"
    },
    {
      "key": "dialogue_baron_tradermeetregular11",
      "value": "Я никогда не видел твой вид раньше... Привет."
    },

    {
      "key": "dialogue_baron_tradermeetprideful1",
      "value": "ОГО! Ты выглядишь так, будто только что с кем-то сражался!"
    },
    {
      "key": "dialogue_baron_tradermeetprideful2",
      "value": "Эй! Ты выглядишь очень счастливым!"
    },
    {
      "key": "dialogue_baron_tradermeetprideful3",
      "value": "Ты убил одного из тех монстров снаружи!? Это потрясающе!"
    },
    {
      "key": "dialogue_baron_tradermeetprideful4",
      "value": "Ты сражался с чем-то и ВЕРНУЛСЯ?! Ух ты!"
    },
    {
      "key": "dialogue_baron_tradermeetprideful5",
      "value": "Ты убил это? Я вдруг чувствую себя намного безопаснее с тобой здесь."
    },
    {
      "key": "dialogue_baron_tradermeetprideful6",
      "value": "Ты выглядишь довольным собой! Полагаю, ты это заслужил!"
    },
    {
      "key": "dialogue_baron_tradermeetprideful7",
      "value": "Что бы на тебя ни напало, я рад, что ПОБЕДИЛ ты."
    },
    {
      "key": "dialogue_baron_tradermeetprideful8",
      "value": "Ты устрашающий- эм- н-но в хорошем смысле! П-прости, я не хотел прозвучать грубо."
    },
    {
      "key": "dialogue_baron_tradermeetprideful9",
      "value": "Пожалуйста, останься ненадолго. Серьёзно. Я хочу услышать твои истории!"
    },
    {
      "key": "dialogue_baron_tradermeetprideful10",
      "value": "Я не знаю, что ты там сделал, но отличная работа!"
    },
    {
      "key": "dialogue_baron_tradermeetprideful11",
      "value": "Ух ты... Думаю, я предпочёл бы дружить с тобой."
    },

    {
      "key": "dialogue_baron_traderreturn1",
      "value": "Ты вернулся! Ого... что там случилось?"
    },
    {
      "key": "dialogue_baron_traderreturn2",
      "value": "Эй! Ты выглядишь очень довольным собой!"
    },
    {
      "key": "dialogue_baron_traderreturn3",
      "value": "Ты выиграл бой, да? Отличная работа там!"
    },
    {
      "key": "dialogue_baron_traderreturn4",
      "value": "О! Ты вернулся!"
    },
    {
      "key": "dialogue_baron_traderreturn5",
      "value": "Я знал, что с тобой всё будет хорошо!"
    },
    {
      "key": "dialogue_baron_traderreturn6",
      "value": "Что бы ты там ни делал, отличная работа!"
    },
    {
      "key": "dialogue_baron_traderreturn7",
      "value": "С возвращением! Приятно, когда рядом кто-то сильный."
    },
    {
      "key": "dialogue_baron_traderreturn8",
      "value": "Ты выглядишь так, будто у тебя есть история для рассказа!"
    },
    {
      "key": "dialogue_baron_traderreturn9",
      "value": "Эй, здоровяк! Ты выглядишь довольно гордым!"
    },
    {
      "key": "dialogue_baron_traderreturn10",
      "value": "Рад, что ты вернулся! Ты там что-то отлупил?"
    },
    {
      "key": "dialogue_baron_traderreturn11",
      "value": "Ты выглядишь НАМНОГО счастливее, чем когда уходил."
    },
    {
      "key": "dialogue_baron_traderreturn12",
      "value": "Ого. Что-то ОПРЕДЕЛЁННО проиграло бой."
    },

    {
      "key": "dialogue_baron_traderhugsuccess1",
      "value": "Оооу... Спасибки."
    },
    {
      "key": "dialogue_baron_traderhugsuccess2",
      "value": "О! Большие обнимашки."
    },
    {
      "key": "dialogue_baron_traderhugsuccess3",
      "value": "Ух ты... ты тёплый."
    },
    {
      "key": "dialogue_baron_traderhugsuccess4",
      "value": "Осторожно! Ты меня раздавишь! Хаха..."
    },
    {
      "key": "dialogue_baron_traderhugsuccess5",
      "value": "Это было на самом деле очень приятно."
    },
    {
      "key": "dialogue_baron_traderhugsuccess6",
      "value": "Ты очень хорошо обнимаешь."
    },
    {
      "key": "dialogue_baron_traderhugsuccess7",
      "value": "Оох. Спасибо, друг."
    },
    {
      "key": "dialogue_baron_traderhugsuccess8",
      "value": "Я чувствую себя в полной безопасности прямо сейчас."
    },
    {
      "key": "dialogue_baron_traderhugsuccess9",
      "value": "Ты на удивление нежный."
    },
    {
      "key": "dialogue_baron_traderhugsuccess10",
      "value": "Мне это было нужно."
    },

    {
      "key": "dialogue_baron_traderhugfail1",
      "value": "Нет, спасибо."
    },
    {
      "key": "dialogue_baron_traderhugfail2",
      "value": "Пожалуйста, не надо."
