    },

    {
      "key": "dialogue_orange_vomitresponse1",
      "value": "Uuuhmm... You good..?"
    },

    {
      "key": "dialogue_orange_vomitbloodresponse1",
      "value": "Ack! Did you just... Oh... Hey, you know you just... Threw up blood, right?"
    },

    {
      "key": "dialogue_orange_hungryresponse1",
      "value": "There's a bunch of food out there, you know..."
    },
    {
      "key": "dialogue_orange_hungryresponse2",
      "value": "Well, I could give you food in exchange for something..?"
    },

    {
      "key": "dialogue_orange_thirstyresponse1",
      "value": "I'd wager you can find some water out..."
    },
    {
      "key": "dialogue_orange_thirstyresponse2",
      "value": "Last I heard you can only go for three \"days\" without water, haha..."
    },

    {
      "key": "dialogue_orange_sadresponse1",
      "value": "Hey, it's okay... You're still alive and kicking, right..."
    },

    {
      "key": "dialogue_orange_depressedresponse1",
      "value": "...Calm down, please... It'll be fine..."
    },

    {
      "key": "dialogue_orange_selfharmresponse1",
      "value": "...W-why... Did you..."
    },

    {
      "key": "dialogue_orange_braindamagedresponse1",
      "value": "...You don't sound... Very well."
    },
    {
      "key": "dialogue_orange_braindamagedresponse2",
      "value": "...What?"
    },

    {
      "key": "dialogue_orange_hotresponse1",
      "value": "Turn the heat down, then."
    },

    {
      "key": "dialogue_orange_coldresponse1",
      "value": "You know, we do have a heater here..."
    },

    {
      "key": "dialogue_orange_bleedingresponse1",
      "value": "It... Does look bad... But, I... I'm sure you can fix it..."
    },
    {
      "key": "dialogue_orange_bleedingresponse2",
      "value": "H-hey, calm down. You'll be okay."
    },

    {
      "key": "dialogue_orange_painresponse1",
      "value": "Are you okay..? Why do you hurt?"
    },
    {
      "key": "dialogue_orange_painresponse2",
      "value": "Did you step on something?"
    },

    {
      "key": "dialogue_orange_dirtyresponse1",
      "value": "...We have a shower, you know. Or... Just, go swim in the pools out and about..."
    },

    {
      "key": "dialogue_orange_encumberedresponse1",
      "value": "Wouldn't hurt to leave some of your stuff with me."
    },
    {
      "key": "dialogue_orange_encumberedresponse2",
      "value": "I'll take good care of your things!"
    },

    {
      "key": "dialogue_orange_dyingresponse1",
      "value": "Crap... Uh... I never learned how to resusciate others..."
    },
    {
      "key": "dialogue_orange_dyingresponse2",
      "value": "I... Uh... I hope you'll be alright..."
    },

    {
      "key": "dialogue_orange_chr1_tradermeetnormal1",
      "value": "Greetings."
    },
    {
      "key": "dialogue_orange_chr1_tradermeetnormal2",
      "value": "Hello."
    },
    {
      "key": "dialogue_orange_chr1_tradermeetnormal3",
      "value": "My pleasure to meet you."
    },
    {
      "key": "dialogue_orange_chr1_tradermeetnormal4",
      "value": "Ah! Hello there!"
    },
    {
      "key": "dialogue_orange_chr1_tradermeetnormal5",
      "value": "Welcome, fellow traveler."
    },
    {
      "key": "dialogue_orange_chr1_tradermeetnormal6",
      "value": "Greetings to you."
    },
    {
      "key": "dialogue_orange_chr1_tradermeetnormal7",
      "value": "Welcome."
    },
    {
      "key": "dialogue_orange_chr1_tradermeetnormal8",
      "value": "Nice to meet you!"
    },
    {
      "key": "dialogue_orange_chr1_tradermeetnormal9",
      "value": "I hope all is well."
    },

    {
      "key": "dialogue_orange_chr1_tradermeetgood1",
      "value": "I'm honored to see another survivor."
    },
    {
      "key": "dialogue_orange_chr1_tradermeetgood2",
      "value": "Oh! Hello! How are you doing, friend?"
    },
    {
      "key": "dialogue_orange_chr1_tradermeetgood3",
      "value": "Greetings, dear. How are you doing?"
    },
    {
      "key": "dialogue_orange_chr1_tradermeetgood4",
      "value": "Ah! Greetings. You look very chipper!"
    },
    {
      "key": "dialogue_orange_chr1_tradermeetgood5",
      "value": "Ah, how happy I am to see someone like you!"
    },

    {
      "key": "dialogue_orange_chr1_tradermeetbad1",
      "value": "...I am not impressed."
    },
    {
      "key": "dialogue_orange_chr1_tradermeetbad2",
      "value": "Ough. Hello..."
    },
    {
      "key": "dialogue_orange_chr1_tradermeetbad3",
      "value": "...You confound me. Greetings."
    },
    {
      "key": "dialogue_orange_chr1_tradermeetbad4",
      "value": "...Hello."
    },
    {
      "key": "dialogue_orange_chr1_tradermeetbad5",
      "value": "Greetings. Please refrain from touching me."
    },
    {
      "key": "dialogue_orange_chr1_tradermeetbad6",
      "value": "Please stay away from me."
    },
    {
      "key": "dialogue_orange_chr1_tradermeetbad7",
      "value": "Greetings. Please use the door next time."
    },
    {
      "key": "dialogue_orange_chr1_tradermeetbad8",
      "value": "Welcome."
    },
    {
      "key": "dialogue_orange_chr1_tradermeetbad9",
      "value": "Greetings."
    },

    {
      "key": "dialogue_orange_chr1_traderwakegreet1",
      "value": "Good morning."
    },
    {
      "key": "dialogue_orange_chr1_traderwakegreet2",
      "value": "Hey, you're finally awake."
    },
    {
      "key": "dialogue_orange_chr1_traderwakegreet3",
      "value": "Greetings, you've awoken."
    },
    {
      "key": "dialogue_orange_chr1_traderwakegreet4",
      "value": "Guess who's awake!"
    },
    {
      "key": "dialogue_orange_chr1_traderwakegreet5",
      "value": "Sleepyhead. Welcome back!"
    },
    {
      "key": "dialogue_orange_chr1_traderwakegreet6",
      "value": "You were sleeping like a puppy, haha..."
    },

    {
      "key": "dialogue_orange_chr1_tradergiveitem1",
      "value": "Thank you."
    },
    {
      "key": "dialogue_orange_chr1_tradergiveitem2",
      "value": "That'll come in useful."
    },
    {
      "key": "dialogue_orange_chr1_tradergiveitem3",
      "value": "Thank you for the contribution."
    },
    {
      "key": "dialogue_orange_chr1_tradergiveitem4",
      "value": "I'm taking this."
    },
    {
      "key": "dialogue_orange_chr1_tradergiveitem5",
      "value": "Useful."
    },
    {
      "key": "dialogue_orange_chr1_tradergiveitem6",
      "value": "My pleasure."
    },
    {
      "key": "dialogue_orange_chr1_tradergiveitem7",
      "value": "I'll make good use of this."
    },

    {
      "key": "dialogue_orange_chr1_tradergiveitemrefuse1",
      "value": "This is enough for now. I have no more space for these trinkets."
    },
    {
      "key": "dialogue_orange_chr1_tradergiveitemrefuse2",
      "value": "You may stop gifting me things, I'd prefer not giving out everything else on me."
    },

    {
      "key": "dialogue_orange_chr1_traderhagglesuccess1",
      "value": "Fine."
    },
    {
      "key": "dialogue_orange_chr1_traderhagglesuccess2",
      "value": "I will make an exception for you."
    },
    {
      "key": "dialogue_orange_chr1_traderhagglesuccess3",
      "value": "Ah, you seem nice."
    },
    {
      "key": "dialogue_orange_chr1_traderhagglesuccess4",
      "value": "You make a good point."
    },
    {
      "key": "dialogue_orange_chr1_traderhagglesuccess5",
      "value": "I accept your request."
    },
    {
      "key": "dialogue_orange_chr1_traderhagglesuccess6",
      "value": "I hear you, buddy. Sure."
    },
    {
      "key": "dialogue_orange_chr1_traderhagglesuccess7",
      "value": "I have to agree."
    },
    {
      "key": "dialogue_orange_chr1_traderhagglesuccess8",
      "value": "Affirmative..."
    },

    {
      "key": "dialogue_orange_chr1_traderhagglefail1",
      "value": "How about no?"
    },
    {
      "key": "dialogue_orange_chr1_traderhagglefail2",
      "value": "I'm not a damn charity."
    },
    {
      "key": "dialogue_orange_chr1_traderhagglefail3",
      "value": "I only accept facts and logic, not uncoordinated pleas."
    },
    {
      "key": "dialogue_orange_chr1_traderhagglefail4",
      "value": "No."
    },
    {
      "key": "dialogue_orange_chr1_traderhagglefail5",
      "value": "That was the worst argument I've ever heard."
    },
    {
      "key": "dialogue_orange_chr1_traderhagglefail6",
      "value": "I have to deny your appeal."
    },
    {
      "key": "dialogue_orange_chr1_traderhagglefail7",
      "value": "Negative."
    },
    {
      "key": "dialogue_orange_chr1_traderhagglefail8",
      "value": "No exceptions, sorry."
    },

    {
      "key": "dialogue_orange_chr1_traderbuy1",
      "value": "No refunds."
    },
    {
      "key": "dialogue_orange_chr1_traderbuy2",
      "value": "Here you are."
    },
    {
      "key": "dialogue_orange_chr1_traderbuy3",
      "value": "Don't break it."
    },
    {
      "key": "dialogue_orange_chr1_traderbuy4",
      "value": "Good luck with this."
    },
    {
      "key": "dialogue_orange_chr1_traderbuy5",
      "value": "I hope you know how to use this."
    },
    {
      "key": "dialogue_orange_chr1_traderbuy6",
      "value": "Hope it'll be useful."
    },
    {
      "key": "dialogue_orange_chr1_traderbuy7",
      "value": "Here's your reward."
    },

    {
      "key": "dialogue_orange_chr1_traderbuyfail1",
      "value": "No."
    },
    {
      "key": "dialogue_orange_chr1_traderbuyfail2",
      "value": "I'm not a charity."
    },
    {
      "key": "dialogue_orange_chr1_traderbuyfail3",
      "value": "I don't give out things for free."
    },
    {
      "key": "dialogue_orange_chr1_traderbuyfail4",
      "value": "Pay up first."
    },
    {
      "key": "dialogue_orange_chr1_traderbuyfail5",
      "value": "I'm not giving you anything without an appropriate return."
    },
    {
      "key": "dialogue_orange_chr1_traderbuyfail6",
      "value": "Do I look like a charity to you?"
    },
    {
      "key": "dialogue_orange_chr1_traderbuyfail7",
      "value": "You're joking."
    },
    {
      "key": "dialogue_orange_chr1_traderbuyfail8",
      "value": "How insulting."
    },

    {
      "key": "dialogue_orange_chr1_traderbuyfailmaxvalue1",
      "value": "Enough trading for today. You've bought out a lot already."
    },
    {
      "key": "dialogue_orange_chr1_traderbuyfailmaxvalue2",
      "value": "I don't wish to thoroughly swap our possessions. Let's call it a day."
    },

    {
      "key": "dialogue_orange_chr1_traderthreatensuccess1",
      "value": "It is not in my interests to get hurt. Take whatever and leave."
    },
    {
      "key": "dialogue_orange_chr1_traderthreatensuccess2",
      "value": "Fine. Take your pick and please exit my pod."
    },
    {
      "key": "dialogue_orange_chr1_traderthreatensuccess3",
      "value": "I hope misfortune awaits you. Fine. Take it and leave."
    },
    {
      "key": "dialogue_orange_chr1_traderthreatensuccess4",
      "value": "You are a horrible person, you know that?"
    },
    {
      "key": "dialogue_orange_chr1_traderthreatensuccess5",
      "value": "So this is how you solve issues. Mhm. Fine."
    },
    {
      "key": "dialogue_orange_chr1_traderthreatensuccess6",
      "value": "Did it really have to come to this? You know better... Ugh. Fine."
    },
    {
      "key": "dialogue_orange_chr1_traderthreatensuccess7",
      "value": "A robbery was not something present on my bucket list. But, fine. Just don't hurt me."
    },

    {
      "key": "dialogue_orange_chr1_traderwarning1",
      "value": "Leave at once."
    },
    {
      "key": "dialogue_orange_chr1_traderwarning2",
      "value": "I do NOT appreciate your presence. Leave."
    },
    {
      "key": "dialogue_orange_chr1_traderwarning3",
      "value": "OUT."
    },
    {
      "key": "dialogue_orange_chr1_traderwarning4",
      "value": "Do you not think I'm serious? Out."
    },
    {
      "key": "dialogue_orange_chr1_traderwarning5",
      "value": "Get. Out."
    },
    {
      "key": "dialogue_orange_chr1_traderwarning6",
      "value": "Please. Leave."
    },
    {
      "key": "dialogue_orange_chr1_traderwarning7",
      "value": "Leave."
    },
    {
      "key": "dialogue_orange_chr1_traderwarning8",
      "value": "I'm not dealing with you right now."
    },
    {
      "key": "dialogue_orange_chr1_traderwarning9",
      "value": "Please leave my pod in peace. I got here first."
    },

    {
      "key": "dialogue_orange_chr1_tradercombat1",
      "value": "I didn't want it to come to this."
    },
    {
      "key": "dialogue_orange_chr1_tradercombat2",
      "value": "Fucking imbecile."
    },
    {
      "key": "dialogue_orange_chr1_tradercombat3",
      "value": "Get the fuck out."
    },
    {
      "key": "dialogue_orange_chr1_tradercombat4",
      "value": "Oh, FUCK you!"
    },
    {
      "key": "dialogue_orange_chr1_tradercombat5",
      "value": "GET OUT!"
    },
    {
      "key": "dialogue_orange_chr1_tradercombat6",
      "value": "This is MY POD! OUT!"
    },
    {
      "key": "dialogue_orange_chr1_tradercombat7",
      "value": "I'm NOT tolerating another moment of YOUR presence!"
    },

    {
      "key": "dialogue_orange_chr1_traderhugsuccess1",
      "value": "Ahh... I'll... I'll allow it."
    },
    {
      "key": "dialogue_orange_chr1_traderhugsuccess2",
      "value": "How affectionate..."
    },
    {
      "key": "dialogue_orange_chr1_traderhugsuccess3",
      "value": "Awww. You really needed that..."
    },
    {
      "key": "dialogue_orange_chr1_traderhugsuccess4",
      "value": "Aww, what a nice person you are."
    },
    {
      "key": "dialogue_orange_chr1_traderhugsuccess5",
      "value": "Mmmhh..."
    },
    {
      "key": "dialogue_orange_chr1_traderhugsuccess6",
      "value": "What a display of affection..."
    },

    {
      "key": "dialogue_orange_chr1_traderhugfail1",
      "value": "NO TOUCHIES!"
    },
    {
      "key": "dialogue_orange_chr1_traderhugfail2",
      "value": "Refrain."
    },
    {
      "key": "dialogue_orange_chr1_traderhugfail3",
      "value": "Cease. Do not embrace me."
    },
    {
      "key": "dialogue_orange_chr1_traderhugfail4",
      "value": "No. Stop. Do not touch me."
    },
    {
      "key": "dialogue_orange_chr1_traderhugfail5",
      "value": "Ew! Get your hands off of me."
    },

    {
      "key": "dialogue_orange_chr1_traderseegun1",
      "value": "...Do you even know how to use that? I doubt it."
    },
    {
      "key": "dialogue_orange_chr1_traderseegun2",
