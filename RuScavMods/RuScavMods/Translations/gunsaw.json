    {
      "key": "dialogue_velvet_traderthreatensuccess3",
      "value": "F-fine! You win. Take what you want... F-fuck..."
    },
    {
      "key": "dialogue_velvet_traderthreatensuccess4",
      "value": "I-I don't want to fight you! Please, just fucking... Take something and leave!"
