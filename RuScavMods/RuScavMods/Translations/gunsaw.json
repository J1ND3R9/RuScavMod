    {
      "key": "dialogue_orange_encumbered14",
      "value": "Чувствую себя могучим!"
    },
    {
      "key": "dialogue_orange_encumbered15",
      "value": "Чувствую себя сильным!"
    },
    {
      "key": "dialogue_orange_encumbered16",
      "value": "Чувствую себя важным."
    },
    {
      "key": "dialogue_orange_encumbered17",
      "value": "Я счастлив, что могу выполнять свою работу!"
