    {
      "key": "dialogue_velvet_tradergiveitemrefuse3",
      "value": "No more, please. My bag's full."
    },
    {
      "key": "dialogue_velvet_tradergiveitemrefuse4",
      "value": "I appreciate it, but stop giving me things."
    },
    {
      "key": "dialogue_velvet_tradergiveitemrefuse5",
      "value": "You can keep that one."
