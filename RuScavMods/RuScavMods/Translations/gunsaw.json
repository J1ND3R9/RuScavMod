    {
      "key": "dialogue_velvet_traderhugfail3",
      "value": "No hugs right now."
    },
    {
      "key": "dialogue_velvet_traderhugfail4",
      "value": "I don't know you that well."
    },
    {
      "key": "dialogue_velvet_traderhugfail5",
      "value": "Please keep your arms to yourself."
    },
    {
      "key": "dialogue_velvet_traderhugfail6",
      "value": "Too close!"
