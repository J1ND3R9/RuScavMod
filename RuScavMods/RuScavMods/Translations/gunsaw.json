    {
      "key": "dialogue_leapy_chr2_tradermeetbad5",
      "value": "Грррмф.. Плохой!... Не др-уг..."
    },
    {
      "key": "dialogue_leapy_chr2_tradermeetbad6",
      "value": "Дюне не нра-вит-ся... Этот о-вощ!..."
    },
    {
      "key": "dialogue_leapy_chr2_traderwakegreet1",
      "value": "Быстрый др-уг... Проснулся от не-быстрого..."
    },
    {
      "key": "dialogue_leapy_chr2_traderwakegreet2",
      "value": "О-вощ... Обратно к... Быстрому!..."
