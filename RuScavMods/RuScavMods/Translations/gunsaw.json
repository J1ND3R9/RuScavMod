    {
      "key": "dialogue_velvet_drillend2",
      "value": "I swear that thing had no soundproofing."
    },
    {
      "key": "dialogue_velvet_drillend3",
      "value": "Pretty long ride there..."
    },

    {
      "key": "dialogue_velvet_loud1",
      "value": "...Loud."
