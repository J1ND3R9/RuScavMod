    {
      "key": "dialogue_velvet_wet1",
      "value": "I am soaked."
    },
    {
      "key": "dialogue_velvet_wet2",
      "value": "Wet. Unpleasant."
    },
    {
      "key": "dialogue_velvet_wet3",
      "value": "Ugh. Damp."
    },
    {
      "key": "dialogue_velvet_wet4",
      "value": "Water in my fur. Lovely."
    },
    {
      "key": "dialogue_velvet_wet5",
      "value": "I should dry off."
    },
    {
      "key": "dialogue_velvet_wet6",
      "value": "Too wet."
    },
    {
      "key": "dialogue_velvet_wet7",
      "value": "This will make climbing miserable."
    },
    {
      "key": "dialogue_velvet_wet8",
      "value": "This water makes my body heavy."
    },
    {
      "key": "dialogue_velvet_wet9",
      "value": "Drenched."
    },
    {
      "key": "dialogue_velvet_wet10",
      "value": "I dislike this dampness."
    },

    {
      "key": "dialogue_velvet_dirty1",
      "value": "Filthy."
    },
    {
      "key": "dialogue_velvet_dirty2",
      "value": "I need to clean myself."
    },
    {
      "key": "dialogue_velvet_dirty3",
      "value": "There is dirt in my fur..."
    },
    {
      "key": "dialogue_velvet_dirty4",
      "value": "This dirt is not pleasant."
    },
    {
      "key": "dialogue_velvet_dirty5",
      "value": "I feel grimy..."
    },
    {
      "key": "dialogue_velvet_dirty6",
      "value": "I should wash this off."
    },
    {
      "key": "dialogue_velvet_dirty7",
      "value": "Mud everywhere."
    },
    {
      "key": "dialogue_velvet_dirty8",
      "value": "I'm dragging half of this cave around with me..."
    },
    {
      "key": "dialogue_velvet_dirty9",
      "value": "Not hygienic..."
    },
    {
      "key": "dialogue_velvet_dirty10",
      "value": "I prefer my messes intentional."
    },

    {
      "key": "dialogue_velvet_encumbered1",
      "value": "Carrying too much."
    },
    {
      "key": "dialogue_velvet_encumbered2",
      "value": "I have plenty of limbs, not plenty of strength."
    },
    {
      "key": "dialogue_velvet_encumbered3",
      "value": "This load is awkward."
    },
    {
      "key": "dialogue_velvet_encumbered4",
      "value": "I should drop something."
    },
    {
      "key": "dialogue_velvet_encumbered5",
      "value": "Too many things. Too little grace."
    },
    {
      "key": "dialogue_velvet_encumbered6",
      "value": "I am dragging myself down."
    },
    {
      "key": "dialogue_velvet_encumbered7",
      "value": "I need to lighten this."
    },
    {
      "key": "dialogue_velvet_encumbered8",
      "value": "Useful, yes. Portable, no."
    },
    {
      "key": "dialogue_velvet_encumbered9",
      "value": "My back is complaining."
    },
    {
      "key": "dialogue_velvet_encumbered10",
      "value": "Even I have limits."
    },

    {
      "key": "dialogue_velvet_watchlike1",
      "value": "I approve of this watch."
    },

    {
      "key": "dialogue_velvet_drillend1",
      "value": "...That took a while."
