    {
      "key": "dialogue_velvet_selfharmresponse1",
      "value": "Ч-что за хуйня?! ЭТО БЫЛА КОНЕЧНОСТЬ! Т-ты съела СВОЮ КОНЕЧНОСТЬ?!"
    },

    {
      "key": "dialogue_velvet_braindamagedresponse1",
      "value": "Ты как-то неправильно говоришь."
